{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "locus-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Locus.Web",
        "--urls",
        "http://localhost:5291"
      ],
      "port": 5291
    },
    {
      "name": "locus-web-local-tools",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Locus.Web",
        "--urls",
        "http://localhost:5292",
        "--",
        "--Locus:AllowLocalProcesses=true"
      ],
      "port": 5292
    }
  ]
}