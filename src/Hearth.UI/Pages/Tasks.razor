@page "/tasks"
@inherits StatefulComponent
@implements IAsyncDisposable
@inject TaskStore Store
@inject TaskRunner Runner
@inject NavigationManager Nav
@inject FollowUpStore FollowUps
@inject FollowUpRunner FollowUpRunner

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Tasks</h2>
</header>

<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <p class="muted">Give a bot a goal that takes real work — research, planning, filling in a sheet, sorting your inbox. It makes a plan, works through it in the background (even if you close Hearth, it picks up again), asks you only when it needs a decision, and reports back here and on Telegram.</p>
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" @bind-Value="_goal" Placeholder="e.g. Research the 5 best standing desks under $600, compare them in a Google Sheet, and recommend one" />
        <div class="row">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_botId">
                <MudSelectItem Value="@("")">💬 Hearth</MudSelectItem>
                @foreach (var b in State.Bots) { <MudSelectItem Value="@(b.Id)">@b.Emoji @b.Name</MudSelectItem> }
            </MudSelect>
            <span class="spacer"></span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Start" Disabled="@string.IsNullOrWhiteSpace(_goal)">Start task</MudButton>
        </div>
    </MudPaper>

    @foreach (var group in _tasks.GroupBy(t => t.State is TaskState.Running or TaskState.WaitingForYou or TaskState.Paused).OrderByDescending(g => g.Key))
    {
        <MudPaper Class="card" Elevation="0">
            <h3>@(group.Key ? "Active" : "Finished")</h3>
            @foreach (var t in group)
            {
                var bot = State.BotById(t.BotId);
                <a class="task-row" href="tasks/@t.Id">
                    <span class="task-state @t.State.ToString().ToLowerInvariant()">@Icon(t)</span>
                    <span class="grow">
                        <b>@t.Title</b>
                        <span class="muted small">
                            @(bot is null ? "Hearth" : $"{bot.Emoji} {bot.Name}") · @t.DoneSteps/@t.Plan.Count steps · updated @t.UpdatedAt.ToString("MMM d h:mm tt")
                        </span>
                        @if (t.State == TaskState.WaitingForYou) { <span class="task-q">❓ @t.Question</span> }
                    </span>
                    @if (t.Plan.Count > 0) { <span class="progress"><span style="width:@(100 * t.DoneSteps / t.Plan.Count)%"></span></span> }
                </a>
            }
        </MudPaper>
    }
    @if (_tasks.Count == 0) { <MudPaper Class="card" Elevation="0"><p class="muted">No tasks yet.</p></MudPaper> }

    @if (_followUps.Count > 0)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Follow-ups</h3>
            <p class="muted small">Bots scheduled these to come back to a chat on their own. They post only when there's something new.</p>
            @foreach (var f in _followUps)
            {
                var bot = State.BotById(f.BotId);
                <div class="task-row">
                    <span class="task-state"><Icon Name="timer" Size="16" /></span>
                    <span class="grow">
                        <b>@f.Note</b>
                        <span class="muted small">
                            @(bot is null ? "Hearth" : bot.Name) · @FollowUpTool.Describe(f.DueAt, DateTimeOffset.Now)@(f.Repeat is null ? "" : $" · {f.Repeat}")@(f.LastResult is null ? "" : $" · last time: {f.LastResult}")
                        </span>
                    </span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="@($"c/{f.ConversationId}")">Open chat</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => RunNow(f)" Disabled="@_runningNow">Run now</MudButton>
                    <MudIconButton Size="Size.Small" title="Cancel follow-up" aria-label="Cancel follow-up" OnClick="() => Cancel(f.Id)"><Icon Name="trash-2" Size="15" /></MudIconButton>
                </div>
            }
        </MudPaper>
    }
</div>

@code {
    private List<AgentTask> _tasks = [];
    private List<FollowUp> _followUps = [];
    private bool _runningNow;
    private string _goal = "";
    private string _botId = "";

    protected override async Task OnInitializedAsync()
    {
        Store.Saved += OnSaved;
        FollowUps.Changed += OnFollowUpsChanged;
        _tasks = await Store.ListAsync();
        _followUps = await FollowUps.ListAsync();
    }

    private void OnSaved(AgentTask _) => InvokeAsync(async () => { _tasks = await Store.ListAsync(); StateHasChanged(); });

    private void OnFollowUpsChanged() => InvokeAsync(async () => { _followUps = await FollowUps.ListAsync(); StateHasChanged(); });

    private async Task Cancel(string id) => await FollowUps.RemoveAsync(id);

    private async Task RunNow(FollowUp f)
    {
        _runningNow = true;
        try { await FollowUpRunner.RunAsync(f); }
        finally { _runningNow = false; }
    }

    private async Task Start()
    {
        var t = await Runner.StartAsync(_goal, string.IsNullOrEmpty(_botId) ? null : _botId);
        Nav.NavigateTo($"tasks/{t.Id}");
    }

    public static string Icon(AgentTask t) => t.State switch
    {
        TaskState.Running => "⏳", TaskState.WaitingForYou => "❓", TaskState.Paused => "⏸", TaskState.Done => "✅", TaskState.Failed => "❌", _ => "✖",
    };

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    public ValueTask DisposeAsync() { Store.Saved -= OnSaved; FollowUps.Changed -= OnFollowUpsChanged; base.Dispose(); return ValueTask.CompletedTask; }
}
