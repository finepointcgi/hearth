@page "/tasks/{Id}"
@inherits StatefulComponent
@implements IAsyncDisposable
@inject TaskStore Store
@inject TaskRunner Runner
@inject ApprovalCenter Approvals

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <a class="icon-btn" href="tasks" title="All tasks">←</a>
    <h2 class="topbar-title ellipsis">@(_task?.Title ?? "Task")</h2>
</header>

@if (_task is not null)
{
    var bot = State.BotById(_task.BotId);
    var pending = Approvals.Pending.Where(p => p.ConversationId == _task.ConversationId).ToList();
    <div class="settings">
        <MudPaper Class="card" Elevation="0">
            <div class="row">
                <span class="task-state big @_task.State.ToString().ToLowerInvariant()">@Tasks.Icon(_task)</span>
                <span class="grow">
                    <b>@StateText(_task)</b><br />
                    <span class="muted small">@(bot is null ? "Hearth" : $"{bot.Emoji} {bot.Name}") · @_task.Cycles work cycles · started @_task.CreatedAt.ToString("MMM d h:mm tt")</span>
                </span>
                @if (_task.State is TaskState.Running or TaskState.WaitingForYou) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Runner.SetStateAsync(_task.Id, TaskState.Paused)">⏸ Pause</MudButton> }
                @if (_task.State is TaskState.Paused or TaskState.Failed) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Runner.SetStateAsync(_task.Id, TaskState.Running)">▶ Resume</MudButton> }
                @if (_task.State is not (TaskState.Done or TaskState.Cancelled)) { <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => Runner.SetStateAsync(_task.Id, TaskState.Cancelled)">Cancel</MudButton> }
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="@($"c/{_task.ConversationId}")">Open work chat</MudButton>
            </div>
            <p class="goal">@_task.Goal</p>
        </MudPaper>

        @foreach (var p in pending)
        {
            var approval = p;
            <MudPaper Class="card attention" Elevation="0">
                <div class="row">
                    <span class="grow">🔐 Wants to run <b>@approval.ToolName</b> <code class="audit">@approval.ArgumentsJson</code></span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Approvals.Decide(approval.Id, false)">Deny</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => Approvals.Decide(approval.Id, true)">Allow</MudButton>
                </div>
            </MudPaper>
        }

        @if (_task.State == TaskState.WaitingForYou)
        {
            <MudPaper Class="card attention" Elevation="0">
                <b>❓ @_task.Question</b>
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" @bind-Value="_answer" Placeholder="Your answer" />
                <div class="row end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Answer" Disabled="@string.IsNullOrWhiteSpace(_answer)">Send answer & continue</MudButton></div>
            </MudPaper>
        }

        @if (_task.Result is not null)
        {
            <MudPaper Class="card" Elevation="0">
                <h3>Result</h3>
                <div class="md"><Markdown Text="@_task.Result" /></div>
            </MudPaper>
        }

        <MudPaper Class="card" Elevation="0">
            <h3>Plan @if (_task.Plan.Count > 0) { <span class="muted small">@_task.DoneSteps/@_task.Plan.Count done</span> }</h3>
            @if (_task.Plan.Count == 0) { <p class="muted">Making a plan…</p> }
            <ol class="plan">
                @foreach (var s in _task.Plan)
                {
                    <li class="@s.Status"><span class="step-mark">@Mark(s.Status)</span> @s.Text @if (s.Note is not null) { <span class="muted small"> — @s.Note</span> }</li>
                }
            </ol>
        </MudPaper>

        <MudPaper Class="card" Elevation="0">
            <h3>Log</h3>
            @foreach (var e in Enumerable.Reverse(_task.Log).Take(80))
            {
                <div class="activity"><span class="when">@e.Time.ToString("h:mm tt")</span><span class="grow">@e.Text</span></div>
            }
        </MudPaper>
    </div>
}
else
{
    <div class="empty muted">Task not found.</div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private AgentTask? _task;
    private string _answer = "";

    protected override async Task OnParametersSetAsync()
    {
        Store.Saved -= OnSaved;
        Store.Saved += OnSaved;
        Approvals.Requested += OnApproval;
        Approvals.Resolved += OnResolved;
        _task = await Store.GetAsync(Id);
    }

    private void OnSaved(AgentTask t) { if (t.Id == Id) InvokeAsync(() => { _task = t; StateHasChanged(); }); }
    private void OnApproval(PendingApproval _) => InvokeAsync(StateHasChanged);
    private void OnResolved(PendingApproval _, bool __) => InvokeAsync(StateHasChanged);

    private async Task Answer()
    {
        await Runner.AnswerAsync(Id, _answer);
        _answer = "";
    }

    private static string StateText(AgentTask t) => t.State switch
    {
        TaskState.Running => "Working on it", TaskState.WaitingForYou => "Waiting for you", TaskState.Paused => "Paused",
        TaskState.Done => "Done", TaskState.Failed => "Stopped with a problem", _ => "Cancelled",
    };

    private static string Mark(string status) => status switch
    {
        "done" => "✅", "working" => "⏳", "skipped" => "⤼", "failed" => "❌", _ => "○",
    };

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    public ValueTask DisposeAsync()
    {
        Store.Saved -= OnSaved;
        Approvals.Requested -= OnApproval;
        Approvals.Resolved -= OnResolved;
        base.Dispose();
        return ValueTask.CompletedTask;
    }
}
