@page "/memory"
@inherits StatefulComponent
@inject MemoryStore Store
@inject Hearth.Core.Services.PeopleStore People
@inject SettingsStore Settings
@inject MemoryCurator Curator
@inject Hearth.Core.Services.Companion Companion
@inject IJSRuntime JS

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Memory</h2>
</header>

<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <MudSwitch T="bool" Color="Color.Primary" Value="@(State.Settings.MemoryEnabled)" ValueChanged="Ev.Change<bool>(ToggleEnabled)" Class="check" Label="Let Hearth remember things about me across chats" />
        @if (State.Settings.MemoryEnabled)
        {
            <MudSwitch T="bool" Color="Color.Primary" Value="@(State.Settings.MemoryAutoLearn)" ValueChanged="Ev.Change<bool>(ToggleAutoLearn)" Class="check" Label="Learn automatically in regular chats (bots have their own setting)" />
        }
        @if (State.Settings.MemoryEnabled)
        {
            <MudSwitch T="bool" Color="Color.Primary" Value="@(State.Settings.RecallByMeaning)" ValueChanged="Ev.Change<bool>(ToggleMeaning)" Class="check"><span>Recall by meaning — find memories and past chats even when the words differ ("my car" finds "the Subaru loan")</span></MudSwitch>
            @if (_stats is { } st)
            {
                <p class="muted small">
                    🗄 @st.Provider · @st.Facts facts (@st.FactsEmbedded with meaning) · @st.Chats chats, @st.ChatMessages messages indexed
                    (@st.MessagesEmbedded with meaning) · search: @st.Recall
                    <br />Stored in <code>@st.Location</code>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="Export">⬇ Export (.json)</MudButton>
                </p>
            }
        }
        <p class="muted">Memories are stored on this device and included in every chat (so they go to whichever model provider is active). With tools on, the model saves and forgets memories itself; you can also edit them here.</p>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_new" OnKeyDown="AddOnEnter" Placeholder="Add a memory, e.g. I live in Denver and use metric units" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" Disabled="@(string.IsNullOrWhiteSpace(_new))">Add</MudButton>
        </div>
    </MudPaper>

    @if (State.Settings.MemoryEnabled)
    {
        <MudPaper Class="card" Elevation="0">
            <div class="row">
                <h3 class="grow">Your profile</h3>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Fold" Disabled="@(_tidying || Recent.Count == 0)" title="Fold the recent memories into your profile now (it also happens overnight)">@(_tidying ? "Thinking…" : "⤵ Update from new memories")</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Tidy" Disabled="@_tidying">🧹 Tidy up</MudButton>
            </div>
            <p class="muted small">A short summary of you that every chat starts with (bots that use shared memory too). Each night Hearth folds new memories into it and moves them to long-term storage.@(_profileInfo is { ConsolidatedAt: { } at } ? $" Last updated {at:MMM d, h:mm tt}." : "")</p>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="9" @bind-Value="_profile" Placeholder="Nothing yet — click Tidy up now, or write a few sentences about yourself." />
            <div class="row end">
                @if (_profileInfo?.PreviousText is not null) { <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="UndoProfile" title="Put back the profile from before the last automatic update">↶ Undo last update</MudButton> }
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SaveProfile">Save profile</MudButton>
            </div>
            @if (_tidyMessage is not null) { <div class="muted small">@_tidyMessage</div> }
        </MudPaper>

        @if (_cleanup is { } c)
        {
            <MudPaper Class="card" Elevation="0">
                <h3>Suggested tidy-up</h3>
                <p class="muted small">Untick anything you want to keep as it is, then apply.</p>
                @if (c.Profile is not null)
                {
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_keepProfile" Class="check"><span><b>Update your profile to:</b><br /><span class="small">@c.Profile</span></span></MudSwitch>
                }
                @foreach (var m in c.Merges)
                {
                    var merge = m;
                    <MudSwitch T="bool" Color="Color.Primary" Value="@(!_skipMerges.Contains(merge))" ValueChanged="(bool v) => Toggle(_skipMerges, merge, v)" Class="check"><span><b>Combine</b> <span class="muted small">@string.Join(" · ", merge.Ids.Select(Text))</span><br />→ @merge.Text</span></MudSwitch>
                }
                @foreach (var d in c.Drops)
                {
                    var drop = d;
                    <MudSwitch T="bool" Color="Color.Primary" Value="@(!_skipDrops.Contains(drop))" ValueChanged="(bool v) => Toggle(_skipDrops, drop, v)" Class="check"><span><b>Remove</b> “@Text(drop.Id)” <span class="muted small">— @drop.Reason</span></span></MudSwitch>
                }
                <div class="row end">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Discard">Discard</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply">Apply</MudButton>
                </div>
            </MudPaper>
        }
    }

    <MudPaper Class="card" Elevation="0">
        <h3>Recent memories <span class="muted small">(@Recent.Count, in every reply)</span></h3>
        <p class="muted small">New things Hearth learned. Once they're folded into your profile they move to long-term storage.</p>
        @foreach (var m in Recent) { @Row(m) }
        @if (_items.Count == 0) { <p class="muted">Nothing remembered yet.</p> }
        else if (Recent.Count == 0) { <p class="muted small">None: everything is in your profile and long-term storage.</p> }

        @if (LongTerm.Count > 0)
        {
            <details class="memory-archive">
                <summary><b>Long-term storage</b> <span class="muted small">(@LongTerm.Count, brought into a reply when relevant to what you ask)</span></summary>
                @foreach (var m in LongTerm) { @Row(m) }
            </details>
        }
        @if (_items.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => Store.ClearAsync()">Forget everything</MudButton>
        }
    </MudPaper>
    <MudPaper Class="card" Elevation="0">
        <h3>People &amp; companies <span class="muted small">(@_people.Count)</span></h3>
        <p class="muted small">Who's who in your life and work: recruiters, colleagues, companies. Bots add notes as they learn and look people up with who_is before writing to, calling or discussing them.</p>
        @foreach (var e in _people)
        {
            var entity = e;
            <details class="memory-archive">
                <summary><b>@entity.Name</b> <span class="muted small">@entity.Kind · @entity.Notes.Count notes@(entity.Related.Count > 0 ? " · " + string.Join(", ", entity.Related) : "")</span></summary>
                @foreach (var n in entity.Notes)
                {
                    var note = n;
                    <div class="memory-row">
                        <span class="grow">@note.Text</span>
                        <span class="muted small">@note.At.ToString("MMM d")</span>
                        <MudIconButton Size="Size.Small" title="Delete note" OnClick="() => People.DeleteNoteAsync(entity.Id, note)">🗑</MudIconButton>
                    </div>
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => People.DeleteAsync(entity.Id)">Forget @entity.Name</MudButton>
            </details>
        }
        @if (_people.Count == 0) { <p class="muted small">No one yet. Mention people and companies in chats and bots will keep notes.</p> }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>What's going on in your life <span class="muted small">(@_threads.Count(t => !t.Done) open)</span></h3>
        <p class="muted small">The ongoing things your lead bot keeps up with — a job search, a move, a project — and brings up when it fits ("How did the interview go?"). Bots add to these as you talk; you can too.</p>
        @foreach (var t in _threads)
        {
            var thread = t;
            <details class="memory-archive @(thread.Done ? "muted" : "")">
                <summary><b>@thread.Title</b>@(thread.Done ? " ✓" : "") <span class="muted small">@thread.Latest · @Hearth.Core.Services.Companion.Ago(thread.UpdatedAt)</span></summary>
                @foreach (var u in Enumerable.Reverse(thread.Updates))
                {
                    <div class="memory-row"><span class="grow">@u.Text</span><span class="muted small">@u.At.ToString("MMM d")</span></div>
                }
                <div class="row">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" Placeholder="What's new?" @bind-Value="_threadNews[thread.Id]" OnKeyDown="e => ThreadKey(e, thread)" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => AddThreadNews(thread)">Add</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Companion.SetDoneAsync(thread.Id, !thread.Done)">@(thread.Done ? "Reopen" : "Done")</MudButton>
                    <MudIconButton Size="Size.Small" title="Delete thread" aria-label="Delete thread" OnClick="() => Companion.RemoveThreadAsync(thread.Id)">🗑</MudIconButton>
                </div>
            </details>
        }
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" Placeholder="New thread, e.g. Job search" @bind-Value="_newThread" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" Placeholder="Where it stands" @bind-Value="_newThreadNews" OnKeyDown="NewThreadKey" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddThread" Disabled="@(_newThread.Trim().Length < 2 || _newThreadNews.Trim().Length < 3)">Add</MudButton>
        </div>
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>How your bots are with you</h3>
        <p class="muted small">What each bot has picked up about how to talk with you: your humor, what you're dealing with, how you like answers. It shapes their tone. Delete anything that's off.</p>
        @foreach (var (key, notes) in _vibes.Where(v => v.Value.Count > 0))
        {
            var botKey = key;
            var name = botKey == Hearth.Core.Services.Companion.PlainKey ? "Hearth" : State.BotById(botKey)?.Name ?? "A removed bot";
            <details class="memory-archive">
                <summary><b>@name</b> <span class="muted small">@notes.Count notes</span></summary>
                @foreach (var n in notes)
                {
                    var note = n;
                    <div class="memory-row">
                        <span class="grow">@note.Text</span>
                        <span class="muted small">@note.At.ToString("MMM d")</span>
                        <MudIconButton Size="Size.Small" title="Delete note" OnClick="() => Companion.RemoveNoteAsync(botKey == Hearth.Core.Services.Companion.PlainKey ? null : botKey, note.Id)">🗑</MudIconButton>
                    </div>
                }
            </details>
        }
        @if (_vibes.All(v => v.Value.Count == 0)) { <p class="muted small">Nothing yet — it builds up as you talk.</p> }
    </MudPaper>

    @if (State.Bots.Count > 0)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Each bot's own memory</h3>
            <p class="muted">Bots also keep notes of their own. Open a bot to see, teach or edit what it remembers.</p>
            @foreach (var b in State.Bots)
            {
                <a class="memory-row bot-mem-link" href="bots/@b.Id">
                    <BotAvatar Bot="b" Size="sm" />
                    <span class="grow"><b>@b.Name</b> <span class="muted small">@b.Title</span></span>
                    <span class="muted small">@(_botCounts.GetValueOrDefault(b.Id)) memories@(b.Memory.Enabled ? (b.Memory.AutoLearn ? " · learning" : "") : " · off")</span>
                </a>
            }
        </MudPaper>
    }
</div>

@code {
    private List<Hearth.Core.Services.Memory> _items = [];
    private string _new = "";
    private string? _editing;
    private string _editText = "";

    private Dictionary<string, int> _botCounts = [];

    private string _profile = "";
    private MemoryStats? _stats;

    private async Task LoadStatsAsync()
    {
        try { _stats = await Store.Provider.StatsAsync(); } catch { _stats = null; }
    }

    private async Task ToggleMeaning(ChangeEventArgs e)
    {
        var s = await Settings.GetAsync();
        s.RecallByMeaning = (bool)e.Value!;
        await Settings.SaveAsync(s);
        await LoadStatsAsync();
    }

    private async Task Export()
    {
        var data = new System.Text.Json.Nodes.JsonObject
        {
            ["exported"] = DateTimeOffset.Now.ToString("o"),
            ["profile"] = (await Curator.ProfileAsync()).Text,
            ["shared"] = System.Text.Json.JsonSerializer.SerializeToNode(await Store.ListAsync()),
        };
        var bots = new System.Text.Json.Nodes.JsonObject();
        foreach (var b in State.Bots) bots[b.Name] = System.Text.Json.JsonSerializer.SerializeToNode(await Store.ListAsync(b.Id));
        data["bots"] = bots;
        var bytes = System.Text.Encoding.UTF8.GetBytes(data.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
        await JS.InvokeVoidAsync("hearth.downloadImage", "data:application/json;base64," + Convert.ToBase64String(bytes), "hearth-memory.json");
    }
    private MemoryCleanup? _cleanup;
    private bool _tidying, _keepProfile = true;
    private string? _tidyMessage;
    private readonly HashSet<MemoryMerge> _skipMerges = [];
    private readonly HashSet<MemoryDrop> _skipDrops = [];

    private string Text(string id) => _items.FirstOrDefault(m => m.Id == id)?.Text ?? id;

    private UserProfile? _profileInfo;
    private List<Hearth.Core.Services.Memory> Recent => _items.Where(m => !m.Archived).OrderByDescending(m => m.CreatedAt).ToList();
    private List<Hearth.Core.Services.Memory> LongTerm => _items.Where(m => m.Archived).OrderByDescending(m => m.CreatedAt).ToList();

    private RenderFragment Row(Hearth.Core.Services.Memory mem) => @<div class="memory-row">
        @if (_editing == mem.Id)
        {
            <input class="grow" @bind="_editText" @onkeydown="e => EditKey(e, mem.Id)" />
            <button class="btn primary" @onclick="() => SaveEdit(mem.Id)">Save</button>
        }
        else
        {
            <span class="grow">@mem.Text</span>
            <span class="muted small">@mem.CreatedAt.ToString("MMM d")</span>
            <button class="icon-btn" title="@(mem.Archived ? "Move back to recent (in every reply)" : "Move to long-term storage")" @onclick="() => Store.SetArchivedAsync([mem.Id], !mem.Archived)">@(mem.Archived ? "↑" : "↓")</button>
            <button class="icon-btn" title="Edit" @onclick="() => { _editing = mem.Id; _editText = mem.Text; }">✎</button>
            <button class="icon-btn" title="Delete" @onclick="() => Store.DeleteAsync(mem.Id)">🗑</button>
        }
    </div>;

    private async Task Fold()
    {
        _tidying = true;
        _tidyMessage = null;
        try
        {
            var (folded, updated) = await Curator.ConsolidateAsync();
            await LoadCurationAsync();
            _items = await Store.ListAsync();
            _tidyMessage = updated || folded > 0 ? $"Profile updated; {folded} memories moved to long-term storage." : "Nothing to fold in.";
        }
        catch (Exception ex) { _tidyMessage = ex.Message; }
        finally { _tidying = false; }
    }

    private async Task UndoProfile()
    {
        await Curator.UndoProfileAsync();
        await LoadCurationAsync();
        _tidyMessage = "Profile put back.";
    }

    private static void Toggle<T>(HashSet<T> skip, T item, bool keep) { if (keep) skip.Remove(item); else skip.Add(item); }

    private async Task LoadCurationAsync()
    {
        _profileInfo = await Curator.ProfileAsync();
        _profile = _profileInfo.Text;
        _cleanup = await Curator.PendingAsync();
        _skipMerges.Clear();
        _skipDrops.Clear();
        _keepProfile = true;
    }

    private async Task SaveProfile()
    {
        await Curator.SaveProfileAsync(_profile);
        _tidyMessage = "Profile saved.";
    }

    private async Task Tidy()
    {
        _tidying = true;
        _tidyMessage = null;
        try
        {
            var c = await Curator.ProposeAsync();
            await LoadCurationAsync();
            if (c is null) _tidyMessage = "Everything already looks tidy.";
        }
        catch (Exception ex) { _tidyMessage = ex.Message; }
        finally { _tidying = false; }
    }

    private async Task Apply()
    {
        if (_cleanup is null) return;
        await Curator.ApplyAsync(new MemoryCleanup
        {
            Profile = _keepProfile ? _cleanup.Profile : null,
            Merges = _cleanup.Merges.Where(m => !_skipMerges.Contains(m)).ToList(),
            Drops = _cleanup.Drops.Where(d => !_skipDrops.Contains(d)).ToList(),
        });
        _items = await Store.ListAsync();
        await LoadCurationAsync();
        _tidyMessage = "Applied.";
    }

    private async Task Discard()
    {
        await Curator.DiscardAsync();
        await LoadCurationAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurationAsync();
        await LoadStatsAsync();
        foreach (var b in State.Bots) _botCounts[b.Id] = (await Store.ListAsync(b.Id)).Count;
        Store.Changed += Reload;
        _people = await People.ListAsync();
        People.Changed += ReloadPeople;
        await LoadCompanionAsync();
        Companion.Changed += ReloadCompanion;
        _items = await Store.ListAsync();
    }

    private List<Hearth.Core.Services.Entity> _people = [];
    private List<Hearth.Core.Services.LifeThread> _threads = [];
    private Dictionary<string, List<Hearth.Core.Services.RelationshipNote>> _vibes = [];
    private Dictionary<string, string> _threadNews = new();
    private string _newThread = "";
    private string _newThreadNews = "";

    private async Task LoadCompanionAsync()
    {
        _threads = await Companion.ThreadsListAsync();
        foreach (var t in _threads) _threadNews.TryAdd(t.Id, "");
        _vibes = new() { [Hearth.Core.Services.Companion.PlainKey] = await Companion.NotesForAsync(null) };
        foreach (var b in State.Bots) _vibes[b.Id] = await Companion.NotesForAsync(b.Id);
    }

    private async void ReloadCompanion()
    {
        await LoadCompanionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddThreadNews(Hearth.Core.Services.LifeThread t)
    {
        if (_threadNews.GetValueOrDefault(t.Id, "").Trim().Length < 3) return;
        await Companion.UpdateAsync(t.Title, _threadNews[t.Id]);
        _threadNews[t.Id] = "";
    }

    private async Task ThreadKey(KeyboardEventArgs e, Hearth.Core.Services.LifeThread t) { if (e.Key == "Enter") await AddThreadNews(t); }

    private async Task AddThread()
    {
        if (await Companion.UpdateAsync(_newThread, _newThreadNews) is not null) _newThread = _newThreadNews = "";
    }

    private async Task NewThreadKey(KeyboardEventArgs e) { if (e.Key == "Enter") await AddThread(); }

    private async void ReloadPeople()
    {
        _people = await People.ListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void Reload()
    {
        _items = await Store.ListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(_new)) return;
        await Store.AddAsync(_new);
        _new = "";
    }

    private async Task AddOnEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await Add(); }

    private async Task EditKey(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter") await SaveEdit(id);
        if (e.Key == "Escape") _editing = null;
    }

    private async Task SaveEdit(string id)
    {
        _editing = null;
        await Store.UpdateAsync(id, _editText);
    }

    private async Task ToggleAutoLearn(ChangeEventArgs e)
    {
        var s = SettingsCopy.Of(State.Settings);
        s.MemoryAutoLearn = (bool)e.Value!;
        await Settings.SaveAsync(s);
    }

    private async Task ToggleEnabled(ChangeEventArgs e)
    {
        var s = SettingsCopy.Of(State.Settings);
        s.MemoryEnabled = (bool)e.Value!;
        await Settings.SaveAsync(s);
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    public override void Dispose() { Store.Changed -= Reload; People.Changed -= ReloadPeople; Companion.Changed -= ReloadCompanion; base.Dispose(); }
}
