@page "/documents"
@inherits StatefulComponent
@inject DocumentStore Store
@inject SettingsStore Settings
@inject LinkedFolders Folders
@inject CloudFolders Cloud
@inject ProjectHistory History

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Documents</h2>
</header>

<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <p class="muted">
            Add PDFs, notes and code. They're split into passages and indexed with a local embedding model, so the
            <b>Search my documents</b> tool can find relevant parts. The files and index are stored on this device; passages the model reads are sent to whichever model provider is active.
        </p>
        <div class="row">
            <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_embedModel" Placeholder="nomic-embed-text" Label="Embedding model (on the active server)" />
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SaveModel">Save</MudButton>
        </div>
        <p class="muted small">Ollama: <code>ollama pull nomic-embed-text</code>. Changing the model means re-adding documents.</p>
        <label class="btn primary upload">
            ＋ Add documents
            <InputFile OnChange="OnFiles" multiple accept=".pdf,.txt,.md,.csv,.json,.html,.htm,.xml,.yaml,.yml,.cs,.js,.ts,.py,.java,.go,.rs,.cpp,.c,.h,.sql,.log" class="hidden-file" />
        </label>
        @if (_progress is not null) { <div class="muted">@_progress</div> }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Linked folders</h3>
        <p class="muted small">Folders on this computer that stay indexed: new and changed files are picked up within seconds, deleted ones drop out. Bots can search them and read the files (not change them). Hidden files and folders (like <code>.env</code> or <code>.git</code>), dependencies and build output are skipped.</p>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_folderPath" Placeholder="/Users/you/Projects/notes" OnKeyDown="FolderKey" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddFolder" Disabled="@string.IsNullOrWhiteSpace(_folderPath)">Link folder</MudButton>
        </div>
        @if (_folderError is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_folderError</MudAlert> }
        @if (Folders.Status is { } status) { <div class="muted small">@status</div> }
        @foreach (var f in _folders)
        {
            var folder = f;
            <div class="memory-row">
                <span class="grow"><Icon Name="folder" Size="16" /> <b>@folder.Path</b></span>
                <span class="muted small">
                    @folder.Files files@(folder.Skipped > 0 ? $" ({folder.Skipped} more not indexed)" : "")
                    · @(folder.LastSync is { } at ? $"synced {at:MMM d h:mm tt}" : "indexing…")
                    @(folder.KeywordOnly ? " · keyword search" : "")
                </span>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => SyncFolder(folder.Id)">Sync now</MudButton>
                <MudIconButton Size="Size.Small" title="Unlink folder" aria-label="Unlink folder" OnClick="() => Folders.RemoveAsync(folder.Id)"><Icon Name="trash-2" Size="15" /></MudIconButton>
            </div>
            @if (folder.Error is not null) { <div class="tiny-error">@folder.Error</div> }
            <div class="sub">
                <MudSwitch T="bool" Color="Color.Primary" Value="@(folder.Editable)" ValueChanged="(bool v) => Folders.SetEditableAsync(folder.Id, v)" Class="check" Label="Bots can edit (for coding: each change shows a diff, asks first and can be undone; commands run in the code sandbox)" />
                @if (folder.Editable)
                {
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Value="@(folder.SandboxImage)" Placeholder="default (Tools page), e.g. mcr.microsoft.com/dotnet/sdk:10.0 or node:22" ValueChanged="(string v) => Folders.SetSandboxImageAsync(folder.Id, v)" T="string" Label="Sandbox image for this project" />
                    var changes = _changes.Where(c => c.FolderId == folder.Id).OrderByDescending(c => c.At).Take(8).ToList();
                    @if (changes.Count > 0)
                    {
                        <div class="muted small">Recent changes by bots</div>
                        @foreach (var c in changes)
                        {
                            var change = c;
                            <div class="memory-row">
                                <span class="grow small">@change.Summary <span class="muted">· @change.At.ToString("MMM d h:mm tt") · @System.IO.Path.GetRelativePath(folder.Path, change.Path)</span></span>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Undo(change.Id)">Undo</MudButton>
                            </div>
                        }
                        @if (_undoError is not null) { <div class="tiny-error">@_undoError</div> }
                    }
                }
            </div>
        }
        @if (_folders.Any(f => f.KeywordOnly))
        {
            <p class="muted small">No embedding model answered, so these are searched by keyword. For search by meaning, run <code>ollama pull nomic-embed-text</code> (or set an embedding model your server has) and press Sync now.</p>
        }
        <p class="muted small">On a Mac, Hearth needs permission for Documents, Desktop and Downloads (System Settings → Privacy &amp; Security). Folders elsewhere, like <code>~/Projects</code>, work as is.</p>
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Cloud folders</h3>
        <p class="muted small">Google Drive and OneDrive folders (a Job Search or Recipes folder…) kept searchable like the folders above: Google Docs, Sheets, Slides, Word, PDF and text files are indexed, and changes are picked up every hour. Bots answer from them with document search instead of fetching each file. Needs Google (Docs &amp; Drive) or Microsoft 365 connected on the Connections page.</p>
        <div class="row">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_cloudProvider">
                <MudSelectItem Value="@("google")">Google Drive</MudSelectItem>
                <MudSelectItem Value="@("onedrive")">OneDrive</MudSelectItem>
            </MudSelect>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_cloudFolder" Placeholder="@(_cloudProvider == "onedrive" ? "Documents/Job Search (or a share link)" : "Folder link, or its exact name")" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddCloud" Disabled="@(string.IsNullOrWhiteSpace(_cloudFolder) || _cloudAdding)">@(_cloudAdding ? "Linking…" : "Link folder")</MudButton>
        </div>
        @if (_cloudError is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_cloudError</MudAlert> }
        @if (Cloud.Status is { } cloudStatus) { <div class="muted small">@cloudStatus</div> }
        @foreach (var c in _cloud)
        {
            var folder = c;
            <div class="memory-row">
                <span class="grow"><Icon Name="folder" Size="16" /> <b>@folder.Name</b> <span class="muted small">@folder.ProviderName</span>
                    @if (folder.Link is not null) { <a class="small" href="@folder.Link" target="_blank" rel="noopener">open</a> }</span>
                <span class="muted small">
                    @folder.Files files@(folder.Skipped > 0 ? $" ({folder.Skipped} more not indexed)" : "")
                    · @(folder.LastSync is { } at ? $"synced {at:MMM d h:mm tt}" : "indexing…")
                </span>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => SyncCloud(folder.Id)">Sync now</MudButton>
                <MudIconButton Size="Size.Small" title="Unlink folder" aria-label="Unlink folder" OnClick="() => Cloud.RemoveAsync(folder.Id)"><Icon Name="trash-2" Size="15" /></MudIconButton>
            </div>
            @if (folder.Error is not null) { <div class="tiny-error">@folder.Error</div> }
        }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Library (@_docs.Count(d => d.FolderId is null))</h3>
        @foreach (var d in _docs.Where(d => d.FolderId is null))
        {
            var doc = d;
            <div class="memory-row">
                <span class="grow">📄 <b>@doc.Name</b></span>
                <span class="muted small">@doc.Chunks passages · @(doc.Characters / 1000)k chars · @(doc.KeywordOnly ? "keyword search" : doc.EmbeddingModel)</span>
                <MudIconButton Size="Size.Small" title="Remove" OnClick="() => Store.DeleteAsync(doc.Id)">🗑</MudIconButton>
            </div>
        }
        @if (!_docs.Any(d => d.FolderId is null)) { <p class="muted">No documents added one by one yet.</p> }
    </MudPaper>
</div>

@code {
    private List<DocumentInfo> _docs = [];
    private string? _progress;
    private string? _error;
    private string _embedModel = "";
    private List<LinkedFolder> _folders = [];
    private List<ProjectChange> _changes = [];
    private string? _undoError;
    private string _folderPath = "";
    private string? _folderError;
    private List<CloudFolder> _cloud = [];
    private string _cloudProvider = "google";
    private string _cloudFolder = "";
    private string? _cloudError;
    private bool _cloudAdding;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += Reload;
        Folders.Changed += ReloadFolders;
        History.Changed += ReloadFolders;
        Cloud.Changed += ReloadFolders;
        _cloud = await Cloud.ListAsync();
        _docs = await Store.ListAsync();
        _folders = await Folders.ListAsync();
        _changes = await History.ListAsync();
        _embedModel = (await Settings.GetAsync()).Documents.EmbeddingModel;
    }

    private async void Reload()
    {
        _docs = await Store.ListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void ReloadFolders()
    {
        _folders = await Folders.ListAsync();
        _changes = await History.ListAsync();
        _cloud = await Cloud.ListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddFolder()
    {
        _folderError = await Folders.AddAsync(_folderPath);
        if (_folderError is null) _folderPath = "";
    }

    private async Task FolderKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_folderPath)) await AddFolder();
    }

    private async Task Undo(string id) => _undoError = await History.UndoAsync(id);

    private void SyncFolder(string id) => _ = Folders.SyncAsync(id);

    private void SyncCloud(string id) => _ = Cloud.SyncAsync(id);

    private async Task AddCloud()
    {
        _cloudAdding = true;
        _cloudError = await Cloud.AddAsync(_cloudProvider, _cloudFolder);
        if (_cloudError is null) _cloudFolder = "";
        _cloudAdding = false;
    }

    private async Task SaveModel()
    {
        var s = SettingsCopy.Of(await Settings.GetAsync());
        s.Documents.EmbeddingModel = _embedModel.Trim();
        await Settings.SaveAsync(s);
    }

    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        _error = null;
        foreach (var file in e.GetMultipleFiles(50))
        {
            try
            {
                _progress = $"Reading {file.Name}…";
                StateHasChanged();
                await using var s = file.OpenReadStream(maxAllowedSize: 60L * 1024 * 1024);
                using var ms = new MemoryStream();
                await s.CopyToAsync(ms);
                var text = await Task.Run(() => TextExtractor.Extract(file.Name, ms.ToArray()));
                var progress = new Progress<string>(m => { _progress = $"{file.Name}: {m}"; InvokeAsync(StateHasChanged); });
                await Store.AddAsync(file.Name, text, progress);
            }
            catch (Exception ex)
            {
                _error = $"{file.Name}: {ex.Message}";
            }
        }
        _progress = null;
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    public override void Dispose() { Store.Changed -= Reload; Folders.Changed -= ReloadFolders; History.Changed -= ReloadFolders; Cloud.Changed -= ReloadFolders; base.Dispose(); }
}
