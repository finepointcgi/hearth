@page "/welcome"
@inherits StatefulComponent
@inject SettingsStore Settings
@inject BotStore Bots
@inject Hearth.Core.Llm.ILlmClientFactory Llms
@inject NavigationManager Nav
@inject IServiceProvider Services

<div class="settings welcome-setup">
    <div class="setup-head">
        <div class="welcome-logo">H</div>
        <h1>Welcome to Hearth</h1>
        <p class="muted">Three quick steps: connect a model, meet your bots, and take Hearth with you. You can change everything later.</p>
        <ol class="setup-steps">
            @foreach (var (n, label) in new[] { (1, "Model"), (2, "Bots"), (3, "Phone") })
            {
                <li class="@(_step == n ? "on" : _step > n ? "done" : "")">@if (_step > n) { <Icon Name="check" Size="14" /> } else { @n } @label</li>
            }
        </ol>
    </div>

    @if (_step == 1)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Connect a model</h3>
            <p class="muted small">Hearth runs on models you choose. These were found on this computer:</p>
            @if (_scanning) { <p class="muted small">Looking for model servers…</p> }
            @foreach (var c in _found)
            {
                var cand = c;
                <div class="usage-row">
                    <span class="needs-icon"><Icon Name="server" Size="16" /></span>
                    <span class="grow"><b>@cand.Profile.Name</b><br /><span class="muted small">@cand.Profile.BaseUrl · @cand.Models model@(cand.Models == 1 ? "" : "s")</span></span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => Use(cand.Profile)">Use this</MudButton>
                </div>
            }
            @if (!_scanning && _found.Count == 0)
            {
                <p class="small">Nothing found yet. Install <a href="https://ollama.com" target="_blank" rel="noopener">Ollama</a> (then <code>ollama pull llama3.2</code>),
                    LM Studio or oMLX, and scan again, or connect a server elsewhere below.</p>
            }
            <div class="row"><MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="ScanAsync" Disabled="@_scanning"><Icon Name="refresh-cw" Size="15" /> Scan again</MudButton></div>

            <details class="steps" open="@(!_scanning && _found.Count == 0)">
                <summary>Use a server on another computer, or Claude</summary>
                <div class="row">
                    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_kind">
                        <MudSelectItem Value="@(ProviderKind.OpenAICompatible)">OpenAI-compatible (oMLX, LM Studio, vLLM, OpenRouter…)</MudSelectItem>
                        <MudSelectItem Value="@(ProviderKind.Ollama)">Ollama</MudSelectItem>
                        <MudSelectItem Value="@(ProviderKind.ClaudeCode)">Claude Code (your Claude subscription)</MudSelectItem>
                    </MudSelect>
                    @if (_kind != ProviderKind.ClaudeCode)
                    {
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_url" Placeholder="http://10.0.0.20:8000/v1" />
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" @bind-Value="_key" Placeholder="API key (if needed)" Style="width:12rem" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TestCustom" Disabled="@_testing">@(_testing ? "Testing…" : "Test and use")</MudButton>
                </div>
                @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
            </details>
        </MudPaper>
        <div class="row end"><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _step = 2">Skip for now</MudButton></div>
    }
    else if (_step == 2)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Meet your bots</h3>
            <p class="muted small">Bots are AI teammates with their own role, abilities and memory. Start with a ready-made team, or one bot.</p>
            <button class="setup-choice" @onclick="AddTeam">
                <span class="needs-icon"><Icon Name="users" Size="18" /></span>
                <span class="grow"><b>Add the starter team</b><br /><span class="muted small">@string.Join(", ", BotTemplates.All.Take(5).Select(t => t.Name)): they can hand work to each other</span></span>
                <Icon Name="chevron-right" />
            </button>
            <div class="template-grid">
                @foreach (var t in BotTemplates.All)
                {
                    var template = t;
                    <button class="bot-card pick" @onclick="() => AddOne(template)">
                        <BotAvatar Bot="template" Size="lg" /><b>@template.Name</b><span class="muted small">@template.Title</span>
                    </button>
                }
            </div>
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
        </MudPaper>
        <div class="row end">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _step = 1">Back</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _step = 3">Skip</MudButton>
        </div>
    }
    else
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Take Hearth with you</h3>
            <p class="muted small">Use your bots from your phone, get notified when they need you, and chat from the apps you already use.</p>
            <a class="setup-choice" href="connections">
                <span class="needs-icon"><Icon Name="monitor" Size="18" /></span>
                <span class="grow"><b>Phone app and notifications</b><br /><span class="muted small">Scan a code to connect the Hearth app, set up ntfy alerts</span></span>
                <Icon Name="chevron-right" />
            </a>
            <a class="setup-choice" href="connections">
                <span class="needs-icon"><Icon Name="send" Size="18" /></span>
                <span class="grow"><b>Telegram, Slack, Discord, Signal or iMessage</b><br /><span class="muted small">Message your bots from your chat apps</span></span>
                <Icon Name="chevron-right" />
            </a>
        </MudPaper>
        <div class="row end">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _step = 2">Back</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Finish">Start using Hearth</MudButton>
        </div>
    }
</div>

@code {
    private sealed record Candidate(ProviderProfile Profile, int Models);

    private int _step = 1;
    private bool _scanning, _testing;
    private List<Candidate> _found = [];
    private ProviderKind _kind = ProviderKind.OpenAICompatible;
    private string _url = "", _key = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // A second account on a shared Hearth already has the owner's model servers: start at the bots.
        if (Services.GetService<ICurrentUser>()?.Account is { IsOwner: false } && (await Settings.GetAsync()).Providers.Count > 0)
        {
            _step = 2;
            return;
        }
        await ScanAsync();
    }

    private async Task ScanAsync()
    {
        _scanning = true;
        _found = [];
        StateHasChanged();
        var candidates = new[]
        {
            new ProviderProfile { Name = "Ollama (this computer)", Kind = ProviderKind.Ollama, BaseUrl = "http://localhost:11434" },
            new ProviderProfile { Name = "LM Studio (this computer)", Kind = ProviderKind.OpenAICompatible, BaseUrl = "http://localhost:1234/v1" },
            new ProviderProfile { Name = "oMLX (this computer)", Kind = ProviderKind.OpenAICompatible, BaseUrl = "http://localhost:8000/v1" },
        };
        var checks = candidates.Select(async p =>
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
            try { return new Candidate(p, (await Llms.Create(p).ListModelsAsync(cts.Token)).Count); }
            catch { return null; }
        });
        _found = (await Task.WhenAll(checks)).OfType<Candidate>().Where(c => c.Models > 0).ToList();
        _scanning = false;
    }

    private async Task TestCustom()
    {
        _error = null;
        _testing = true;
        try
        {
            var p = new ProviderProfile
            {
                Kind = _kind,
                Name = _kind == ProviderKind.ClaudeCode ? "Claude Code" : new Uri(_url.Contains("://") ? _url : "http://" + _url).Host,
                BaseUrl = _kind == ProviderKind.ClaudeCode ? "" : (_url.Contains("://") ? _url : "http://" + _url).TrimEnd('/'),
                ApiKey = string.IsNullOrWhiteSpace(_key) ? null : _key.Trim(),
                DefaultModel = _kind == ProviderKind.ClaudeCode ? "sonnet" : null,
            };
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var models = await Llms.Create(p).ListModelsAsync(cts.Token);
            if (models.Count == 0 && _kind != ProviderKind.ClaudeCode) { _error = "Connected, but the server reports no models."; return; }
            await Use(p);
        }
        catch (Exception ex) { _error = "Couldn't connect: " + ex.Message; }
        finally { _testing = false; _key = ""; }
    }

    private async Task Use(ProviderProfile p)
    {
        var s = await Settings.GetAsync();
        var existing = s.Providers.FirstOrDefault(x => x.Kind == p.Kind && x.BaseUrl.TrimEnd('/') == p.BaseUrl.TrimEnd('/'));
        if (existing is null) s.Providers.Add(p); else p = existing;
        s.ActiveProviderId = p.Id;
        await Settings.SaveAsync(s);
        _step = 2;
    }

    private async Task AddTeam()
    {
        _error = null;
        try
        {
            foreach (var t in BotTemplates.All.Take(5).Where(t => State.Bots.All(b => b.Name != t.Name))) await Bots.SaveAsync(t);
            _step = 3;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task AddOne(Bot template)
    {
        _error = null;
        try
        {
            if (State.Bots.All(b => b.Name != template.Name)) await Bots.SaveAsync(template);
            _step = 3;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Finish()
    {
        var s = await Settings.GetAsync();
        s.SetupDone = true;
        await Settings.SaveAsync(s);
        Nav.NavigateTo("");
    }
}
