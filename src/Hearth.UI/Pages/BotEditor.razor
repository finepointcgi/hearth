@page "/bots/{Id}"
@inherits StatefulComponent
@inject CodeTools CodeTools
@inject BotStore Store
@inject MemoryStore Memories
@inject BuiltInToolProvider BuiltIns
@inject RoutineRunner Routines
@inject NavigationManager Nav
@inject PlatformInfo Platform
@inject TriggerStateStore TriggerStates
@inject IJSRuntime JS
@inject IBotComputer Computer
@inject ISandboxDesktops Sandboxes
@inject BotCheckRunner CheckRunner
@inject Hearth.Core.Llm.ILlmClientFactory Llms
@inject Hearth.Core.Services.Google.GoogleAuth GoogleAuth
@inject Hearth.Core.Services.Microsoft.MicrosoftAuth MicrosoftAuth

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    @if (_bot is not null) { <BotAvatar Bot="_bot" /> }
    <h2 class="topbar-title">@(_isNew ? "New bot" : _bot?.Name)</h2>
    <span class="spacer"></span>
    @if (_saved) { <span class="ok-text"><Icon Name="check" Size="16" /> Saved</span> }
    @if (!_isNew) { <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"bot/{Id}")">Chat</MudButton> }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
</header>

@if (_bot is not null)
{
<div class="settings">
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
    <div class="tabs" role="tablist" aria-label="Bot settings">
        @foreach (var (id, label, icon, badge) in Tabs())
        {
            var tab = id;
            <button role="tab" aria-selected="@(_tab == tab)" class="tab @(_tab == tab ? "on" : "")" @onclick="() => _tab = tab">
                <Icon Name="@icon" Size="16" /> @label @if (badge is not null) { <span class="tab-badge">@badge</span> }
            </button>
        }
    </div>

    @if (_tab == "profile")
    {
    <MudPaper Class="card" Elevation="0">
        <h3>Identity</h3>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_bot.Emoji" Style="width:4.5rem;text-align:center;font-size:1.3rem" MaxLength="8" Label="Emoji" />
            <label>Colour <input type="color" @bind="_bot.Color" style="width:4rem;padding:.2rem" /></label>
            <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_bot.Name" Placeholder="e.g. Researcher" Label="Name" />
        </div>
        <div class="avatar-picker">
            <div class="avatar-preview" title="How it looks, and how it moves while thinking">
                <BotAvatar Bot="_bot" Size="lg" />
                <BotAvatar Bot="_bot" Size="lg" Working="true" />
            </div>
            <label class="btn ghost file-btn">@(_bot.AvatarImage is null ? "Upload picture" : "Change picture")
                <InputFile OnChange="OnAvatarPicked" accept="image/png,image/jpeg,image/webp,image/gif" style="display:none" /></label>
            @if (_bot.AvatarImage is not null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _bot.AvatarImage = null">Use emoji instead</MudButton>
            }
            <MudSelect Label="While thinking" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_bot.WorkingAnimation">
                    @foreach (var (id, label) in Bot.WorkingAnimations) { <MudSelectItem Value="@(id)">@label</MudSelectItem> }
                </MudSelect>
        </div>
        @if (_avatarError is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_avatarError</MudAlert> }
        @if (_bot.AvatarImage is not null) { <p class="muted small">The emoji is still used in chat apps (Telegram, Discord…) and menus that can only show text.</p> }
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_bot.Title" Placeholder="e.g. Research & fact-checking" Label="Title / role" />
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="7" @bind-Value="_bot.Instructions" Placeholder="What this bot does, how it works, its tone, what it should never do…" Label="Instructions" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_bot.IsCoordinator" Class="check" Label='Coordinator ("chief of staff"): routes work to the other bots and combines their results' />
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Model</h3>
        @if (State.Settings.Providers.Count > 1)
        {
            <MudSelect Label="Model server" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(_bot.ProviderId ?? "")" ValueChanged="(string v) => SetProvider(v)" T="string">
                    <MudSelectItem Value="@("")">Same as the app (@State.Settings.ActiveProvider.Name)</MudSelectItem>
                    @foreach (var p in State.Settings.Providers.Where(p => p.Id != State.Settings.ActiveProvider.Id))
                    {
                        <MudSelectItem Value="@(p.Id)">@p.Name</MudSelectItem>
                    }
                </MudSelect>
        }
        <MudSelect Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_bot.Model">
                <MudSelectItem Value="@("")">@(OwnServer ? $"{OwnProvider!.Name}'s default model" : "Use the model selected in the chat")</MudSelectItem>
                @foreach (var m in BotModels) { <MudSelectItem Value="@(m.Id)">@m.Id</MudSelectItem> }
                @if (!string.IsNullOrEmpty(_bot.Model) && BotModels.All(m => m.Id != _bot.Model)) { <MudSelectItem Value="@(_bot.Model)">@_bot.Model (not available)</MudSelectItem> }
            </MudSelect>
        @if (_serverError is not null) { <span class="tiny-error">@_serverError</span> }
        @if (OwnServer) { <span class="muted small">If @OwnProvider!.Name can't be reached, this bot falls back to @State.Settings.ActiveProvider.Name.</span> }

        <h4 class="versions-head">Versions</h4>
        <span class="muted small">Other models this bot can run on. A coordinator sees them and picks one when a problem needs a stronger, faster or more private model, e.g. "claude" for hard research.</span>
        @foreach (var v in _bot.Versions)
        {
            var version = v;
            <div class="version-row">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="version.Name" Placeholder="e.g. claude" Style="width:8rem" Label="Name" />
                <MudSelect Label="Server" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(version.ProviderId ?? "")" ValueChanged="(string v) => SetVersionProvider(version, v)" T="string">
                        <MudSelectItem Value="@("")">@State.Settings.ActiveProvider.Name (the app's)</MudSelectItem>
                        @foreach (var p in State.Settings.Providers.Where(p => p.Id != State.Settings.ActiveProvider.Id)) { <MudSelectItem Value="@(p.Id)">@p.Name</MudSelectItem> }
                    </MudSelect>
                <MudSelect Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="version.Model">
                        <MudSelectItem Value="@("")">Server's default</MudSelectItem>
                        @foreach (var m in VersionModels(version)) { <MudSelectItem Value="@(m.Id)">@m.Id</MudSelectItem> }
                        @if (!string.IsNullOrEmpty(version.Model) && VersionModels(version).All(m => m.Id != version.Model)) { <MudSelectItem Value="@(version.Model)">@version.Model</MudSelectItem> }
                    </MudSelect>
                <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="version.Note" Placeholder="e.g. hard research or code; uses your Claude plan" Label="When to use it" />
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" title="Remove this version" OnClick="() => _bot.Versions.Remove(version)">✕</MudButton>
            </div>
        }
        <div><MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="AddVersion">+ Add version</MudButton></div>

        <details class="advanced">
            <summary>Advanced: limit to specific tools</summary>
            <MudSelect Label="Tool access" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_bot.ToolMode">
                    <MudSelectItem Value="@(BotToolMode.All)">Use the bot's abilities (Abilities tab)</MudSelectItem>
                    <MudSelectItem Value="@(BotToolMode.Selected)">Only the tools picked below (ignores abilities)</MudSelectItem>
                    <MudSelectItem Value="@(BotToolMode.None)">No tools at all</MudSelectItem>
                </MudSelect>
            @if (_bot.ToolMode == BotToolMode.Selected)
            {
                <div class="tool-pick">
                    @foreach (var (tool, reason) in _catalog)
                    {
                        var t = tool;
                        <MudSwitch T="bool" Color="Color.Primary" Value="@(_bot.AllowedTools.Contains(t.Name))" ValueChanged="(bool v) => ToggleTool(t.Name, v)" Class="check">@t.Icon @t.DisplayName @if (reason is not null) { <span class="muted small">(@reason)</span> }</MudSwitch>
                    }
                </div>
            }
        </details>
    </MudPaper>

    @if (!_isNew)
    {
        <MudPaper Class="card danger" Elevation="0">
            @if (_confirmDelete)
            {
                <div class="row">
                    <span>Delete @_bot.Name? Its chats stay, but it won't reply in them.</span>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Delete">Delete</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _confirmDelete = false">Cancel</MudButton>
                </div>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => _confirmDelete = true">Delete bot</MudButton>
            }
        </MudPaper>
    }
    }
    @if (_tab == "abilities")
    {
    <MudPaper Class="card" Elevation="0">
        <h3>Abilities</h3>
        <p class="muted">Switch on what @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name) may do. Things that also need setting up elsewhere say so.</p>
        <div class="ability-list">
            @foreach (var a in AbilityList())
            {
                var ability = a;
                <label class="ability-row @(ability.Get() ? "on" : "")">
                    <span class="ability-icon"><Icon Name="@ability.Icon" Size="18" /></span>
                    <span class="ability-text">
                        <b>@ability.Name</b>
                        <span class="muted small">@ability.Description</span>
                    </span>
                    @if (ability.Hint is not null && ability.Get())
                    {
                        <a class="chip-warn" href="@ability.HintLink" title="@ability.Hint">Needs setup</a>
                    }
                    <MudSwitch T="bool" Color="Color.Primary" Class="switch" role="switch" Value="@(ability.Get())" ValueChanged="(bool v) => ability.Set(v)" aria-label="@ability.Name" />
                </label>
            }
        </div>
    </MudPaper>

    @if (_bot.Abilities.Code && CodeTools.Available)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Coding</h3>
            <p class="muted small">Start a code session with @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name) from the Code tab. With a project folder set, it can also find, read, edit and test code there in its normal chats and when another bot hands it work (edits it isn't allowed to make without you are refused when you aren't watching).</p>
            <label>Project folder <span class="muted small">(optional)</span>
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Full path, e.g. /Users/me/src/my-app" @bind-Value="_bot.Abilities.ProjectFolder" />
            </label>
            @if (!string.IsNullOrWhiteSpace(_bot.Abilities.ProjectFolder) && !Directory.Exists(_bot.Abilities.ProjectFolder.Trim()))
            {
                <span class="tiny-error">That folder doesn't exist.</span>
            }
            <MudSelect Label="File edits in that folder" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_bot.Abilities.CodeMode">
                    <MudSelectItem Value="@(CodePermissionMode.Ask)">Ask me each time</MudSelectItem>
                    <MudSelectItem Value="@(CodePermissionMode.AcceptEdits)">Allow without asking</MudSelectItem>
                    <MudSelectItem Value="@(CodePermissionMode.Plan)">Read only</MudSelectItem>
                </MudSelect>
        </MudPaper>
    }

    @if (_bot.Abilities.Browser)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Browser</h3>
            <div class="seg">
                <button class="@(_bot.Abilities.BrowserProfile == BrowserProfile.Own ? "on" : "")" @onclick="() => _bot.Abilities.BrowserProfile = BrowserProfile.Own">
                    <b>Its own browser</b><span class="muted small">Separate cookies and sign-ins, just for @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name)</span>
                </button>
                <button class="@(_bot.Abilities.BrowserProfile == BrowserProfile.Shared ? "on" : "")" @onclick="() => _bot.Abilities.BrowserProfile = BrowserProfile.Shared">
                    <b>Shared browser</b><span class="muted small">Uses the sign-ins every bot shares</span>
                </button>
            </div>
            @if (!_isNew && Computer.Status.Available)
            {
                <div class="row">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SignInBrowser" Disabled="@_busy">🔑 Open @(_bot.Abilities.BrowserProfile == BrowserProfile.Own ? "its" : "the shared") browser to sign in</MudButton>
                    @if (_bot.Abilities.BrowserProfile == BrowserProfile.Own)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ResetBrowser" Disabled="@_busy" title="Deletes this bot's cookies and sign-ins">Reset its browser</MudButton>
                    }
                </div>
                <span class="muted small">A window opens on this computer. Sign in to the sites this bot should use, then close it — sign-ins are kept.</span>
            }
            else if (!Computer.Status.Available)
            {
                <span class="muted small">@Computer.Status.UnavailableReason</span>
            }
        </MudPaper>
    }

    @if (_bot.Abilities.ComputerUse)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Computer use</h3>
            <div class="seg">
                <button class="@(_bot.Abilities.Desktop == DesktopTarget.Sandbox ? "on" : "")" @onclick="() => _bot.Abilities.Desktop = DesktopTarget.Sandbox">
                    <b>Its own sandbox</b><span class="muted small">A private Linux desktop in Docker. Can't see your screen or files, so it works without asking.</span>
                </button>
                <button class="@(_bot.Abilities.Desktop == DesktopTarget.ThisComputer ? "on" : "")" @onclick="() => _bot.Abilities.Desktop = DesktopTarget.ThisComputer">
                    <b>This computer</b><span class="muted small">Your real screen, mouse and keyboard. Asks before each action.</span>
                </button>
            </div>
            @if (_bot.Abilities.Desktop == DesktopTarget.Sandbox)
            {
                @if (_isNew) { <span class="muted small">Save the bot first; its desktop starts the first time it's used.</span> }
                else { <SandboxView BotId="@_bot.Id" /> }
            }
        </MudPaper>
    }

    }
    @if (_tab == "memory")
    {
    <MudPaper Class="card" Elevation="0">
        <h3>Memory</h3>
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_bot.Memory.Enabled" Class="check"><span><b>Remember things</b> — keeps its own memory across all its chats</span></MudSwitch>
        @if (_bot.Memory.Enabled)
        {
            <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_bot.Memory.AutoLearn" Class="check"><span><b>Learn automatically</b> — after each reply, quietly saves anything worth remembering</span></MudSwitch>
            <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_bot.Memory.UseSharedMemory" Class="check"><span><b>Know what other bots know about you</b> — reads the shared memory</span></MudSwitch>
            <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_bot.Memory.ShareWhatItLearns" Class="check"><span><b>Share what it learns about you</b> — adds facts about you to the shared memory</span></MudSwitch>
            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_bot.Memory.MaxInPrompt" Style="width:5.5rem" Label="Memories in each prompt" HelperText="older ones stay in long-term storage and come up when relevant" />

            @if (!_isNew)
            {
                <div class="tool-label">@_memories.Count memories</div>
                <div class="row">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_newMemory" OnKeyDown="AddMemoryKey" Placeholder="Teach it something, e.g. Our launch date is March 3" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddMemory" Disabled="@string.IsNullOrWhiteSpace(_newMemory)">Add</MudButton>
                </div>
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="search" @bind-Value="_memoryFilter" Immediate="true" Placeholder="Search memories" />
                @foreach (var m in _memories.Where(m => _memoryFilter.Length == 0 || m.Text.Contains(_memoryFilter, StringComparison.OrdinalIgnoreCase)).OrderByDescending(m => m.CreatedAt))
                {
                    var mem = m;
                    <div class="memory-row">
                        @if (_editingMemory == mem.Id)
                        {
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_editMemoryText" OnKeyDown="e => EditMemoryKey(e, mem.Id)" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SaveMemory(mem.Id)">Save</MudButton>
                        }
                        else
                        {
                            <span class="grow">@mem.Text</span>
                            <span class="muted small">@mem.CreatedAt.ToString("MMM d")</span>
                            <MudIconButton Size="Size.Small" title="Edit" OnClick="() => { _editingMemory = mem.Id; _editMemoryText = mem.Text; }">✎</MudIconButton>
                            <MudIconButton Size="Size.Small" title="Forget" OnClick="() => DeleteMemory(mem.Id)">🗑</MudIconButton>
                        }
                    </div>
                }
                @if (_memories.Count > 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="ClearMemory">Forget everything @_bot.Name knows</MudButton>
                }
            }
        }
    </MudPaper>

    }
    @if (_tab == "checks")
    {
    <MudPaper Class="card" Elevation="0">
        <div class="row">
            <h3 class="grow">Checks</h3>
            @if (_bot.Checks.Count > 0) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAllChecks" Disabled="@(_runningCheck is not null)"><Icon Name="refresh-cw" Size="15" /> Run all</MudButton> }
        </div>
        <p class="muted small">Example questions with what a good answer does. Run them after changing the instructions, abilities or model to see that
            @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name) still works. Checks use the settings on this page, even before you save,
            run in a throwaway chat, skip anything that needs approval, and never change its memory or skills.</p>
        @foreach (var c in _bot.Checks)
        {
            var check = c;
            <div class="check-card @(check.Last is null ? "" : check.Last.Pass ? "pass" : "fail")">
                <div class="row">
                    <span class="check-status">@if (_runningCheck == check.Id) { <text>Running…</text> } else if (check.Last is { } r) { <Icon Name="@(r.Pass ? "check" : "circle-x")" Size="16" /> @(r.Pass ? "Pass" : "Fail") } else { <text>Not run</text> }</span>
                    <span class="spacer"></span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => RunCheck(check)" Disabled="@(_runningCheck is not null || string.IsNullOrWhiteSpace(check.Question))">Run</MudButton>
                    <MudIconButton Size="Size.Small" title="Remove" aria-label="Remove check" OnClick="() => _bot.Checks.Remove(check)"><Icon Name="trash-2" Size="15" /></MudIconButton>
                </div>
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" @bind-Value="check.Question" Placeholder="What's the monthly payment on $20,000 over 5 years at 6%?" Label="Question" />
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="check.Expect" Placeholder="uses the calculator and gives about $386.66 per month" Label="A good answer…" />
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="check.MustInclude" Placeholder="386.66" Label="Must include (optional, comma-separated)" />
                @if (check.Last is { } last)
                {
                    <div class="small"><b>@(last.Pass ? "Why it passed" : "Why it failed"):</b> @last.Reason
                        <span class="muted"> · @last.Model · @(last.Milliseconds / 1000.0)s · @last.At.ToString("MMM d, h:mm tt")</span></div>
                    @if (last.Answer.Length > 0) { <details class="advanced"><summary>The answer</summary><div class="md"><Markdown Text="@last.Answer" /></div></details> }
                }
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _bot.Checks.Add(new BotCheck())"><Icon Name="plus" Size="16" /> Add a check</MudButton>
        @if (_checkSummary is not null) { <div class="@(_checkSummary.StartsWith("All") ? "ok-text" : "tiny-error")">@_checkSummary</div> }
    </MudPaper>
    }

    @if (_tab == "routines")
    {
    <MudPaper Class="card" Elevation="0">
        <h3>Routines and triggers</h3>
        <p class="muted">
            Prompts this bot runs on its own: on a schedule, or when something happens. Results show up in its chat,
            marked unread. Start a prompt with <code>/skill-name</code> to reuse a skill. Tools that need approval are skipped.
        </p>
        @foreach (var r in _bot.Routines)
        {
            var routine = r;
            <div class="provider">
                <div class="row">
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="routine.Enabled" Class="check" Label="On" />
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="routine.NotifyChannels" title="Also send results to linked Telegram/Discord/Slack chats that have routine notifications on" Class="check" Label="Send to chat apps" />
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="routine.Name" Placeholder="Name, e.g. Morning briefing" />
                    <MudIconButton Size="Size.Small" title="Remove" OnClick="() => _bot.Routines.Remove(routine)">🗑</MudIconButton>
                </div>
                <div class="row">
                    <MudSelect Class="grow" Label="When" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="routine.Trigger">
                            <MudSelectItem Value="@(TriggerKind.Schedule)">⏰ On a schedule</MudSelectItem>
                            <MudSelectItem Value="@(TriggerKind.Webhook)" Disabled="@(!Platform.SupportsWebhooks)">🪝 A webhook is called@(Platform.SupportsWebhooks ? "" : " (not on this device)")</MudSelectItem>
                            <MudSelectItem Value="@(TriggerKind.Folder)" Disabled="@(!Platform.CanUseComputer)">📁 A file appears or changes in a folder@(Platform.CanUseComputer ? "" : Platform.CanRunProcesses ? " (not allowed for this account)" : " (desktop only)")</MudSelectItem>
                            <MudSelectItem Value="@(TriggerKind.Feed)">📰 A new item appears in an RSS/Atom feed</MudSelectItem>
                            <MudSelectItem Value="@(TriggerKind.PageChange)">🌐 A web page changes</MudSelectItem>
                            <MudSelectItem Value="@(TriggerKind.Sheet)" Disabled="@(!_googleConnected)">📊 A Google Sheet changes@(_googleConnected ? "" : " (connect Google first)")</MudSelectItem>
                            <MudSelectItem Value="@(TriggerKind.Email)" Disabled="@(!_googleConnected)">📧 New email arrives@(_googleConnected ? "" : " (connect Google first)")</MudSelectItem>
                            <MudSelectItem Value="@(TriggerKind.Calendar)" Disabled="@(!_googleConnected)">📅 A calendar event is coming up@(_googleConnected ? "" : " (connect Google first)")</MudSelectItem>
                        </MudSelect>
                </div>
                @switch (routine.Trigger)
                {
                    case TriggerKind.Schedule:
                        <div class="row">
                            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="routine.Schedule">
                                <MudSelectItem Value="@(RoutineSchedule.Daily)">Every day at</MudSelectItem>
                                <MudSelectItem Value="@(RoutineSchedule.Weekdays)">Weekdays at</MudSelectItem>
                                <MudSelectItem Value="@(RoutineSchedule.Weekly)">Every week on</MudSelectItem>
                                <MudSelectItem Value="@(RoutineSchedule.EveryMinutes)">Every … minutes</MudSelectItem>
                            </MudSelect>
                            @if (routine.Schedule == RoutineSchedule.Weekly)
                            {
                                <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="routine.Day" aria-label="Day of the week">
                                    @foreach (var day in Enum.GetValues<DayOfWeek>()) { <MudSelectItem Value="@(day)">@day</MudSelectItem> }
                                </MudSelect>
                                <span class="muted">at</span>
                            }
                            @if (routine.Schedule == RoutineSchedule.EveryMinutes)
                            {
                                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.IntervalMinutes" Style="width:6rem" />
                            }
                            else
                            {
                                <input type="time" value="@routine.TimeOfDay" @onchange="e => routine.TimeOfDay = e.Value?.ToString() ?? routine.TimeOfDay" />
                            }
                        </div>
                        break;
                    case TriggerKind.Webhook:
                        @if (_isNew)
                        {
                            <p class="muted small">Save the bot to get its webhook URL.</p>
                        }
                        else
                        {
                            var url = WebhookUrl(routine);
                            <div class="hook">
                                <div class="row"><code class="grow ellipsis" title="@url">@url</code>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Copy(url)">Copy</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" title="Invalidates the old URL" OnClick="() => routine.WebhookSecret = Routine.NewSecret()">New secret</MudButton>
                                </div>
                                <span class="muted small">POST anything (JSON, text, form) — the body is passed to the bot. Works with GitHub, Home Assistant, IFTTT/Zapier, cron and scripts:</span>
                                <code class="snippet">curl -X POST "@url" -H "Content-Type: application/json" -d '{"event":"test"}'</code>
                                @if (Platform.WebhookBaseUrl?.Contains("localhost") == true)
                                {
                                    <span class="muted small">The desktop app only accepts webhooks from this computer. Use the web host to receive them from other machines.</span>
                                }
                            </div>
                        }
                        break;
                    case TriggerKind.Folder:
                        <div class="row">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="routine.FolderPath" Placeholder="Folder, e.g. /Users/me/Downloads/Invoices" />
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.FilePattern" Placeholder="Pattern, e.g. *.pdf" Style="width:9rem" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(routine.FolderPath) && !Directory.Exists(routine.FolderPath))
                        {
                            <span class="tiny-error">That folder doesn't exist.</span>
                        }
                        <span class="muted small">New and changed files (PDF, text, code…) are read and passed to the bot.</span>
                        break;
                    case TriggerKind.Sheet:
                        <div class="row">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="routine.Url" Placeholder="Spreadsheet URL, ID or name" />
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.SheetRange" Placeholder="Range, e.g. Leads!A:F (default: first tab)" Style="width:16rem" />
                            <label>every <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.PollMinutes" Style="width:5rem" /> min</label>
                        </div>
                        <span class="muted small">New and edited rows (with the header row) are passed to the bot.</span>
                        @if (_states.TryGetValue(routine.Id, out var sst))
                        {
                            <span class="muted small">
                                @(sst.LastPolled is { } slp ? $"Last checked {slp:MMM d, h:mm tt}" : "Not checked yet")
                                @if (sst.LastError is not null) { <span class="tiny-error"> · @sst.LastError</span> }
                            </span>
                        }
                        break;
                    case TriggerKind.Email:
                        <div class="row">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="routine.Url" Placeholder="Gmail search, e.g. in:inbox is:unread from:boss (default: in:inbox is:unread)" />
                            <label>every <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.PollMinutes" Style="width:5rem" /> min</label>
                        </div>
                        <span class="muted small">New matching emails (sender, subject and text) are passed to the bot. The first check only notes what's already there.</span>
                        break;
                    case TriggerKind.Calendar:
                        <div class="row">
                            <label><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.LeadMinutes" Style="width:5rem" /> minutes before each event</label>
                            <label>check every <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.PollMinutes" Style="width:5rem" /> min</label>
                        </div>
                        <span class="muted small">The event's title, time, attendees and notes are passed to the bot — great for meeting prep.</span>
                        break;
                    case TriggerKind.Feed:
                    case TriggerKind.PageChange:
                        <div class="row">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="routine.Url" Placeholder="@(routine.Trigger == TriggerKind.Feed ? "https://github.com/ollama/ollama/releases.atom" : "https://example.com/pricing")" />
                            <label>every <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="routine.PollMinutes" Style="width:5rem" /> min</label>
                        </div>
                        @if (_states.TryGetValue(routine.Id, out var st))
                        {
                            <span class="muted small">
                                @(st.LastPolled is { } lp ? $"Last checked {lp:MMM d, h:mm tt}" : "Not checked yet")
                                @if (st.LastError is not null) { <span class="tiny-error"> · @st.LastError</span> }
                            </span>
                        }
                        break;
                }
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" @bind-Value="routine.Prompt" Placeholder="@PromptHint(routine)" />
                <div class="row">
                    <span class="muted small grow">@(routine.LastRun is { } lr ? $"Last run {lr:MMM d, h:mm tt}" : "Never run")</span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@(_isNew || _runningRoutine is not null)" OnClick="() => RunNow(routine)">
                        @(_runningRoutine == routine.Id ? "Running…" : routine.Trigger is TriggerKind.Feed or TriggerKind.PageChange or TriggerKind.Sheet or TriggerKind.Email or TriggerKind.Calendar ? "▶ Check now" : "▶ Test run")
                    </MudButton>
                </div>
                @if (_runResult.TryGetValue(routine.Id, out var rr)) { <span class="muted small">@rr</span> }
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _bot.Routines.Add(new Routine())"><Icon Name="plus" Size="16" /> Add routine</MudButton>
    </MudPaper>

    }
</div>
}

@code {
    private string _tab = "profile";
    private string? _runningCheck;
    private string? _checkSummary;

    private async Task RunCheck(BotCheck check)
    {
        _runningCheck = check.Id;
        _checkSummary = null;
        StateHasChanged();
        try { check.Last = await CheckRunner.RunAsync(_bot!, check); }
        catch (Exception ex) { check.Last = new BotCheckResult(false, ex.Message, "", DateTimeOffset.Now, "", 0); }
        finally { _runningCheck = null; }
        if (!_isNew) await Store.SaveAsync(_bot!); // keep results with the bot
    }

    private async Task RunAllChecks()
    {
        foreach (var c in _bot!.Checks.Where(c => !string.IsNullOrWhiteSpace(c.Question)).ToList())
        {
            await RunCheck(c);
            StateHasChanged();
        }
        var failed = _bot.Checks.Count(c => c.Last is { Pass: false });
        _checkSummary = failed == 0 ? $"All {_bot.Checks.Count} checks pass." : $"{failed} of {_bot.Checks.Count} checks failed.";
    }

    private IEnumerable<(string id, string label, string icon, string? badge)> Tabs()
    {
        yield return ("profile", "Profile", "user", null);
        var on = _bot is null ? 0 : AbilityList().Count(a => a.Get());
        yield return ("abilities", "Abilities", "wrench", on.ToString());
        yield return ("memory", "Memory", "brain", null);
        var routines = _bot?.Routines.Count ?? 0;
        yield return ("routines", "Routines", "clock", routines > 0 ? routines.ToString() : null);
        var checks = _bot?.Checks ?? [];
        var failing = checks.Count(c => c.Last is { Pass: false });
        yield return ("checks", "Checks", "list-checks", checks.Count == 0 ? null : failing > 0 ? $"{failing} failing" : checks.Count.ToString());
    }

    [Parameter] public string Id { get; set; } = "";

    private Bot? _bot;
    private bool _isNew;
    private bool _saved;
    private bool _confirmDelete;
    private string? _error;
    private string? _runningRoutine;
    private List<Hearth.Core.Services.Memory> _memories = [];
    private IReadOnlyList<(ITool tool, string? reason)> _catalog = [];

    protected override async Task OnParametersSetAsync()
    {
        _isNew = Id == "new";
        var existing = _isNew ? null : await Store.GetAsync(Id);
        if (!_isNew && existing is null) { Nav.NavigateTo("bots"); return; }
        // Edit a copy.
        _bot = existing is null
            ? new Bot { Emoji = "🤖", Name = "", Title = "" }
            : System.Text.Json.JsonSerializer.Deserialize<Bot>(System.Text.Json.JsonSerializer.Serialize(existing))!;
        _catalog = await BuiltIns.CatalogAsync(State.Settings);
        _memories = _isNew ? [] : await Memories.ListAsync(_bot.Id);
        foreach (var r in _bot.Routines) _states[r.Id] = await TriggerStates.GetAsync(r.Id);
        _googleConnected = await GoogleAuth.IsConnectedAsync();
        _microsoftConnected = await MicrosoftAuth.IsConnectedAsync();
        await LoadServerModelsAsync();
        foreach (var v in _bot.Versions) await LoadVersionModelsAsync(v);
    }

    private IReadOnlyList<ModelInfo> _serverModels = [];
    private string? _serverError;
    private ProviderProfile? OwnProvider => _bot?.ProviderId is { } id ? State.Settings.Providers.FirstOrDefault(p => p.Id == id) : null;
    private bool OwnServer => OwnProvider is { } p && p.Id != State.Settings.ActiveProvider.Id;
    private IReadOnlyList<ModelInfo> BotModels => OwnServer ? _serverModels : State.Models;

    private async Task SetProvider(string? id)
    {
        _bot!.ProviderId = string.IsNullOrEmpty(id) ? null : id;
        _bot.Model = null; // models differ between servers
        await LoadServerModelsAsync();
    }

    private async Task LoadServerModelsAsync()
    {
        _serverModels = [];
        _serverError = null;
        if (OwnProvider is not { } p || !OwnServer) return;
        try { _serverModels = await Llms.Create(p).ListModelsAsync(); }
        catch (Exception ex) { _serverError = $"{p.Name}: {ex.Message}"; }
    }

    private readonly Dictionary<string, IReadOnlyList<ModelInfo>> _modelsByServer = [];

    /// <summary>Models on a version's server (the app's own list for the active server).</summary>
    private IReadOnlyList<ModelInfo> VersionModels(BotVersion v) =>
        v.ProviderId is null || v.ProviderId == State.Settings.ActiveProvider.Id ? State.Models
        : _modelsByServer.GetValueOrDefault(v.ProviderId) ?? [];

    private async Task SetVersionProvider(BotVersion v, string? id)
    {
        v.ProviderId = string.IsNullOrEmpty(id) ? null : id;
        v.Model = null; // models differ between servers
        await LoadVersionModelsAsync(v);
    }

    private async Task LoadVersionModelsAsync(BotVersion v)
    {
        if (v.ProviderId is not { } id || _modelsByServer.ContainsKey(id)
            || State.Settings.Providers.FirstOrDefault(p => p.Id == id) is not { } p) return;
        try { _modelsByServer[id] = await Llms.Create(p).ListModelsAsync(); }
        catch { _modelsByServer[id] = []; }
    }

    private void AddVersion() => _bot!.Versions.Add(new BotVersion { Name = _bot.Versions.Count == 0 ? "strong" : $"v{_bot.Versions.Count + 1}" });

    private void ToggleTool(string name, bool on)
    {
        _bot!.AllowedTools.Remove(name);
        if (on) _bot.AllowedTools.Add(name);
    }

    private string? _avatarError;

    /// <summary>
    /// A picture for the avatar. Stills are shrunk in the browser to 256px; a GIF is kept as it is (shrinking it would
    /// stop the animation), so it has to be small already.
    /// </summary>
    private async Task OnAvatarPicked(InputFileChangeEventArgs e)
    {
        _avatarError = null;
        var file = e.File;
        try
        {
            if (file.ContentType == "image/gif")
            {
                const long maxGif = 1_500_000;
                if (file.Size > maxGif) { _avatarError = "That GIF is over 1.5 MB. Pick a smaller one (avatars show at 52px at most)."; return; }
                _bot!.AvatarImage = "data:image/gif;base64," + Convert.ToBase64String(await ReadAll(file, maxGif));
                return;
            }
            if (!file.ContentType.StartsWith("image/")) { _avatarError = "That isn't a picture."; return; }
            var small = await file.RequestImageFileAsync("image/png", 256, 256);
            _bot!.AvatarImage = "data:image/png;base64," + Convert.ToBase64String(await ReadAll(small, 2_000_000));
        }
        catch (Exception ex) { _avatarError = "Couldn't read that picture: " + ex.Message; }
    }

    private static async Task<byte[]> ReadAll(IBrowserFile file, long max)
    {
        using var ms = new MemoryStream();
        await using var s = file.OpenReadStream(max);
        await s.CopyToAsync(ms);
        return ms.ToArray();
    }

    private async Task Save()
    {
        _error = null;
        if (_bot is null) return;
        if (string.IsNullOrWhiteSpace(_bot.Name)) { _error = "Give the bot a name."; return; }
        _bot.Name = _bot.Name.Trim().TrimStart('@');
        if (State.Bots.Any(b => b.Id != _bot.Id && b.Name.Equals(_bot.Name, StringComparison.OrdinalIgnoreCase)))
        { _error = "Another bot already has that name (names are used for @mentions)."; return; }
        if (string.IsNullOrWhiteSpace(_bot.Model)) _bot.Model = null;
        foreach (var v in _bot.Versions)
        {
            v.Name = (v.Name ?? "").Trim();
            v.Note = (v.Note ?? "").Trim();
            if (string.IsNullOrWhiteSpace(v.Model)) v.Model = null;
        }
        if (_bot.Versions.Any(v => v.Name.Length == 0)) { _error = "Give each version a name."; return; }
        if (_bot.Versions.GroupBy(v => v.Name, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1)) { _error = "Two versions have the same name."; return; }
        _bot.Abilities.ProjectFolder = string.IsNullOrWhiteSpace(_bot.Abilities.ProjectFolder) ? null : _bot.Abilities.ProjectFolder.Trim();
        try
        {
            await Store.SaveAsync(_bot);
            if (_isNew) { Nav.NavigateTo($"bots/{_bot.Id}"); return; }
            _saved = true;
            StateHasChanged();
            await Task.Delay(1800);
            _saved = false;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private readonly Dictionary<string, TriggerState> _states = [];
    private readonly Dictionary<string, string> _runResult = [];

    private string WebhookUrl(Routine r)
    {
        var baseUrl = Platform.WebhookBaseUrl is { Length: > 0 } b ? b : Nav.BaseUri;
        return $"{baseUrl.TrimEnd('/')}/hooks/{r.Id}?token={r.WebhookSecret}";
    }

    private async Task Copy(string text) => await JS.InvokeVoidAsync("hearth.copy", text);

    private static string PromptHint(Routine r) => r.Trigger switch
    {
        TriggerKind.Webhook => "What to do with the webhook body, e.g. /triage — or: Summarize this GitHub event and tell me if it needs action.",
        TriggerKind.Folder => "What to do with each file, e.g. Extract vendor, total and due date from this invoice and add it to my notes.",
        TriggerKind.Feed => "What to do with new items, e.g. Tell me which of these releases matter for my setup and why.",
        TriggerKind.PageChange => "What to do when it changes, e.g. Tell me what changed and whether the price went down.",
        TriggerKind.Sheet => "What to do with new rows, e.g. For each new lead, research the company and write a summary into column F.",
        TriggerKind.Email => "What to do with new email, e.g. Triage it; if it needs a reply, draft one in my style and tell me.",
        TriggerKind.Calendar => "What to do before a meeting, e.g. Research the attendees and their companies and give me a 5-bullet brief.",
        _ => "What to do, e.g. /daily-briefing — or: Search for news about local LLMs from the last day and summarize the top 5.",
    };

    private async Task RunNow(Routine routine)
    {
        await Save();
        if (_error is not null) return;
        _runningRoutine = routine.Id;
        _runResult.Remove(routine.Id);
        try
        {
            string result;
            if (routine.Trigger is TriggerKind.Feed or TriggerKind.PageChange or TriggerKind.Sheet or TriggerKind.Email or TriggerKind.Calendar)
            {
                result = await Routines.PollAsync(_bot!, routine, force: true);
                _states[routine.Id] = await TriggerStates.GetAsync(routine.Id);
                _runResult[routine.Id] = result;
                return;
            }
            var payload = routine.Trigger switch
            {
                TriggerKind.Webhook => "(Test run from the bot editor — no webhook body.)",
                TriggerKind.Folder => "(Test run from the bot editor — no file event.)",
                _ => null,
            };
            result = await Routines.RunAsync(_bot!, routine, payload, CancellationToken.None);
            if (result != "Done.") _error = $"Routine: {result}";
            else Nav.NavigateTo($"bot/{_bot!.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _runningRoutine = null; }
    }

    private bool _busy;
    private bool _googleConnected, _microsoftConnected;
    private string _newMemory = "";
    private string _memoryFilter = "";
    private string? _editingMemory;
    private string _editMemoryText = "";

    private sealed record Ability(string Icon, string Name, string Description, Func<bool> Get, Action<bool> Set,
        string? Hint = null, string HintLink = "computer");

    private IEnumerable<Ability> AbilityList()
    {
        var a = _bot!.Abilities;
        var s = State.Settings;
        yield return new("search", "Web search", "Search the web and read pages",
            () => a.WebSearch, v => a.WebSearch = v, string.IsNullOrWhiteSpace(s.SearxngUrl) ? "Search needs a SearXNG URL (reading pages works)" : null, "settings");
        yield return new("globe", "Browser", "Use a real browser: sign in, click, fill forms",
            () => a.Browser, v => a.Browser = v, !Computer.Status.Available ? "Not available here" : !s.Computer.Enabled ? "Turned off on the Computer page" : null);
        yield return new("mouse-pointer-click", "Computer use", "See your screen and use mouse & keyboard",
            () => a.ComputerUse, v => a.ComputerUse = v, a.Desktop == DesktopTarget.ThisComputer && !s.Computer.DesktopControl ? "Switch on Computer use on the Computer page, or give it its own sandbox below" : null);
        yield return new("folder", "Files", "Read and write files in the workspace", () => a.Files, v => a.Files = v);
        yield return new("code", "Code", "Run Python and shell commands, and work in project folders (asks first)",
            () => a.Code, v => a.Code = v, !s.Tools.PythonEnabled && !s.Computer.AllowCommands ? "Allow Python or commands under Tools / Computer" : null, "tools");
        yield return new("image", "Images", "Generate pictures",
            () => a.Images, v => a.Images = v, s.ImageGen.Backend == ImageBackend.None ? "Pick an image server in Settings" : null, "settings");
        yield return new("file-text", "Documents", "Search your document library", () => a.Documents, v => a.Documents = v);
        yield return new("zap", "Skills", "Use your saved skills", () => a.Skills, v => a.Skills = v);
        yield return new("users", "Teamwork", "Message other bots and hand off work", () => a.MessageBots, v => a.MessageBots = v);
        yield return new("sheet", "Google Sheets", "Find, read and update spreadsheets", () => a.GoogleSheets, v => a.GoogleSheets = v,
            _googleConnected ? null : "Connect Google on the Connections page", "connections");
        yield return new("mail", "Gmail", "Search, read, draft and send your email", () => a.Gmail, v => a.Gmail = v,
            !_googleConnected ? "Connect Google on the Connections page" : !s.Google.GmailEnabled ? "Turn on Gmail on the Connections page" : null, "connections");
        yield return new("calendar", "Calendar", "Check your schedule and add events", () => a.Calendar, v => a.Calendar = v,
            !_googleConnected ? "Connect Google on the Connections page" : !s.Google.CalendarEnabled ? "Turn on Calendar on the Connections page" : null, "connections");
        yield return new("file-text", "Google Docs & Drive", "Find, read and write Google Docs and Drive files", () => a.GoogleDocs, v => a.GoogleDocs = v,
            !_googleConnected ? "Connect Google on the Connections page" : !s.Google.DocsEnabled ? "Turn on Docs & Drive on the Connections page" : null, "connections");
        yield return new("users", "Contacts", "Look up people's emails and phone numbers", () => a.Contacts, v => a.Contacts = v,
            !_googleConnected && !_microsoftConnected ? "Connect Google or Microsoft on the Connections page" : null, "connections");
        yield return new("folder", "Microsoft 365", "Outlook mail and calendar, OneDrive, Word, Excel and To Do", () => a.Microsoft365, v => a.Microsoft365 = v,
            _microsoftConnected ? null : "Connect Microsoft on the Connections page", "connections");
        yield return new("plug", "MCP tools", "Tools from your MCP servers", () => a.Mcp, v => a.Mcp = v,
            s.McpServers.Count == 0 ? "No MCP servers added yet" : null, "tools");
    }

    private async Task SignInBrowser()
    {
        await Save();
        if (_error is not null) return;
        _busy = true;
        try { await Computer.StartAsync(headless: false, _bot!.BrowserProfileKey); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ResetBrowser()
    {
        _busy = true;
        try { await Computer.ResetProfileAsync(_bot!.Id); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task AddMemory()
    {
        if (string.IsNullOrWhiteSpace(_newMemory) || _bot is null) return;
        await Memories.AddAsync(_newMemory, _bot.Id);
        _newMemory = "";
        _memories = await Memories.ListAsync(_bot.Id);
    }

    private async Task AddMemoryKey(KeyboardEventArgs e) { if (e.Key == "Enter") await AddMemory(); }

    private async Task EditMemoryKey(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter") await SaveMemory(id);
        if (e.Key == "Escape") _editingMemory = null;
    }

    private async Task SaveMemory(string id)
    {
        _editingMemory = null;
        await Memories.UpdateAsync(id, _editMemoryText, _bot!.Id);
        _memories = await Memories.ListAsync(_bot.Id);
    }

    private async Task ClearMemory()
    {
        await Memories.ClearAsync(_bot!.Id);
        _memories = [];
    }

    private async Task DeleteMemory(string id)
    {
        await Memories.DeleteAsync(id, _bot!.Id);
        _memories = await Memories.ListAsync(_bot.Id);
    }

    private async Task Delete()
    {
        await Store.DeleteAsync(_bot!.Id);
        try { if (await Sandboxes.ProblemAsync() is null) await Sandboxes.ResetAsync(_bot.Id); } catch { /* best effort */ }
        Nav.NavigateTo("bots");
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }
}
