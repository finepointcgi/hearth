@page "/agents"
@inherits StatefulComponent
@implements IAsyncDisposable
@using Hearth.Core.Services.Agents
@inject AgentHub Hub
@inject AgentCare Care
@inject PlatformInfo Platform
@inject SettingsStore SettingsStore
@inject LinkedFolders Folders
@inject NavigationManager Nav

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Agents</h2>
    <span class="spacer"></span>
    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Refresh" Disabled="@_loading">@(_loading ? "Looking…" : "Look again")</MudButton>
</header>

<div class="settings agents-page">
    <MudPaper Class="card" Elevation="0">
        <p>Other AI agents on this computer, like Hermes and Claude Code. Give them a job here, or let your bots hand work to them.
            They work in a folder you pick, every step shows up live, and anything they want to do that their setting doesn't
            allow comes to you to approve, here or on your phone.</p>
        @if (!Hub.Available)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@(Platform.CanRunProcesses ? "This account isn't allowed to use this computer, and other agents would act with its logins and files. The owner can allow it in Settings → Accounts." : "Agents run as programs on this computer, so they work in the desktop app or the web host with local access.")</MudAlert>
        }
    </MudPaper>

    @if (Platform.CanRunProcesses && !Platform.CanUseComputer)
    {
        @* This account may not use this computer: nothing here would work for it. *@
    }
    else if (_agents is null)
    {
        <p class="muted">Looking for agents…</p>
    }
    else
    {
        var installed = AgentsOn(_computer);
        @if (_agents.Any(a => a.Installed) || _nodes.Values.Any(n => n.Any(a => a.Installed)))
        {
            <MudPaper Class="card" Elevation="0">
                <h3><span aria-hidden="true">🚀</span> Give an agent a job</h3>
                <div class="row">
                    @if (_hosts.Count > 0)
                    {
                        <MudSelect Label="On" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(_computer)" ValueChanged="Ev.Change<string>(PickComputer)" T="string">
                                <MudSelectItem Value="@("")">this computer</MudSelectItem>
                                @foreach (var h in _hosts) { <MudSelectItem Value="@(h.Id)">@h.Name</MudSelectItem> }
                            </MudSelect>
                    }
                    <MudSelect Label="Agent" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(_agentId)" ValueChanged="Ev.Change<string>(PickAgent)" T="string">
                            @foreach (var a in installed) { <MudSelectItem Value="@(a.Def.Id)">@a.Def.Icon @a.Def.Name</MudSelectItem> }
                        </MudSelect>
                    @if (_jobProfiles.Count > 1)
                    {
                        <MudSelect Label="Profile" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_jobProfile">
                                @foreach (var p in _jobProfiles) { <MudSelectItem Value="@(p.Name)">@p.Name</MudSelectItem> }
                            </MudSelect>
                    }
                    <label class="grow">Folder
                        <input @bind="_folder" list="agent-folders" placeholder="@(_computer == "" ? "~/projects/my-app" : "full path there, e.g. ~/projects/my-app")" />
                        <datalist id="agent-folders">
                            @foreach (var f in FolderChoices()) { <option value="@f"></option> }
                        </datalist>
                    </label>
                </div>
                @if (installed.Count == 0)
                {
                    <p class="muted small">@(_computer == "" ? "No agents are installed on this computer." : _nodeErrors.TryGetValue(_computer, out var why) ? why : _nodes.ContainsKey(_computer) ? "No agents found on that computer." : "Checking that computer…")</p>
                }
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" @bind-Value="_task" Placeholder="What should it do? e.g. Find why the login test fails and fix it, then run the tests." />
                <div class="row end">
                    @if (_startError is not null) { <span class="error-text small grow">@_startError</span> }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Start" Disabled="@(_starting || string.IsNullOrWhiteSpace(_task) || string.IsNullOrWhiteSpace(_folder))">@(_starting ? "Starting…" : "Start")</MudButton>
                </div>
            </MudPaper>
        }

        @foreach (var a in _agents)
        {
            var agent = a;
            var s = _settings.Agents.ByAgent.TryGetValue(agent.Def.Id, out var cfg) ? cfg : null;
            <MudPaper Class="@($"card agent-card {(agent.Installed ? "" : "not-installed")}")" Elevation="0">
                <div class="row">
                    <span class="agent-icon" aria-hidden="true">@agent.Def.Icon</span>
                    <span class="grow"><b>@agent.Def.Name</b>
                        <span class="muted small">@(agent.Installed ? agent.Version ?? "installed" : "not installed")</span>
                        <br /><span class="muted small">@agent.Def.About</span></span>
                    @if (agent.Installed)
                    {
                        @if (agent.Def.StatusArgs is not null) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Status(agent)" Disabled="@(_busy == agent.Def.Id)">Status</MudButton> }
                        @if (agent.Def.UpdateArgs is not null) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Update(agent)" Disabled="@(_busy == agent.Def.Id)">@(_busy == agent.Def.Id && _busyWhat == "update" ? "Updating…" : "Update")</MudButton> }
                    }
                    else if (agent.Def.InstallUrl is not null)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="@agent.Def.InstallUrl" target="_blank" rel="noopener">How to install</MudButton>
                    }
                </div>
                @if (agent.Installed)
                {
                    var c = Cfg(agent.Def.Id);
                    <div class="row agent-settings">
                        <MudSwitch T="bool" Color="Color.Primary" Value="@(c.Enabled)" ValueChanged="(bool v) => Set(agent.Def.Id, x => x.Enabled = v)" Class="check" Label="Bots can hand work to it" />
                        <MudSelect Label="Without asking, it may" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(c.Mode.ToString())" ValueChanged="Ev.Change<string>(e => Set(agent.Def.Id, x => x.Mode = Enum.Parse<AgentMode>(e.Value!.ToString()!)))" T="string">
                                <MudSelectItem Value="@(AgentMode.Ask)">only look around</MudSelectItem>
                                <MudSelectItem Value="@(AgentMode.AcceptEdits)">change files in the folder</MudSelectItem>
                                <MudSelectItem Value="@(AgentMode.FullAuto)">do anything (no asking)</MudSelectItem>
                                <MudSelectItem Value="@(AgentMode.ReadOnly)">nothing but look (refuse the rest)</MudSelectItem>
                            </MudSelect>
                        <label>Stop after
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Value="@(c.MaxMinutes)" Style="width:5rem" ValueChanged="(int v) => Set(agent.Def.Id, x => x.MaxMinutes = Math.Clamp(v, 1, 600))" /> min
                        </label>
                    </div>
                    @if (c.Mode == AgentMode.FullAuto) { <p class="warn-text small">It won't ask before running commands or changing files. Use it only on folders you can restore.</p> }
                    @if (agent.Def.SetupHint is not null) { <p class="muted small">Setup: @agent.Def.SetupHint</p> }

                    <AgentMemoryPanel Def="agent.Def" />
                }
                @if (_output.TryGetValue(agent.Def.Id, out var output))
                {
                    <pre class="agent-output small">@output</pre>
                }
            </MudPaper>
        }

        <MudPaper Class="card" Elevation="0">
            <h3><span aria-hidden="true">🖥️</span> Other computers</h3>
            <p class="muted small">Run agents on your other machines too (a server, a work laptop, a Mac mini). Hearth connects with your SSH
                keys, runs the agent there, and shows its steps and approvals here as if it were local.</p>
            @foreach (var h in _hosts)
            {
                var host = h;
                <div class="node-row">
                    <div class="row">
                        <span class="grow"><b>@host.Name</b> <span class="muted small">@host.Target@(string.IsNullOrWhiteSpace(host.Notes) ? "" : $" · {host.Notes}")</span></span>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => CheckNode(host, true)" Disabled="@_checking.Contains(host.Id)">@(_checking.Contains(host.Id) ? "Checking…" : "Check")</MudButton>
                    </div>
                    @if (_nodeErrors.TryGetValue(host.Id, out var err)) { <p class="error-text small">@err</p> }
                    else if (_nodes.TryGetValue(host.Id, out var there))
                    {
                        var has = there.Where(a => a.Installed).ToList();
                        @if (has.Count == 0) { <p class="muted small">No agents found there.</p> }
                        @foreach (var a in has)
                        {
                            var agent = a;
                            <div class="node-agent">
                                <div class="row">
                                    <span class="grow small">@agent.Def.Icon <b>@agent.Def.Name</b> <span class="muted">@(agent.Version ?? "")</span></span>
                                    @if (agent.Def.StatusArgs is not null) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => NodeCommand(host, agent, agent.Def.StatusArgs, false)" Disabled="@(_busy == host.Id)">Status</MudButton> }
                                    @if (agent.Def.UpdateArgs is not null) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => NodeCommand(host, agent, agent.Def.UpdateArgs, true)" Disabled="@(_busy == host.Id)">Update</MudButton> }
                                </div>
                                <AgentMemoryPanel Def="agent.Def" Host="host" />
                            </div>
                        }
                    }
                    else { <p class="muted small">Checking…</p> }
                    @if (_output.TryGetValue(host.Id, out var nodeOut)) { <pre class="agent-output small">@nodeOut</pre> }
                </div>
            }
            <p class="muted small">The settings above (what each agent may do without asking, time limit) apply on every computer.</p>
        </MudPaper>
        <details class="card advanced">
            <summary><b>Add a computer</b></summary>
            <RemoteHostsCard Changed="HostsChanged" />
        </details>

        <MudPaper Class="card" Elevation="0">
            <h3><span aria-hidden="true">🗂️</span> Recent jobs</h3>
            @if (_runs.Count == 0) { <p class="muted small">Nothing yet. Jobs show up here, whether you started them or a bot did.</p> }
            @foreach (var r in _runs)
            {
                var run = r;
                <a class="agent-run-row" href="agents/run/@run.Id">
                    <span aria-hidden="true">@StatusMark(run)</span>
                    <span class="grow"><b>@run.AgentName</b> @Clip(run.Task, 120)
                        <br /><span class="muted small">@(run.NodeName is { } n ? $"{n}: " : "")@System.IO.Path.GetFileName(run.Folder.TrimEnd('/')) · @run.Started.LocalDateTime.ToString("MMM d, h:mm tt")@(run.BotId is { } b && State.BotById(b) is { } bot ? $" · from {bot.Name}" : "")</span></span>
                </a>
            }
        </MudPaper>
    }
</div>

@code {
    private IReadOnlyList<AgentStatus>? _agents;
    private List<AgentRun> _runs = [];
    private AppSettings _settings = new();
    private List<string> _folderChoices = [];
    private string _agentId = "", _folder = "", _task = "", _computer = "";
    private List<Hearth.Core.Tools.RemoteHost> _hosts = [];
    private readonly Dictionary<string, IReadOnlyList<AgentStatus>> _nodes = [];
    private readonly Dictionary<string, string> _nodeErrors = [];
    private readonly HashSet<string> _checking = [];
    private IReadOnlyList<AgentProfile> _jobProfiles = [];
    private string _jobProfile = AgentProfile.Default;

    private async Task PickAgent(ChangeEventArgs e)
    {
        _agentId = e.Value?.ToString() ?? "";
        await LoadJobProfiles();
    }

    /// <summary>The chosen agent's profiles on the chosen computer (for the job form).</summary>
    private async Task LoadJobProfiles()
    {
        _jobProfile = AgentProfile.Default;
        _jobProfiles = [];
        if (AgentCatalog.Find(_agentId) is not { HasProfiles: true } def) return;
        try { _jobProfiles = await Hub.ProfilesAsync(new AgentPlace(def, _hosts.FirstOrDefault(h => h.Id == _computer))); }
        catch { /* the default profile still works */ }
    }
    private string? _startError, _busy, _busyWhat;
    private bool _starting, _loading;
    private readonly Dictionary<string, string> _output = [];

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    protected override async Task OnInitializedAsync()
    {
        Hub.Changed += OnRunChanged;
        _settings = await SettingsStore.GetAsync();
        _folderChoices = (await Folders.ListAsync()).Where(f => f.Enabled).Select(f => f.Path).ToList();
        _agents = await Hub.StatusAsync();
        _agentId = _agents.FirstOrDefault(a => a.Installed)?.Def.Id ?? "";
        await LoadJobProfiles();
        _runs = await Hub.RecentAsync();
        _hosts = _settings.RemoteHosts.ToList();
        foreach (var h in _hosts)
        {
            if (Hub.KnownNodeStatus(h.Id) is { } known) _nodes[h.Id] = known;
            else _ = CheckNode(h, false);
        }
        if (_folderChoices.Count > 0 && _folder.Length == 0) _folder = _runs.FirstOrDefault()?.Folder ?? _folderChoices[0];
    }

    private List<AgentStatus> AgentsOn(string computer) =>
        (computer == "" ? _agents ?? [] : _nodes.TryGetValue(computer, out var n) ? n : []).Where(a => a.Installed).ToList();

    private IEnumerable<string> FolderChoices() => _computer == ""
        ? _folderChoices.Concat(_runs.Where(r => r.NodeId is null).Select(r => r.Folder)).Distinct()
        : _runs.Where(r => r.NodeId == _computer).Select(r => r.Folder).Distinct();

    private async Task PickComputer(ChangeEventArgs e)
    {
        _computer = e.Value?.ToString() ?? "";
        var there = AgentsOn(_computer);
        if (there.All(a => a.Def.Id != _agentId)) _agentId = there.FirstOrDefault()?.Def.Id ?? "";
        _folder = FolderChoices().FirstOrDefault() ?? "";
        await LoadJobProfiles();
    }

    private async Task CheckNode(Hearth.Core.Tools.RemoteHost host, bool refresh)
    {
        _checking.Add(host.Id);
        _nodeErrors.Remove(host.Id);
        await InvokeAsync(StateHasChanged);
        try { _nodes[host.Id] = await Hub.NodeStatusAsync(host, refresh); }
        catch (Exception ex) { _nodeErrors[host.Id] = ex.Message; }
        finally
        {
            _checking.Remove(host.Id);
            if (_computer == host.Id && AgentsOn(_computer).All(a => a.Def.Id != _agentId)) _agentId = AgentsOn(_computer).FirstOrDefault()?.Def.Id ?? "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task NodeCommand(Hearth.Core.Tools.RemoteHost host, AgentStatus agent, string[] args, bool update)
    {
        _busy = host.Id;
        _output[host.Id] = update ? $"Updating {agent.Def.Name} on {host.Name}… this can take a few minutes." : "…";
        try
        {
            var (exit, output) = await Hub.NodeCommandAsync(host, agent, args, update ? TimeSpan.FromMinutes(10) : TimeSpan.FromMinutes(1));
            _output[host.Id] = (exit == 0 ? "" : "⚠ ") + output;
            if (update) await CheckNode(host, true);
        }
        catch (Exception ex) { _output[host.Id] = ex.Message; }
        finally { _busy = null; }
    }

    private async Task HostsChanged()
    {
        _settings = await SettingsStore.GetAsync();
        _hosts = _settings.RemoteHosts.ToList();
        foreach (var h in _hosts.Where(h => !_nodes.ContainsKey(h.Id) && !_checking.Contains(h.Id))) _ = CheckNode(h, true);
        if (_computer != "" && _hosts.All(h => h.Id != _computer)) _computer = "";
    }

    private void OnRunChanged(AgentRun run) => InvokeAsync(async () =>
    {
        var i = _runs.FindIndex(r => r.Id == run.Id);
        if (i >= 0) _runs[i] = run; else _runs = await Hub.RecentAsync();
        StateHasChanged();
    });

    private async Task Refresh()
    {
        _loading = true;
        try { _agents = await Hub.StatusAsync(refresh: true); }
        finally { _loading = false; }
    }

    private AgentSettings Cfg(string id) => _settings.Agents.ByAgent.TryGetValue(id, out var s) ? s : new AgentSettings();

    private async Task Set(string id, Action<AgentSettings> change)
    {
        _settings = await SettingsStore.GetAsync();
        var s = _settings.Agents.ByAgent.TryGetValue(id, out var x) ? x : _settings.Agents.ByAgent[id] = new();
        change(s);
        await SettingsStore.SaveAsync(_settings);
    }

    private async Task Start()
    {
        _starting = true; _startError = null;
        try
        {
            var run = await Hub.StartAsync(_agentId, _task, _folder, computer: _computer == "" ? null : _computer, profile: _jobProfile);
            _task = "";
            Nav.NavigateTo($"agents/run/{run.Id}");
        }
        catch (Exception ex) { _startError = ex.Message; }
        finally { _starting = false; }
    }

    private async Task Status(AgentStatus a)
    {
        _busy = a.Def.Id; _busyWhat = "status";
        try { _output[a.Def.Id] = (await AgentCare.StatusAsync(a)).output; }
        catch (Exception ex) { _output[a.Def.Id] = ex.Message; }
        finally { _busy = null; }
    }

    private async Task Update(AgentStatus a)
    {
        _busy = a.Def.Id; _busyWhat = "update";
        _output[a.Def.Id] = $"Updating {a.Def.Name}… this can take a few minutes.";
        try
        {
            var (exit, output) = await AgentCare.UpdateAsync(a);
            _output[a.Def.Id] = (exit == 0 ? "✅ " : "⚠ ") + output;
            _agents = await Hub.StatusAsync(refresh: true);
        }
        catch (Exception ex) { _output[a.Def.Id] = ex.Message; }
        finally { _busy = null; }
    }


    public static string StatusMark(AgentRun r) => r.Status switch
    {
        AgentRunStatus.Running => "⏳", AgentRunStatus.WaitingForYou => "🔐", AgentRunStatus.Done => "✅",
        AgentRunStatus.Cancelled => "⏹", _ => "❌",
    };

    private static string Clip(string s, int n) => s.Length <= n ? s : s[..n].TrimEnd() + "…";

    public ValueTask DisposeAsync()
    {
        Hub.Changed -= OnRunChanged;
        base.Dispose();
        return ValueTask.CompletedTask;
    }
}
