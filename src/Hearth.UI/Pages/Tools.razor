@page "/tools"
@inherits StatefulComponent
@inject SettingsStore Store
@inject BuiltInToolProvider BuiltIns
@inject McpManager Mcp
@inject PlatformInfo Platform
@inject CodeSandbox Sandbox

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Tools</h2>
    <span class="spacer"></span>
    @if (_saved) { <span class="ok-text">Saved ✓</span> }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
</header>

@if (_s is not null)
{
<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <h3>Tool calling</h3>
        <p class="muted">Models that support tool calling (qwen3, llama3.1+, mistral-small, gpt-oss…) can use these. Small models may call tools poorly.</p>
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.Tools.EnabledByDefault" Class="check" Label="Tools on by default in new chats" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.Tools.AutoApproveAll" Class="check" Label="Don't ask before running tools that can change things or run code" />
        <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Tools.MaxRounds" Style="width:6rem" Label="Max tool rounds per reply" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.Tools.PickToolsPerMessage" Class="check">Offer each reply only the tools it's likely to need <span class="muted small">(email, calendar, documents… when the chat is about them; bots can load the rest). Much faster on local models.</span></MudSwitch>
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Built-in tools</h3>
        @foreach (var (tool, reason) in _catalog)
        {
            var t = tool;
            <div class="tool-row @(reason is null ? "" : "unavailable")">
                <MudSwitch T="bool" Color="Color.Primary" Value="@(!_s.Tools.DisabledTools.Contains(t.Name))" ValueChanged="(bool v) => Toggle(t.Name, v)" Class="check grow"><span class="tool-icon">@t.Icon</span> <b>@t.DisplayName</b>
                    @if (t.RequiresApproval && !(t.Name is "run_python" or "run_command" && Sandbox.Active(_s))) { <span class="badge">asks first</span> }
                    else if (t.Name is "run_python" or "run_command") { <span class="badge">sandbox</span> }</MudSwitch>
                <span class="muted small">@(reason ?? "Ready")</span>
            </div>
        }
        @if (Platform.CanUseComputer)
        {
            <div class="sub">
                <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.Tools.PythonEnabled" Class="check" Label="Allow the Python tool" />
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Python path (optional, auto-detected; only used without the sandbox)" @bind-Value="_s.Tools.PythonPath" />
            </div>
            <div class="sub">
                <h4>Code sandbox</h4>
                <p class="muted small">Python, workspace commands and project commands run in a Docker container instead of on this computer, so they don't ask first. The container has no extra privileges, limited memory, and sees only Hearth's workspace (or the one project folder it's working in). Without the sandbox, code runs on this computer and asks every time.</p>
                <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.Tools.Sandbox.Enabled" Class="check" Label="Run code in the sandbox" />
                <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.Tools.Sandbox.Network" Class="check" Label="Internet access in the sandbox (for installing packages)" />
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Tools.Sandbox.Image" Placeholder="python:3.12-slim" Label="Image" />
                <p class="muted small">
                    @if (Sandbox.DockerPath is null) { <span>Docker isn't installed, so code runs on this computer (asking first). Install Docker Desktop to use the sandbox.</span> }
                    else if (_sandboxProblem is not null) { <span class="tiny-error">@_sandboxProblem</span> }
                    else { <span>Docker is ready.</span> }
                </p>
            </div>
            <div class="sub">
                <h4>Helper agents</h4>
                <p class="muted small">Bots can split a job into parts and hand them to temporary helpers that work at the same time (each helper is a model call running in parallel, so local servers may slow down with many).</p>
                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Tools.MaxHelpers" Style="width:5rem" Label="Helpers at once (0 = off)" />
            </div>
        }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Add an integration</h3>
        <p class="muted small">Popular MCP servers, set up for you. Versions are pinned; secrets you enter are encrypted on this computer.</p>
        <div class="catalog-grid">
            @foreach (var item in McpCatalog.All)
            {
                var it = item;
                var added = _s?.McpServers.Any(m => m.Name == it.Id) == true;
                var missing = it.Needs is { } need && !OnPath(need == "node" ? "npx" : "uvx");
                <button class="catalog-item @(_adding == it ? "on" : "")" disabled="@(added || (missing && it.Transport == McpTransport.Stdio) || (it.Transport == McpTransport.Stdio && !Platform.CanUseComputer))"
                        @onclick="() => StartAdd(it)" title="@(added ? "Already added" : missing ? $"Needs {(it.Needs == "node" ? "Node.js" : "uv")} installed" : it.Description)">
                    <span class="needs-icon"><Icon Name="@it.Icon" Size="17" /></span>
                    <span class="grow-text"><b>@it.Name</b><small>@(added ? "Added" : missing ? $"Needs {(it.Needs == "node" ? "Node.js" : "uv")}" : it.Description)</small></span>
                </button>
            }
        </div>
        @if (_adding is { } adding)
        {
            <div class="catalog-form">
                <b>@adding.Name</b> <a class="small" href="@adding.Docs" target="_blank" rel="noopener">About</a>
                @foreach (var f in adding.Fields)
                {
                    var field = f;
                    <label>@field.Label
                        <input type="@(field.Secret ? "password" : "text")" placeholder="@field.Placeholder" autocomplete="off"
                               value="@_values.GetValueOrDefault(field.Label)" @onchange="e => _values[field.Label] = e.Value?.ToString() ?? string.Empty" />
                        @if (field.Help is not null) { <span class="muted small">@field.Help</span> }
                    </label>
                }
                @if (adding.Fields.Count == 0) { <span class="muted small">Nothing to fill in.</span> }
                <div class="row end">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _adding = null">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!adding.IsComplete(_values))" OnClick="AddFromCatalog">Add @adding.Name</MudButton>
                </div>
            </div>
        }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>MCP servers</h3>
        <p class="muted">
            Plug in any <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener">Model Context Protocol</a> server (files, GitHub, databases, Home Assistant…).
            @if (!Platform.CanUseComputer) { <b>@(Platform.CanRunProcesses ? "This account can only use HTTP MCP servers." : "This platform can only use HTTP MCP servers.")</b> }
        </p>

        @foreach (var srv in _s.McpServers)
        {
            var server = srv;
            var status = _status.FirstOrDefault(x => x.Id == server.Id);
            <div class="provider">
                <div class="row">
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="server.Enabled" Class="check" Label="On" />
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="server.Name" Placeholder="Name" />
                    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="server.Transport">
                        <MudSelectItem Value="@(McpTransport.Stdio)">Local command (stdio)</MudSelectItem>
                        <MudSelectItem Value="@(McpTransport.Http)">HTTP</MudSelectItem>
                    </MudSelect>
                    <MudIconButton Size="Size.Small" title="Remove" aria-label="Remove" OnClick="() => _s.McpServers.Remove(server)"><Icon Name="trash-2" Size="15" /></MudIconButton>
                </div>
                @if (server.Transport == McpTransport.Stdio)
                {
                    <div class="row">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="server.Command" Placeholder="Command, e.g. npx" />
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="server.Arguments" Placeholder="Arguments, e.g. -y @@modelcontextprotocol/server-filesystem ~/Documents" />
                    </div>
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Placeholder="Environment, one KEY=value per line" Value="@(Pairs(server.Environment))" ValueChanged="(string v) => server.Environment = ParsePairs(v, '=')" T="string" />
                }
                else
                {
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="server.Url" Placeholder="https://host/mcp" />
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Placeholder="Headers, one Name: value per line (e.g. Authorization: Bearer …)" Value="@(McpHeaderMask.Show(server.Headers))" ValueChanged="(string v) => server.Headers = McpHeaderMask.Parse(v, server.Headers)" T="string" HelperText="Values are hidden; type a new value to replace one." />
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="server.OAuthClientId" Placeholder="Sign-in client id (only for servers that sign you in, e.g. keel-mcp)" />
                }
                <div class="row">
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="server.AutoApprove" Class="check grow" Label="Run this server's tools without asking" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => Connect(server)">Save & connect</MudButton>
                </div>
                @if (status is not null)
                {
                    @if (status.Error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@status.Error</MudAlert>
                    }
                    else if (status.Connected)
                    {
                        <div class="ok-text">Connected ✓ @status.ToolCount tool(s): @string.Join(", ", status.ToolNames.Take(12))@(status.ToolCount > 12 ? "…" : "")</div>
                    }
                }
            </div>
        }
        <div class="row">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddServer"><Icon Name="plus" Size="16" /> Add a server by hand</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _showImport = !_showImport">Import JSON…</MudButton>
        </div>
        @if (_showImport)
        {
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="7" @bind-Value="_importJson" Placeholder='Paste a Claude Desktop / Cursor style config: { "mcpServers": { "files": { "command": "npx", "args": ["-y", "@@modelcontextprotocol/server-filesystem", "/Users/me"] } } }' />
            <div class="row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Import">Import</MudButton>
                @if (_importError is not null) { <span class="tiny-error">@_importError</span> }
            </div>
        }
    </MudPaper>
</div>
}

@code {
    private AppSettings? _s;
    private bool _saved;
    private bool _showImport;
    private string _importJson = "";
    private string? _importError;
    private IReadOnlyList<(ITool tool, string? reason)> _catalog = [];
    private IReadOnlyList<McpServerStatus> _status = [];

    protected override async Task OnInitializedAsync()
    {
        _s = SettingsCopy.Of(await Store.GetAsync());
        _catalog = await BuiltIns.CatalogAsync(_s);
        _status = Mcp.Status(_s);
        _sandboxProblem = await Sandbox.ProblemAsync();
    }

    private string? _sandboxProblem;

    private void Toggle(string name, bool on)
    {
        _s!.Tools.DisabledTools.Remove(name);
        if (!on) _s.Tools.DisabledTools.Add(name);
    }

    private McpCatalogItem? _adding;
    private Dictionary<string, string> _values = [];

    private void StartAdd(McpCatalogItem item) { _adding = item; _values = []; }

    private async Task AddFromCatalog()
    {
        if (_adding is null || _s is null) return;
        _s.McpServers.Add(_adding.Build(_values));
        _adding = null;
        _values = [];
        await Save();
    }

    private static bool OnPath(string exe) =>
        (Environment.GetEnvironmentVariable("PATH") ?? "").Split(Path.PathSeparator)
            .Concat([Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local", "bin"), "/opt/homebrew/bin", "/usr/local/bin"])
            .Any(d => File.Exists(Path.Combine(d, exe)) || File.Exists(Path.Combine(d, exe + ".cmd")) || File.Exists(Path.Combine(d, exe + ".exe")));

    private void AddServer() => _s!.McpServers.Add(new McpServerConfig { Name = $"server{_s.McpServers.Count + 1}", Transport = Platform.CanUseComputer ? McpTransport.Stdio : McpTransport.Http });

    private void Import()
    {
        _importError = null;
        try
        {
            var servers = McpManager.ParseConfig(_importJson);
            _s!.McpServers.AddRange(servers);
            _importJson = "";
            _showImport = false;
        }
        catch (Exception ex) { _importError = ex.Message; }
    }

    private async Task Connect(McpServerConfig server)
    {
        await Save();
        var st = await Mcp.ReconnectAsync(server, CancellationToken.None);
        _status = Mcp.Status(_s!).Select(x => x.Id == st.Id ? st : x).ToList();
    }

    private async Task Save()
    {
        if (_s is null) return;
        await Store.SaveAsync(SettingsCopy.Of(_s));
        _catalog = await BuiltIns.CatalogAsync(_s);
        _saved = true;
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => { _saved = false; InvokeAsync(StateHasChanged); });
    }

    private static string Pairs(Dictionary<string, string> d, string sep = "=") => string.Join("\n", d.Select(kv => kv.Key + sep + kv.Value));

    private static Dictionary<string, string> ParsePairs(string? text, char sep) =>
        (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(l => l.Split(sep, 2))
            .Where(p => p.Length == 2 && p[0].Trim().Length > 0)
            .GroupBy(p => p[0].Trim()).ToDictionary(g => g.Key, g => g.Last()[1].Trim());

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }
}
