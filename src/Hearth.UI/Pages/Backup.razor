@page "/backup"
@inherits StatefulComponent
@inject BackupService Backups
@inject SettingsStore Settings
@inject IAppRestarter Restarter
@inject IJSRuntime JS

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Backup and restore</h2>
</header>

<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <h3>Back up now</h3>
        <p class="muted small">One file with your bots, chats, memory, skills, settings and connected accounts. It includes the key that unlocks
            your saved passwords and tokens, so keep it somewhere private. The embedding model and browser sign-ins aren't included
            (the model downloads again; sign in again after a restore).</p>
        <div class="row">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DownloadNow" Disabled="@_busy"><Icon Name="download" Size="16" /> Download a backup</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SaveCopy" Disabled="@_busy">Save a copy to the backup folder</MudButton>
        </div>
        @if (_message is not null) { <div class="@(_ok ? "ok-text" : "error-box")">@_message</div> }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Daily copies</h3>
        <label class="option-row"><span class="grow-text">Make a copy every day<small>@(_b.LastBackup is { } last ? $"Last copy {last:MMM d, h:mm tt}" : "No copy yet")</small>
                @if (_b.LastError is not null) { <small class="tiny-error">Last attempt failed: @_b.LastError</small> }</span>
            <MudSwitch T="bool" Color="Color.Primary" Class="switch" role="switch" Value="@(_b.Daily)" ValueChanged="(bool v) => Change(b => b.Daily = v)" /></label>
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_folder" @bind-Value:after="SaveFolder" Placeholder="@Backups.DefaultFolder" Label="Folder (point it at iCloud Drive, Dropbox or a NAS folder for copies off this computer)" />
        <MudSelect Label="Keep the last" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(_b.Keep.ToString())" ValueChanged="Ev.Change<string>(e => Change(b => b.Keep = int.Parse(e.Value!.ToString()!)))" T="string">
                @foreach (var n in new[] { 3, 7, 14, 30 }) { <MudSelectItem Value="@(n)">@n copies</MudSelectItem> }
            </MudSelect>
        @foreach (var f in _copies)
        {
            var file = f;
            <div class="usage-row">
                <span class="grow">@Path.GetFileName(file.FullName)<br /><span class="muted small">@file.LastWriteTime.ToString("MMM d, h:mm tt") · @(file.Length / 1024) KB</span></span>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => DownloadFile(file)"><Icon Name="download" Size="15" /></MudButton>
            </div>
        }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Restore</h3>
        @if (Backups.RestorePending)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="hearth-alert notice">A backup is ready to restore. Hearth applies it the next time it starts, after setting your current data aside
                (you'll find it in a "hearth-before-restore" folder inside the data folder).</MudAlert>
            <div class="row">
                @if (Restarter.CanRestart) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RestartNow">Restart Hearth now</MudButton> }
                else { <span class="muted small">Quit and reopen Hearth to finish.</span> }
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Cancel">Cancel restore</MudButton>
            </div>
        }
        else
        {
            <p class="muted small">Restore everything from a Hearth backup file, for example on a new computer. Your current data is kept aside, not deleted.</p>
            <label class="btn ghost file-btn"><Icon Name="upload" Size="16" /> Choose a backup file…
                <InputFile OnChange="Stage" accept=".zip,application/zip" style="display:none" /></label>
        }
    </MudPaper>
</div>

@code {
    private BackupSettings _b = new();
    private string _folder = "";
    private string? _message;
    private bool _ok, _busy;
    private List<FileInfo> _copies = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _b = (await Settings.GetAsync()).Backup;
        _folder = _b.Folder ?? "";
        var dir = string.IsNullOrWhiteSpace(_b.Folder) ? Backups.DefaultFolder : _b.Folder!;
        _copies = Directory.Exists(dir) ? new DirectoryInfo(dir).GetFiles("hearth-backup-*.zip").OrderByDescending(f => f.Name).ToList() : [];
    }

    private async Task Change(Action<BackupSettings> change)
    {
        var s = await Settings.GetAsync();
        change(s.Backup);
        await Settings.SaveAsync(s);
        await LoadAsync();
    }

    private Task SaveFolder() => Change(b => b.Folder = string.IsNullOrWhiteSpace(_folder) ? null : _folder.Trim());

    private async Task DownloadNow()
    {
        await Run(async () =>
        {
            using var ms = new MemoryStream();
            await Backups.WriteAsync(ms);
            await JS.InvokeVoidAsync("hearth.downloadImage", "data:application/zip;base64," + Convert.ToBase64String(ms.ToArray()),
                $"hearth-backup-{DateTime.Now:yyyy-MM-dd}.zip");
            return "Backup downloaded.";
        });
    }

    private Task SaveCopy() => Run(async () => $"Saved {Path.GetFileName(await Backups.BackUpToFolderAsync())}.");

    private async Task DownloadFile(FileInfo f) =>
        await JS.InvokeVoidAsync("hearth.downloadImage", "data:application/zip;base64," + Convert.ToBase64String(await File.ReadAllBytesAsync(f.FullName)), f.Name);

    private async Task Stage(InputFileChangeEventArgs e)
    {
        await Run(async () =>
        {
            await using var stream = e.File.OpenReadStream(500_000_000);
            var problem = await Backups.StageRestoreAsync(stream);
            if (problem is not null) throw new InvalidOperationException(problem);
            return "Backup checked and ready.";
        });
    }

    private void Cancel() { Backups.CancelRestore(); _message = "Restore cancelled."; _ok = true; }

    private void RestartNow()
    {
        _message = "Restarting… this page reconnects in a few seconds.";
        _ok = true;
        Restarter.Restart();
    }

    private async Task Run(Func<Task<string>> work)
    {
        _busy = true;
        try { _message = await work(); _ok = true; }
        catch (Exception ex) { _message = ex.Message; _ok = false; }
        finally { _busy = false; await LoadAsync(); }
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }
}
