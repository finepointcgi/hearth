@page "/skills"
@inherits StatefulComponent
@inject SkillStore Store
@inject SettingsStore Settings
@inject SkillPorter Porter
@inject LearningLoop Loop
@inject IJSRuntime JS

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Skills</h2>
    <span class="spacer"></span>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="New">＋ New skill</MudButton>
</header>

<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <p class="muted">
            Skills are reusable prompts shared by you and every bot. Type <code>/name</code> in any chat or routine to run one
            (anything after the name is its input), and with tools on, bots load a skill by themselves when it fits.
        </p>
    </MudPaper>

    @if (_editing is not null)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>@(_isNew ? "New skill" : "/" + _editing.Name)</h3>
            <div class="row">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_editing.Icon" Style="width:4.5rem;text-align:center;font-size:1.2rem" MaxLength="8" Label="Icon" />
                <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_editing.Name" Placeholder="e.g. weekly-report" Label="Name (the slash command)" />
            </div>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_editing.Description" Placeholder="e.g. Turn my notes into a weekly status report" Label="When to use it (one line — bots read this)" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="8" @bind-Value="_editing.Instructions" Placeholder="Step-by-step instructions, format, tone, what to include and avoid…" Label="Instructions" />
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
            <div class="row end">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _editing = null">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save skill</MudButton>
            </div>
        </MudPaper>
    }

    <MudPaper Class="card" Elevation="0">
        <h3>Bots write their own skills</h3>
        <MudSwitch T="bool" Color="Color.Primary" Value="@(State.Settings.SkillLearning.Enabled)" ValueChanged="(bool v) => SetLearning(s => s.Enabled = v)" Class="check"><span><b>Learn from experience</b> — after a job that took several steps, a bot saves the method as a skill, and fixes skills that turned out wrong</span></MudSwitch>
        @if (State.Settings.SkillLearning.Enabled)
        {
            <MudSwitch T="bool" Color="Color.Primary" Value="@(State.Settings.SkillLearning.NeedsReview)" ValueChanged="(bool v) => SetLearning(s => s.NeedsReview = v)" Class="check"><span><b>Let me review them first</b> — new and changed skills wait here for your OK</span></MudSwitch>
            <label class="row">Review a reply when it used at least
                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:4.5rem" Value="@(State.Settings.SkillLearning.MinToolCalls)" ValueChanged="(int v) => SetLearning(s => s.MinToolCalls = Math.Clamp(v, 2, 20))" />
                tools</label>
        }
    </MudPaper>

    @if (State.Skills.Any(s => s.Pending))
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Waiting for your OK</h3>
            @foreach (var s in State.Skills.Where(s => s.Pending))
            {
                var skill = s;
                <details class="memory-row skill-pending">
                    <summary><b>/@skill.Name</b> <span class="muted small">@skill.Description · @(skill.Source is not null ? "imported" : "by " + Author(skill))@(skill.Revisions.Count > 0 ? " · changed" : "")</span>
                        @if (skill.Warnings.Count > 0) { <span class="tiny-error"> ⚠ @skill.Warnings.Count to check</span> }</summary>
                    @if (skill.Source is not null) { <div class="muted small">From @skill.Source</div> }
                    @foreach (var w in skill.Warnings) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box small">⚠ @w</MudAlert> }
                    @if (skill.Files.Count > 0) { <div class="muted small">Bundled files: @string.Join(", ", skill.Files.Keys)</div> }
                    <pre class="code-block small" style="white-space:pre-wrap">@skill.Instructions</pre>
                    <div class="row end">
                        @if (skill.Revisions.Count > 0) { <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => Reject(skill)">Keep the old version</MudButton> }
                        else { <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => Store.DeleteAsync(skill.Id)">Discard</MudButton> }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => Edit(skill)">Edit</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Approve(skill)">Approve</MudButton>
                    </div>
                </details>
            }
        </MudPaper>
    }

    <AgentImportCard />
    <MudPaper Class="card" Elevation="0">
        <div class="row">
            <span class="grow"><b>Starter skills</b><br /><span class="muted small">Job pipeline, interview prep, meal plan, meeting prep, email triage, research report and weekly review. They use whatever you've connected (mail, calendar, documents, To Do).</span></span>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddStarters">Add missing</MudButton>
        </div>
        @if (_starterMessage is not null) { <span class="muted small">@_starterMessage</span> }
    </MudPaper>
    <SkillCatalogCard />

    <MudPaper Class="card" Elevation="0">
        <h3>Import &amp; export</h3>
        <p class="muted small">
            Skills use the open <code>SKILL.md</code> format, so they move between Hearth, Claude, Hermes and OpenClaw. Import a
            GitHub folder or file link (e.g. a skill from a skills hub), a raw SKILL.md link, a .zip, or a .md file. Imported skills
            wait for your review, with anything risky flagged. Approved skills are also kept as files in
            <code>@Porter.FolderPath</code>, where other agents can read them.
        </p>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_importUrl" Placeholder="https://github.com/owner/repo/tree/main/skills/some-skill" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportUrl" Disabled="@(_importing || string.IsNullOrWhiteSpace(_importUrl))">@(_importing ? "Importing…" : "Import")</MudButton>
        </div>
        <div class="row">
            <label class="btn ghost file-btn">Upload .md or .zip<InputFile OnChange="ImportFile" accept=".md,.zip,text/markdown,application/zip" style="display:none" /></label>
            <span class="spacer"></span>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ExportAll" Disabled="@(!State.Skills.Any(s => !s.Pending))">⬇ Export all (.zip)</MudButton>
        </div>
        @if (_importMessage is not null) { <div class="ok-text small">@_importMessage</div> }
        @if (_error is not null && _editing is null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
    </MudPaper>

    <TeachSkill />

    @{ var now = DateTimeOffset.Now; var sick = State.Skills.Where(x => x.NeedsFixing).ToList(); var idle = State.Skills.Where(x => !x.NeedsFixing && x.IsIdle(now)).ToList(); }
    @if (sick.Count + idle.Count > 0)
    {
        <MudPaper Class="card" Elevation="0">
            <h3><span aria-hidden="true">🩺</span> Skills that need a look</h3>
            @foreach (var s in sick)
            {
                var skill = s;
                <div class="memory-row skill-health">
                    <span class="tool-icon">👎</span>
                    <span class="grow"><b>/@skill.Name</b> <span class="muted small">marked wrong @skill.WrongNotes.Count× since it last changed@(skill.Uses > 0 ? $" ({skill.Wrong} of {skill.Uses} uses in all)" : "")</span>
                        <ul class="small health-notes">@foreach (var n in skill.WrongNotes) { <li>“@n”</li> }</ul></span>
                    <span class="health-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => FixSkill(skill)" Disabled="@(_fixing == skill.Id)">@(_fixing == skill.Id ? "Fixing…" : "Fix it from this")</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Edit(skill)">Edit</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" title="Clear these notes without changing the skill" OnClick="() => Store.ClearWrongAsync(skill)">It's fine</MudButton>
                    </span>
                </div>
            }
            @foreach (var s in idle)
            {
                var skill = s;
                <div class="memory-row skill-health">
                    <span class="tool-icon">💤</span>
                    <span class="grow"><b>/@skill.Name</b> <span class="muted small">@(skill.LastUsed is { } u ? $"last used {u:MMM d}" : $"never used since {skill.CreatedAt:MMM d}")</span></span>
                    <span class="health-actions">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Store.KeepAsync(skill)">Keep</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Store.DeleteAsync(skill.Id)">Delete</MudButton>
                    </span>
                </div>
            }
            @if (_healthMessage is not null) { <p class="muted small">@_healthMessage</p> }
        </MudPaper>
    }

    <MudPaper Class="card" Elevation="0">
        <h3>Your skills (@State.Skills.Count(s => !s.Pending))</h3>
        @foreach (var s in State.Skills.Where(s => !s.Pending))
        {
            var skill = s;
            <div class="memory-row">
                <span class="tool-icon">@skill.Icon</span>
                <span class="grow"><b>/@skill.Name</b> <span class="muted small">@skill.Description</span>
                    <br /><span class="muted small">@(skill.WrittenByBot ? $"Written by {Author(skill)}" : "Yours")@(skill.Uses > 0 ? $" · used {skill.Uses}×" : "")@(skill.Wrong > 0 ? $" · 👎 {skill.Wrong}×" : "")@(skill.Revisions.Count > 0 ? $" · last changed {skill.UpdatedAt:MMM d} by {skill.Revisions[0].By ?? "you"}" : "")</span></span>
                @if (skill.Revisions.Count > 0)
                {
                    <MudIconButton Size="Size.Small" title="@($"Undo the last change ({skill.Revisions[0].Note})")" OnClick="() => Store.UndoAsync(skill)">↶</MudIconButton>
                }
                <MudIconButton Size="Size.Small" title="Edit" OnClick="() => Edit(skill)">✎</MudIconButton>
                <MudIconButton Size="Size.Small" title="Delete" OnClick="() => Store.DeleteAsync(skill.Id)">🗑</MudIconButton>
            </div>
        }
        @if (State.Skills.Count == 0) { <p class="muted">No skills yet — add some from the templates below.</p> }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Templates</h3>
        @foreach (var t in SkillTemplates.All.Where(t => State.Skills.All(s => s.Name != t.Name)))
        {
            var template = t;
            <div class="memory-row">
                <span class="tool-icon">@template.Icon</span>
                <span class="grow"><b>/@template.Name</b> <span class="muted small">@template.Description</span></span>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Add(template)">＋ Add</MudButton>
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddAll">＋ Add all templates</MudButton>
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    private Skill? _editing;
    private string? _fixing, _healthMessage;

    private async Task FixSkill(Skill skill)
    {
        _fixing = skill.Id; _healthMessage = null;
        try { _healthMessage = await Loop.FixSkillAsync(skill); }
        catch (Exception ex) { _healthMessage = ex.Message; }
        finally { _fixing = null; }
    }
    private bool _isNew;
    private string? _error;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(From) && _editing is null)
        {
            _isNew = true;
            _editing = new Skill { Instructions = From, Description = "" };
        }
    }

    private void New() { _isNew = true; _error = null; _editing = new Skill(); }

    private void Edit(Skill s)
    {
        _isNew = false;
        _error = null;
        _editing = System.Text.Json.JsonSerializer.Deserialize<Skill>(System.Text.Json.JsonSerializer.Serialize(s))!;
    }

    private async Task Save()
    {
        _error = null;
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Instructions)) { _error = "Add some instructions."; return; }
        try
        {
            if (State.Skills.FirstOrDefault(s => s.Id == _editing.Id) is { } before && before.Instructions != _editing.Instructions)
            {
                _editing.Revisions.Insert(0, new SkillRevision(before.Instructions, before.UpdatedAt, "Edited by you", "you"));
                if (_editing.Revisions.Count > 5) _editing.Revisions.RemoveRange(5, _editing.Revisions.Count - 5);
            }
            _editing.UpdatedAt = DateTimeOffset.Now;
            await Store.SaveAsync(_editing);
            _editing = null;
        }
        catch (ArgumentException ex) { _error = ex.Message; }
    }

    private async Task Add(Skill template)
    {
        try { await Store.SaveAsync(template); }
        catch (ArgumentException ex) { _error = ex.Message; }
    }

    private async Task AddAll()
    {
        foreach (var t in SkillTemplates.All.Where(t => State.Skills.All(s => s.Name != t.Name)))
            await Add(t);
    }

    private string Author(Skill s) => s.CreatedBy is null ? "you" : s.CreatedBy == Bot.PlainId ? "Hearth" : State.BotById(s.CreatedBy)?.Name ?? "a bot";

    private async Task SetLearning(Action<SkillLearningSettings> change)
    {
        var settings = await Settings.GetAsync();
        change(settings.SkillLearning);
        await Settings.SaveAsync(settings);
    }

    private async Task Approve(Skill s)
    {
        s.Pending = false;
        await Store.SaveAsync(s);
    }

    /// <summary>A bot's change was rejected: put the previous version back and approve that.</summary>
    private async Task Reject(Skill s)
    {
        s.Pending = false;
        await Store.UndoAsync(s);
    }

    private string _importUrl = "";
    private bool _importing;
    private string? _importMessage;

    private async Task ImportUrl()
    {
        await Import(() => Porter.ImportUrlAsync(_importUrl));
        if (_error is null) _importUrl = "";
    }

    private async Task ImportFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await Import(async () =>
        {
            await using var stream = file.OpenReadStream(20_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            if (file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase)) return await Porter.ImportZipAsync(ms, file.Name);
            return [await Porter.ImportTextAsync(System.Text.Encoding.UTF8.GetString(ms.ToArray()), file.Name,
                fallbackName: Path.GetFileNameWithoutExtension(file.Name) is var n && n != "SKILL" ? n : null)];
        });
    }

    private async Task Import(Func<Task<List<Skill>>> work)
    {
        _importing = true;
        _error = null;
        _importMessage = null;
        try
        {
            var added = await work();
            _importMessage = $"Imported {string.Join(", ", added.Select(s => "/" + s.Name))} — review below before bots can use {(added.Count == 1 ? "it" : "them")}.";
        }
        catch (Exception ex) { _importMessage = null; _error = ex.Message; }
        finally { _importing = false; }
    }

    private async Task ExportAll()
    {
        var zip = SkillPorter.ExportZip(State.Skills.Where(s => !s.Pending));
        await JS.InvokeVoidAsync("hearth.downloadImage", "data:application/zip;base64," + Convert.ToBase64String(zip), "hearth-skills.zip");
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    private string? _starterMessage;

    private async Task AddStarters()
    {
        var added = await Hearth.Core.Services.StarterSkills.AddMissingAsync(Store);
        _starterMessage = added == 0 ? "You have all of them." : $"Added {added} starter skill{(added == 1 ? "" : "s")}.";
    }
}
