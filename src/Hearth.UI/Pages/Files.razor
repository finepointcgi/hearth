@page "/files"
@inherits StatefulComponent
@inject IBotComputer Computer
@inject ConversationStore Conversations
@inject IJSRuntime JS
@inject LinkedFolders Linked

<header class="topbar">
    <MudIconButton Size="MudBlazor.Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Files</h2>
    <span class="spacer"></span>
    <MudIconButton Size="MudBlazor.Size.Small" title="Refresh" aria-label="Refresh" OnClick="LoadAsync"><Icon Name="refresh-cw" Size="16" /></MudIconButton>
</header>

<div class="settings files-page">
    <div class="places-row">
        @if (_folders.Count > 0)
        {
            <div class="seg-mini places" role="group" aria-label="Where">
                <button class="@(_place is null ? "on" : "")" @onclick="() => OpenPlace(null)"><Icon Name="sparkles" Size="14" /> Hearth files</button>
                @foreach (var f in _folders)
                {
                    var folder = f;
                    <button class="@(_place?.Id == folder.Id ? "on" : "")" title="@Display(folder.Path)" @onclick="() => OpenPlace(folder)">
                        <Icon Name="folder" Size="14" /> @FolderName(folder)
                    </button>
                }
            </div>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="MudBlazor.Size.Small" Href="documents" title="Link folders on this computer (Documents → Linked folders)"><Icon Name="folder" Size="14" /> @(_folders.Count == 0 ? "Browse a folder on this computer…" : "Link a folder")</MudButton>
    </div>
    @if (_place is not null && _cwd is not null)
    {
        <nav class="crumbs" aria-label="Folder">
            @foreach (var (label, path) in Crumbs())
            {
                var p = path;
                <button class="crumb" @onclick="() => OpenDir(p)">@label</button><span class="muted">/</span>
            }
            <span class="badge" title="Set on the Documents page">@(_place.Editable ? "bots can edit" : "bots can read")</span>
        </nav>
    }
    <div class="row">
        <label class="search-box grow"><Icon Name="search" Size="16" /><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search files" @bind-Value="_filter" Immediate="true" /></label>
        <div class="seg-mini" role="group" aria-label="Kind">
            @foreach (var k in new[] { "All", "Images", "Documents", "Data", "Code" })
            {
                var kind = k;
                <button class="@(_kind == kind ? "on" : "")" @onclick="() => _kind = kind">@kind</button>
            }
        </div>
    </div>

    <div class="files-layout">
        <div class="file-list">
            @foreach (var d in VisibleDirs())
            {
                var dir = d;
                <button class="file-item" @onclick="() => OpenDir(dir)">
                    <span class="file-thumb"><Icon Name="folder" Size="20" /></span>
                    <span class="file-meta"><b>@System.IO.Path.GetFileName(dir)</b><span class="muted small">Folder</span></span>
                </button>
            }
            @foreach (var f in Visible())
            {
                var file = f;
                <button class="file-item @(_selected == file ? "on" : "")" @onclick="() => Select(file)">
                    <span class="file-thumb">
                        @if (file.Image is not null) { <img src="@file.Image.DataUrl" alt="" /> }
                        else { <Icon Name="@KindIcon(file)" Size="20" /> }
                    </span>
                    <span class="file-meta"><b>@file.Name</b>
                        <span class="muted small">@file.Where · @file.When.ToString("MMM d, h:mm tt")@(file.Size > 0 ? " · " + Size(file.Size) : "")</span></span>
                </button>
            }
            @if (_dirError is not null)
            {
                <p class="tiny-error pad">@_dirError</p>
            }
            else if (!Visible().Any() && !VisibleDirs().Any())
            {
                <p class="muted small pad">@(_place is not null ? (_all.Count == 0 && _dirs.Count == 0 ? "This folder is empty." : "Nothing matches.")
                    : _all.Count == 0 ? "Nothing yet. Files your bots write, downloads from their browser, and images they generate show up here." : "No files match.")</p>
            }
        </div>

        @if (_selected is { } sel)
        {
            <aside class="file-preview card">
                <div class="row">
                    <b class="grow ellipsis">@sel.Name</b>
                    @if (sel.ConversationId is not null) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="MudBlazor.Size.Small" Href="@($"c/{sel.ConversationId}")">Open chat</MudButton> }
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="MudBlazor.Size.Small" OnClick="Download"><Icon Name="download" Size="15" /> Download</MudButton>
                    @if (sel.Path is not null && InWorkspace(sel.Path)) { <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="MudBlazor.Size.Small" OnClick="Delete"><Icon Name="trash-2" Size="15" /> Delete</MudButton> }
                </div>
                <span class="muted small">@sel.Where@(sel.Path is null ? "" : InWorkspace(sel.Path) ? " · " + Relative(sel.Path)
                        : _place is not null ? " · " + System.IO.Path.GetRelativePath(_place.Path, sel.Path) : " · " + Display(sel.Path))</span>
                @if (sel.Image is not null)
                {
                    <img class="preview-image" src="@sel.Image.DataUrl" alt="@sel.Name" />
                }
                else if (_previewHtml is not null)
                {
                    <iframe class="preview-frame" sandbox="allow-scripts" srcdoc="@_previewHtml" title="Preview of @sel.Name"></iframe>
                }
                else if (_previewMarkdown is not null)
                {
                    <div class="md preview-text"><Markdown Text="@_previewMarkdown" /></div>
                }
                else if (_previewText is not null)
                {
                    <pre class="preview-text">@_previewText</pre>
                }
                else
                {
                    <p class="muted small">No preview for this kind of file. Download it to open it.</p>
                }
            </aside>
        }
    </div>
</div>

@code {
    private sealed record FileEntry(string Name, string Where, DateTime When, long Size, string? Path, ImageAttachment? Image, string? ConversationId)
    {
        public string Ext => System.IO.Path.GetExtension(Name).ToLowerInvariant();
    }

    private List<FileEntry> _all = [];
    private List<LinkedFolder> _folders = [];
    private LinkedFolder? _place;
    private string? _cwd, _dirError;
    private List<string> _dirs = [];
    private FileEntry? _selected;
    private string _filter = "", _kind = "All";
    private string? _previewText, _previewMarkdown, _previewHtml;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _folders = (await Linked.ListAsync()).Where(f => f.Enabled && Directory.Exists(f.Path)).ToList();
        if (_place is not null)
        {
            // Folders may have been unlinked since: stay in the same one if it's still linked.
            _place = _folders.FirstOrDefault(f => f.Id == _place.Id);
            if (_place is not null) { await OpenDir(_cwd ?? _place.Path); return; }
            _cwd = null;
        }
        _dirs = [];
        _dirError = null;
        var list = new List<FileEntry>();
        var root = Computer.WorkspaceDirectory;
        if (Directory.Exists(root))
            foreach (var path in Directory.EnumerateFiles(root, "*", SearchOption.AllDirectories).Take(1000))
            {
                var info = new FileInfo(path);
                if (info.Name.StartsWith('.')) continue;
                var where = Relative(path).StartsWith("downloads") ? "Browser download" : "Workspace";
                list.Add(new FileEntry(info.Name, where, info.LastWriteTime, info.Length, path, IsImage(info.Extension) && info.Length < 8_000_000
                    ? new ImageAttachment(info.Name, Mime(info.Extension), Convert.ToBase64String(await File.ReadAllBytesAsync(path))) : null, null));
            }
        // Images generated in chats (newest chats first).
        foreach (var summary in (await Conversations.ListAsync()).OrderByDescending(c => c.UpdatedAt).Take(150))
        {
            var conv = await Conversations.GetAsync(summary.Id);
            foreach (var m in conv?.Messages ?? [])
                foreach (var img in m.GeneratedImages)
                    list.Add(new FileEntry(img.FileName.Contains('.') ? img.FileName : img.FileName + ".png", $"Generated in \"{summary.Title}\"",
                        m.CreatedAt.LocalDateTime, img.Base64.Length * 3L / 4, null, img, summary.Id));
        }
        _all = list.OrderByDescending(f => f.When).ToList();
        if (_selected is not null && _all.All(f => f.Name != _selected.Name || f.Path != _selected.Path)) _selected = null;
    }

    private async Task OpenPlace(LinkedFolder? folder)
    {
        _place = folder;
        _selected = null;
        _filter = "";
        _cwd = folder?.Path;
        if (folder is null) await LoadAsync();
        else await OpenDir(_cwd!);
    }

    /// <summary>
    /// Lists one folder inside the current linked folder, with the same rules the bots get (LinkedFolders.FolderForAsync):
    /// nothing outside it, no symlinks, no hidden files or folders.
    /// </summary>
    private async Task OpenDir(string dir)
    {
        _selected = null;
        _dirError = null;
        _dirs = [];
        _all = [];
        if (_place is null) return;
        var full = LinkedFolders.Normalize(dir);
        if ((await Linked.FolderForAsync(full))?.Id != _place.Id) { _dirError = "That's outside this folder."; return; }
        _cwd = full;
        try
        {
            _dirs = Directory.EnumerateDirectories(full)
                .Where(d => !System.IO.Path.GetFileName(d).StartsWith('.') && new DirectoryInfo(d).LinkTarget is null)
                .OrderBy(d => d, StringComparer.OrdinalIgnoreCase).Take(500).ToList();
            _all = Directory.EnumerateFiles(full).Select(f => new FileInfo(f)).Where(i => !i.Name.StartsWith('.'))
                .Take(2000)
                .Where(i => i.LinkTarget is null)
                .Select(i => new FileEntry(i.Name, FolderName(_place), i.LastWriteTime, i.Length, i.FullName, null, null))
                .OrderByDescending(f => f.When).ToList();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or IOException)
        {
            _dirError = $"Can't open this folder: {ex.Message}";
        }
    }

    private IEnumerable<(string label, string path)> Crumbs()
    {
        if (_place is null || _cwd is null) yield break;
        var root = _place.Path;
        yield return (FolderName(_place), root);
        var path = root;
        foreach (var part in System.IO.Path.GetRelativePath(root, _cwd).Split(System.IO.Path.DirectorySeparatorChar, StringSplitOptions.RemoveEmptyEntries))
        {
            if (part == ".") continue;
            path = System.IO.Path.Combine(path, part);
            yield return (part, path);
        }
    }

    private IEnumerable<string> VisibleDirs() => _place is null ? [] :
        _dirs.Where(d => _filter.Length == 0 || System.IO.Path.GetFileName(d).Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private bool InWorkspace(string path) =>
        System.IO.Path.GetFullPath(path).StartsWith(System.IO.Path.TrimEndingDirectorySeparator(System.IO.Path.GetFullPath(Computer.WorkspaceDirectory)) + System.IO.Path.DirectorySeparatorChar, StringComparison.Ordinal);

    private static string FolderName(LinkedFolder f) => System.IO.Path.GetFileName(f.Path) is { Length: > 0 } n ? n : f.Path;

    /// <summary>"/Users/me/notes" → "~/notes".</summary>
    private static string Display(string path)
    {
        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        return path.StartsWith(home + System.IO.Path.DirectorySeparatorChar) ? "~" + path[home.Length..] : path;
    }

    private IEnumerable<FileEntry> Visible() => _all
        .Where(f => _filter.Length == 0 || f.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) || f.Where.Contains(_filter, StringComparison.OrdinalIgnoreCase))
        .Where(f => _kind switch
        {
            "Images" => f.Image is not null || IsImage(f.Ext),
            "Documents" => f.Ext is ".md" or ".txt" or ".pdf" or ".docx" or ".html" or ".htm" or ".rtf",
            "Data" => f.Ext is ".csv" or ".json" or ".xlsx" or ".tsv" or ".xml" or ".yaml" or ".yml",
            "Code" => f.Ext is ".py" or ".js" or ".ts" or ".cs" or ".sh" or ".sql" or ".css" or ".go" or ".rs",
            _ => true,
        });

    private async Task Select(FileEntry f)
    {
        _selected = f;
        _previewText = _previewMarkdown = _previewHtml = null;
        if (f.Path is null || f.Image is not null) return;
        var size = new FileInfo(f.Path).Length;
        if (IsImage(f.Ext) && size < 8_000_000)
        {
            _selected = f with { Image = new ImageAttachment(f.Name, Mime(f.Ext), Convert.ToBase64String(await File.ReadAllBytesAsync(f.Path))) };
            return;
        }
        if (size > 400_000 || f.Ext is ".pdf" or ".docx" or ".xlsx" or ".zip") return;
        var bytes = await File.ReadAllBytesAsync(f.Path);
        if (bytes.AsSpan(0, Math.Min(bytes.Length, 8000)).IndexOf((byte)0) >= 0) return; // binary
        var text = System.Text.Encoding.UTF8.GetString(bytes);
        if (f.Ext is ".html" or ".htm" or ".svg") _previewHtml = text;
        else if (f.Ext is ".md") _previewMarkdown = text;
        else if (f.Ext is ".csv") _previewMarkdown = CsvToMarkdown(text);
        else _previewText = text;
    }

    private async Task Download()
    {
        if (_selected is not { } f) return;
        var (mime, b64) = f.Image is { } img ? (img.MimeType, img.Base64)
            : f.Path is not null ? (Mime(f.Ext), Convert.ToBase64String(await File.ReadAllBytesAsync(f.Path))) : ("application/octet-stream", "");
        await JS.InvokeVoidAsync("hearth.downloadImage", $"data:{mime};base64,{b64}", f.Name);
    }

    private async Task Delete()
    {
        if (_selected?.Path is not { } path || !InWorkspace(path)) return;
        File.Delete(path);
        _selected = null;
        await LoadAsync();
    }

    private string Relative(string path) => System.IO.Path.GetRelativePath(Computer.WorkspaceDirectory, path);

    private static string CsvToMarkdown(string csv)
    {
        var lines = csv.ReplaceLineEndings("\n").Split('\n', StringSplitOptions.RemoveEmptyEntries).Take(300).Select(l => l.Split(',')).ToList();
        if (lines.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("| " + string.Join(" | ", lines[0]) + " |").AppendLine("|" + string.Concat(lines[0].Select(_ => " --- |")));
        foreach (var l in lines.Skip(1)) sb.AppendLine("| " + string.Join(" | ", l.Select(c => c.Replace("|", "\\|"))) + " |");
        return sb.ToString();
    }

    private static bool IsImage(string ext) => ext.ToLowerInvariant() is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp";
    private static string Mime(string ext) => ext.ToLowerInvariant() switch
    {
        ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".gif" => "image/gif", ".webp" => "image/webp",
        ".pdf" => "application/pdf", ".html" or ".htm" => "text/html", ".csv" => "text/csv", ".json" => "application/json",
        ".md" or ".txt" => "text/plain", _ => "application/octet-stream",
    };
    private static string KindIcon(FileEntry f) => f.Ext switch
    {
        ".csv" or ".xlsx" or ".tsv" => "sheet",
        ".py" or ".js" or ".ts" or ".cs" or ".sh" or ".sql" or ".json" => "code",
        _ => "file-text",
    };
    private static string Size(long b) => b >= 1_000_000 ? $"{b / 1_000_000.0:0.#} MB" : b >= 1000 ? $"{b / 1000.0:0} KB" : $"{b} B";

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }
}
