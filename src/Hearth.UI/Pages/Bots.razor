@page "/bots"
@inherits StatefulComponent
@inject BotStore Store
@inject ConversationStore Conversations
@inject NavigationManager Nav
@inject SettingsStore SettingsStore

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Bots</h2>
    <span class="spacer"></span>
    <span class="muted small">@State.Bots.Count / @Bot.MaxBots</span>
</header>

<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <p class="muted">
            Bots are AI teammates with their own role, instructions, model, tools, memory and routines.
            Chat with one, or put 2–@Bot.MaxPerGroup in a group chat: they decide who answers, hand work to each other with
            <code>@@Name</code>, and can message each other directly.
        </p>
        <div class="row">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="bots/new">＋ New bot</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@(State.Bots.Count < 2)" OnClick="() => _picking = !_picking">👥 New group chat</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddStarterTeam" Disabled="@(State.Bots.Count + Missing().Count > Bot.MaxBots || Missing().Count == 0)">✨ Add starter team</MudButton>
            @if (_suite.Count > 0)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddSuiteTeam" Disabled="@(State.Bots.Count + _suite.Count > Bot.MaxBots)"
                           title="@string.Join(", ", _suite.Select(b => b.Name))">🏗️ Add engineering team</MudButton>
            }
        </div>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
    </MudPaper>

    @if (State.Bots.Count > 0)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>Teamwork</h3>
            <div class="row">
                <MudSelect Class="grow" Label="New chats go to" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(_defaultBot ?? "auto")" ValueChanged="Ev.Change<string>(SetDefault)" T="string">
                        <MudSelectItem Value="@("auto")">@(State.Bots.FirstOrDefault(b => b.IsCoordinator)?.Name is { } c ? $"{c} (the coordinator)" : "the coordinator, once there is one")</MudSelectItem>
                        @foreach (var b in State.Bots.Where(b => !b.IsCoordinator))
                        {
                            <MudSelectItem Value="@(b.Id)">@b.Name</MudSelectItem>
                        }
                        <MudSelectItem Value="@("none")">Plain Hearth (no bot)</MudSelectItem>
                    </MudSelect>
            </div>
            <MudSwitch T="bool" Color="Color.Primary" Value="@(_plan)" ValueChanged="(bool v) => SetTeamwork(plan: v)" Class="check" Label="The coordinator plans first: answers small things itself, hands clear jobs to one specialist, and splits bigger requests across the team (later bots build on earlier ones' work)" />
            <MudSwitch T="bool" Color="Color.Primary" Value="@(_review)" ValueChanged="(bool v) => SetTeamwork(review: v)" Class="check" Label="When it matters, the reviewer (Critic) checks the team's work and it's fixed before the final answer" />
            <p class="muted small">You can always @@mention a bot to ask it directly. Team answers take longer on a local model: each bot's step is its own model call.</p>
        </MudPaper>
    }

    @if (_picking)
    {
        <MudPaper Class="card" Elevation="0">
            <h3>New group chat</h3>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_groupName" Placeholder="Group name, e.g. Launch planning" />
            <div class="bot-grid">
                @foreach (var b in State.Bots)
                {
                    var bot = b;
                    var on = _selected.Contains(bot.Id);
                    <button class="bot-card pick @(on ? "on" : "")" @onclick="() => TogglePick(bot.Id)">
                        <BotAvatar Bot="bot" Size="lg" />
                        <b>@bot.Name</b>
                        <span class="muted small">@bot.Title</span>
                    </button>
                }
            </div>
            <div class="row">
                <span class="muted grow">@_selected.Count selected (2–@Bot.MaxPerGroup)</span>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selected.Count is < 2 or > Bot.MaxPerGroup)" OnClick="CreateGroup">Create group</MudButton>
            </div>
        </MudPaper>
    }

    <MudPaper Class="card" Elevation="0">
        <h3>Your bots</h3>
        <div class="bot-grid">
            @foreach (var b in State.Bots)
            {
                <div class="bot-card">
                    <BotAvatar Bot="b" Size="lg" />
                    <b>@b.Name</b>
                    <span class="muted small">@b.Title</span>
                    <span class="badges">
                        @if (b.IsCoordinator) { <span class="badge">coordinator</span> }
                        @if (b.Routines.Count(r => r.Enabled) is > 0 and var n) { <span class="badge">⏰ @n</span> }
                        @if (!string.IsNullOrEmpty(b.Model)) { <span class="badge">@b.Model</span> }
                    </span>
                    <span class="ability-icons" title="Abilities">
                        @if (b.Abilities.WebSearch) { <span title="Web search">🔎</span> }
                        @if (b.Abilities.Browser) { <span title="@(b.Abilities.BrowserProfile == BrowserProfile.Own ? "Own browser" : "Shared browser")">🧭</span> }
                        @if (b.Abilities.ComputerUse) { <span title="Computer use">🖱️</span> }
                        @if (b.Abilities.Code) { <span title="Code">🐍</span> }
                        @if (b.Abilities.Images) { <span title="Images">🎨</span> }
                        @if (b.Memory.Enabled) { <span title="@(b.Memory.AutoLearn ? "Remembers and learns" : "Remembers")">🧠</span> }
                    </span>
                    <div class="row">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@($"bot/{b.Id}")">Chat</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="@($"bots/{b.Id}")">Edit</MudButton>
                    </div>
                </div>
            }
        </div>
        @if (State.Bots.Count == 0) { <p class="muted">No bots yet. Start from a template below or add the starter team.</p> }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Templates</h3>
        <div class="bot-grid">
            @foreach (var t in BotTemplates.All)
            {
                var template = t;
                <button class="bot-card pick" @onclick="() => FromTemplate(template)">
                    <BotAvatar Bot="template" Size="lg" />
                    <b>@template.Name</b>
                    <span class="muted small">@template.Title</span>
                </button>
            }
        </div>
    </MudPaper>
</div>

@code {
    private string? _defaultBot;
    private bool _plan = true, _review = true;

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsStore.GetAsync();
        _defaultBot = s.DefaultBotId switch { null => null, "" => "none", var id => id };
        _plan = s.Teamwork.Plan;
        _review = s.Teamwork.Review;
        _servers = s.McpServers.Where(m => m.Enabled).Select(m => m.Name).ToList();
        RefreshSuite();
    }

    // Engineering team: one bot per Workbench, Meridian and Keel MCP server that is set up (Tools and MCP).
    private List<string> _servers = [];
    private List<Bot> _suite = [];
    private void RefreshSuite() => _suite = BotTemplates.SuiteToAdd(_servers, State.Bots.Select(b => b.Name));

    private async Task AddSuiteTeam()
    {
        _error = null;
        try { foreach (var b in _suite) await Store.SaveAsync(b); RefreshSuite(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SetDefault(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        var s = await SettingsStore.GetAsync();
        s.DefaultBotId = v switch { "auto" or null => null, "none" => "", _ => v };
        _defaultBot = v == "auto" ? null : v;
        await SettingsStore.SaveAsync(s);
    }

    private async Task SetTeamwork(bool? plan = null, bool? review = null)
    {
        var s = await SettingsStore.GetAsync();
        if (plan is { } p) s.Teamwork.Plan = _plan = p;
        if (review is { } r) s.Teamwork.Review = _review = r;
        await SettingsStore.SaveAsync(s);
    }

    private bool _picking;
    private string _groupName = "";
    private readonly HashSet<string> _selected = [];
    private string? _error;

    private void TogglePick(string id)
    {
        if (!_selected.Remove(id) && _selected.Count < Bot.MaxPerGroup) _selected.Add(id);
    }

    private List<Bot> Missing() =>
        BotTemplates.All.Take(5).Where(t => State.Bots.All(b => b.Name != t.Name)).ToList();

    private async Task AddStarterTeam()
    {
        _error = null;
        try { foreach (var t in Missing()) await Store.SaveAsync(t); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task FromTemplate(Bot template)
    {
        _error = null;
        try
        {
            var bot = template;
            if (State.Bots.Any(b => b.Name.Equals(bot.Name, StringComparison.OrdinalIgnoreCase))) bot.Name += " 2";
            await Store.SaveAsync(bot);
            Nav.NavigateTo($"bots/{bot.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task CreateGroup()
    {
        var members = State.Bots.Where(b => _selected.Contains(b.Id)).ToList();
        var conv = new Conversation
        {
            Title = string.IsNullOrWhiteSpace(_groupName) ? string.Join(", ", members.Select(b => b.Name)) : _groupName.Trim(),
            BotIds = members.Select(b => b.Id).ToList(),
        };
        await Conversations.SaveAsync(conv);
        Nav.NavigateTo($"c/{conv.Id}");
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }
}
