    private async Task Test(ProviderProfile p)
    {
        _tests[p.Id] = (true, "Testing…");
        try
        {
            var models = await Factory.Create(p).ListModelsAsync();
            _tests[p.Id] = (true, models.Count == 0
                ? "Connected, but no models found."
                : $"Connected ✓ {models.Count} model(s): {string.Join(", ", models.Take(6).Select(m => m.Id))}{(models.Count > 6 ? "…" : "")}");
        }
        catch (Exception ex)
        {
            _tests[p.Id] = (false, ex.Message);
        }
    }

    private void ToggleFallback(string id, bool on)
    {
        _s!.FallbackProviderIds.Remove(id);
        if (on) _s.FallbackProviderIds.Add(id);
    }

    private async Task Save()
    {
        if (_s is null) return;
        foreach (var p in _s.Providers) p.BaseUrl = p.BaseUrl.Trim();
        // Only what this page edits: everything else (cards on this page that save themselves, other pages,
        // approvals) may have changed since it opened and must not be overwritten with the old copy.
        var current = SettingsCopy.Of(await Store.GetAsync());
        var mine = SettingsCopy.Of(_s);
        current.Providers = mine.Providers;
        current.ActiveProviderId = mine.ActiveProviderId;
        current.FallbackProviderIds = mine.FallbackProviderIds;
        current.AutoTitle = mine.AutoTitle;
        current.ContextLength = mine.ContextLength;
        current.ContinueCutOffReplies = mine.ContinueCutOffReplies;
        current.CheckAnswers = mine.CheckAnswers;
        current.CustomSystemPrompt = mine.CustomSystemPrompt;
        current.DefaultPersonaId = mine.DefaultPersonaId;
        current.ImageGen = mine.ImageGen;
        current.MaxTokens = mine.MaxTokens;
        current.SearchResultCount = mine.SearchResultCount;
        current.SearxngUrl = mine.SearxngUrl;
        current.ShowThinking = mine.ShowThinking;
        current.TakeInitiative = mine.TakeInitiative;
        current.Temperature = mine.Temperature;
        current.Voice = mine.Voice;
        await Store.SaveAsync(current);
        State.PersonaId = _s.DefaultPersonaId;
        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }

    private async Task DeleteAll()
    {
        await Conversations.DeleteAllAsync();
        _confirmDelete = false;
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }
