@page "/settings"
@inject Hearth.Core.Services.AudioTranscriber Transcriber
@inject IHttpClientFactory HttpFactory
@inject ProjectContext Soul
@inject SettingsStore Store
@inject IServiceProvider Services
@inherits StatefulComponent
@inject ILlmClientFactory Factory
@inject ConversationStore Conversations
@inject PlatformInfo Platform
@inject ImageGenService ImageGen
@inject SpeechService Speech
@inject ISpeechOutput SpeechOut
@inject IJSRuntime JS

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Settings</h2>
    <span class="spacer"></span>
    @if (_saved) { <span class="ok-text">Saved ✓</span> }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
</header>

@if (_s is not null)
{
<div class="settings @(Searching ? "searching" : "")" @ref="_container">
    <div class="settings-search" role="search">
        <Icon Name="search" Size="16" />
        <MudTextField Variant="Variant.Text" Underline="false" InputType="InputType.Search" Placeholder="Search settings" Class="grow" aria-label="Search settings" @bind-Value="_query" Immediate="true" @bind-Value:after="QueryChanged" OnKeyDown="SearchKey" />
        @if (Searching)
        {
            <MudIconButton Size="Size.Small" title="Clear search" aria-label="Clear search" OnClick="ClearSearch"><Icon Name="x" Size="16" /></MudIconButton>
        }
    </div>
    @if (Searching)
    {
        var elsewhere = SettingsIndex.Find(_query).ToList();
        @if (elsewhere.Count > 0)
        {
            <nav class="search-elsewhere" aria-label="On other settings pages">
                <span class="muted small">On other settings pages</span>
                @foreach (var link in elsewhere)
                {
                    <a href="@link.Href"><Icon Name="@link.Icon" Size="15" /> <span class="grow">@link.Title</span> <span class="muted small">@link.Page</span> <Icon Name="chevron-right" Size="14" /></a>
                }
            </nav>
        }
        @if (_matches == 0 && elsewhere.Count == 0)
        {
            <div class="search-empty">
                <p>No settings match “@_query.Trim()”.</p>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="ClearSearch">Clear search</MudButton>
            </div>
        }
    }
    <TabBar Label="Settings sections" Tabs="SettingsTabs" @bind-Value="_tab" />
    @if (Show("models"))
    {
    <MudPaper Class="card" Elevation="0">
        <h3>Model servers</h3>
        @if (Services.GetService<ICurrentUser>()?.Account is { IsOwner: false } && Services.GetService<AccountStore>()?.Owner is { } owner)
        {
            <p class="notice small">Model servers are shared from @owner.Name's account: changes they make there replace this list.</p>
        }
        <p class="muted">Hearth talks to LLMs running on your own machines. Pick the active server; phones and tablets should point at your computer's LAN IP (running on @Platform.Name).</p>

        @foreach (var p in _s.Providers)
        {
            var provider = p;
            <div class="provider @(provider.Id == _s.ActiveProviderId || (_s.ActiveProviderId is null && provider == _s.Providers[0]) ? "active" : "")">
                <div class="row">
                    <label class="radio"><input type="radio" name="active" checked="@(provider == _s.ActiveProvider)" @onchange="() => _s.ActiveProviderId = provider.Id" /> Active</label>
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="provider.Name" Placeholder="Name" />
                    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="provider.Kind">
                        <MudSelectItem Value="@(ProviderKind.Ollama)">Ollama</MudSelectItem>
                        <MudSelectItem Value="@(ProviderKind.OpenAICompatible)">OpenAI-compatible</MudSelectItem>
                        <MudSelectItem Value="@(ProviderKind.Anthropic)">Claude (Anthropic API)</MudSelectItem>
                        <MudSelectItem Value="@(ProviderKind.ClaudeCode)" Disabled="@(!Platform.CanRunProcesses)">Claude Code (local CLI)@(Platform.CanRunProcesses ? "" : " — desktop only")</MudSelectItem>
                    </MudSelect>
                    <MudIconButton Size="Size.Small" title="Remove" Disabled="@(_s.Providers.Count == 1)" OnClick="() => _s.Providers.Remove(provider)">🗑</MudIconButton>
                </div>
                <div class="row">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="provider.BaseUrl" Placeholder="@AddressHint(provider.Kind)" title="@AddressHint(provider.Kind)" />
                    @if (provider.Kind != ProviderKind.ClaudeCode)
                    {
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" InputType="InputType.Password" @bind-Value="provider.ApiKey" Placeholder="@(provider.Kind == ProviderKind.Anthropic ? "Anthropic API key (sk-ant-…)" : "API key (optional for local servers)")" />
                    }
                </div>
                @if (provider.Kind is ProviderKind.Anthropic or ProviderKind.OpenAICompatible)
                {
                    <details class="advanced">
                        <summary>More API keys@(provider.ExtraApiKeys.Count > 0 ? $" ({provider.ExtraApiKeys.Count} saved)" : "")</summary>
                        <p class="muted small">Calls take turns across all the keys, and when one hits a rate limit or runs out of quota the request moves on to the next. Paste one key per line; saving replaces the list (leave empty to keep it). Stored encrypted.</p>
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" Placeholder="@(provider.ExtraApiKeys.Count > 0 ? "saved — paste keys to replace them" : "one key per line")" ValueChanged="(string v) => SetExtraKeys(provider, v)" T="string" />
                        @if (provider.ExtraApiKeys.Count > 0) { <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => provider.ExtraApiKeys.Clear()">Remove extra keys</MudButton> }
                    </details>
                }
                <div class="muted small">@KindHelp(provider.Kind)</div>
                <div class="row">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="provider.DefaultModel" Placeholder="Default model (optional)" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => Test(provider)">Test connection</MudButton>
                </div>
                <label class="small">Context window (tokens)
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="provider.ContextTokens" Style="width:9rem" Placeholder="@ContextWindow.WindowFor(new ProviderProfile { Kind = provider.Kind }, _s).ToString()" />
                    <span class="muted">How much the model can read at once. Longer chats are summarised to fit. Leave empty for the default.</span>
                </label>
                @if (provider.Kind == ProviderKind.OpenAICompatible)
                {
                    <details class="advanced">
                        <summary>Prices for cost estimates (cloud servers only)</summary>
                        <div class="row">
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="provider.InputPricePerMillion" Style="width:8rem" Label="Input $ per million tokens" />
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="provider.OutputPricePerMillion" Style="width:8rem" Label="Output $ per million tokens" />
                        </div>
                        <span class="muted small">Leave empty for servers on your own hardware (counted as free). Claude API prices are built in.</span>
                    </details>
                }
                @if (_tests.TryGetValue(provider.Id, out var result))
                {
                    <div class="@(result.ok ? "ok-text" : "error-box")">@result.msg</div>
                }
            </div>
        }
        <div class="row">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddOllama">＋ Ollama</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddLmStudio">＋ LM Studio</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddLlamaCpp">＋ llama.cpp</MudButton>
        </div>
        <div class="row">
            <span class="muted small">Cloud &amp; other:</span>
            @if (Platform.CanUseComputer)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddClaudeCode">＋ Claude Code</MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddClaudeApi">＋ Claude API</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddOpenAI">＋ OpenAI</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddOpenRouter">＋ OpenRouter</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddGroq">＋ Groq</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddCustom">＋ Other OpenAI-compatible</MudButton>
        </div>
    </MudPaper>
    <MudPaper Class="card" Elevation="0">
        <h3>Backup servers</h3>
        <p class="muted">If the active server can't be reached, Hearth retries with these, in order, and tells you which one answered. Each backup uses its own default model.</p>
        @foreach (var p in _s.Providers.Where(p => p != _s.ActiveProvider))
        {
            var provider = p;
            var on = _s.FallbackProviderIds.Contains(provider.Id);
            <MudSwitch T="bool" Color="Color.Primary" Value="@(on)" ValueChanged="(bool v) => ToggleFallback(provider.Id, v)" Class="check"><span>@provider.Name @if (on) { <span class="badge">#@(_s.FallbackProviderIds.IndexOf(provider.Id) + 1)</span> }
                    @if (string.IsNullOrWhiteSpace(provider.DefaultModel) && provider.Kind != ProviderKind.ClaudeCode) { <span class="muted small"> — set a default model so it knows what to use</span> }</span></MudSwitch>
        }
    </MudPaper>
    <MudPaper Class="card" Elevation="0">
        <h3>Generation</h3>
        <div class="slider-field">
            <span class="field-label">Temperature <b>@_s.Temperature.ToString("0.00")</b></span>
            <MudSlider T="double" @bind-Value="_s.Temperature" Min="0" Max="2" Step="0.05" Color="Color.Primary" Immediate="true" />
        </div>
        <div class="row">
            <MudNumericField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.MaxTokens" Label="Max reply tokens (0 = unlimited)" />
            <MudNumericField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.ContextLength" Label="Context length (Ollama num_ctx, 0 = default)" />
        </div>
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.ContinueCutOffReplies" Class="check" Label="Continue replies that hit the length limit (up to twice) instead of stopping mid-sentence" />
        <MudSelect Label="Check answers against their sources" HelperText="The model re-reads its answer against what the tools returned and fixes anything unsupported before you see it. One or two extra turns." Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_s.CheckAnswers">
                <MudSelectItem Value="@(AnswerCheck.AfterResearch)">After research (web pages, documents, email)</MudSelectItem>
                <MudSelectItem Value="@(AnswerCheck.AnyTools)">After any tool use</MudSelectItem>
                <MudSelectItem Value="@(AnswerCheck.Off)">Off</MudSelectItem>
            </MudSelect>
        <MudSelect Label="Default personality" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_s.DefaultPersonaId">
                @foreach (var p in Personas.All)
                {
                    <MudSelectItem Value="@(p.Id)">@p.Emoji @p.Name — @p.Description</MudSelectItem>
                }
            </MudSelect>
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" @bind-Value="_s.CustomSystemPrompt" Placeholder="e.g. I'm a C# developer. Prefer metric units." Label="Custom instructions (added to every system prompt)" />
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="5" Value="@(_soul)" ValueChanged="Ev.Change<string>(SaveSoul)" T="string" Placeholder="How Hearth and your bots should sound, e.g. Direct and warm. Short answers first, details after. No filler or flattery. Light humour is fine." Label="Personality (SOUL.md)" HelperText="Every bot follows this voice on top of its own role. Saved as SOUL.md in Hearth's data folder (the same file other agents like Hermes and OpenClaw use). Saved as you leave the box." />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.ShowThinking" Class="check" Label="Show thinking from reasoning models" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.AutoTitle" Class="check" Label="Auto-name chats with the model" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.TakeInitiative" Class="check" Label="Bots take initiative" />
        <p class="muted small">Bots act on clear next steps instead of asking first, schedule their own follow-ups (they come back to the chat later with what they found) and hand big jobs to background tasks. Anything that changes things still follows your Permissions.</p>
    </MudPaper>
    }
    @if (Show("models"))
    {
    <ModelRoutingCard />
    }
    @if (Show("web"))
    {
    <MudPaper Class="card" Elevation="0">
        <h3>DeepSearch (optional)</h3>
        <p class="muted">Point at a self-hosted <a href="https://docs.searxng.org" target="_blank" rel="noopener">SearXNG</a> instance with the JSON format enabled. Searches go to your instance, not to a third-party API.</p>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_s.SearxngUrl" Placeholder="http://localhost:8080" />
            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.SearchResultCount" Style="width:5rem" Label="Results" />
        </div>
    </MudPaper>
    <MudPaper Class="card" Elevation="0">
        <h3>Image generation</h3>
        <p class="muted">Use your local Stable Diffusion server. Then ask for a picture, or type <code>/imagine a red fox in snow</code>.</p>
        <div class="row">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_s.ImageGen.Backend">
                <MudSelectItem Value="@(ImageBackend.None)">Off</MudSelectItem>
                <MudSelectItem Value="@(ImageBackend.Automatic1111)">AUTOMATIC1111 / Forge</MudSelectItem>
                <MudSelectItem Value="@(ImageBackend.ComfyUI)">ComfyUI</MudSelectItem>
            </MudSelect>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_s.ImageGen.Url" Placeholder="http://localhost:7860 or http://localhost:8188" />
        </div>
        @if (_s.ImageGen.Backend != ImageBackend.None)
        {
            <div class="row">
                <input class="grow" @bind="_s.ImageGen.Model" list="img-models" placeholder="@(_s.ImageGen.Backend == ImageBackend.ComfyUI ? "Checkpoint (required), e.g. sd_xl_base_1.0.safetensors" : "Checkpoint (optional)")" />
                <datalist id="img-models">
                    @foreach (var m in _imageModels) { <option value="@m"></option> }
                </datalist>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadImageModels">Test & list models</MudButton>
            </div>
            <div class="row">
                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.ImageGen.Width" Style="width:6rem" Label="Width" />
                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.ImageGen.Height" Style="width:6rem" Label="Height" />
                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.ImageGen.Steps" Style="width:5rem" Label="Steps" />
                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.ImageGen.CfgScale" Style="width:5rem" Label="CFG" />
            </div>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.ImageGen.NegativePrompt" Label="Negative prompt" />
            @if (_imageTest is not null) { <div class="@(_imageTest.StartsWith("✓") ? "ok-text" : "error-box")">@_imageTest</div> }
        }
    </MudPaper>
    }
    @if (Show("appearance"))
    {
    <ThemeCard />
    }
    @if (Show("voice"))
    {
    <MudPaper Class="card" Elevation="0">
        <h3>Voice</h3>
        <p class="muted">
            🎙 Dictation uses your device's speech recognition when available@(Platform.IsMobile ? " (on-device)" : "").
            Point it at a Whisper server for private, high-quality transcription everywhere. 🔊 Read-aloud uses system voices or a TTS server.
        </p>
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Voice.Language" Placeholder="en-US" Style="width:8rem" Label="Language" />
        <div class="row">
            <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Voice.SttUrl" Placeholder="http://localhost:8000 (speaches / faster-whisper-server)" Label="Speech-to-text server (OpenAI-compatible, optional)" />
            <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Voice.SttModel" Label="STT model" />
        </div>
        <div class="row">
            <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Voice.TtsUrl" Placeholder="http://localhost:8880 (Kokoro-FastAPI)" Label="Text-to-speech server (OpenAI-compatible, optional)" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Voice.TtsModel" Style="width:8rem" Label="TTS model" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_s.Voice.TtsVoice" Style="width:8rem" Label="Voice" />
        </div>
        <div class="row">
            <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_s.Voice.AutoReadAloud" Class="check grow" Label="Read replies aloud automatically" />
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="TestVoice">🔊 Test voice</MudButton>
        </div>
        @if (_voiceTest is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_voiceTest</MudAlert> }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Voice memos and recordings</h3>
        <p class="muted small">Drop an audio file into a chat, or send a voice note in Telegram, and Hearth transcribes it, then the bot summarizes it and lists action items. Uses the speech-to-text server above when set, otherwise whisper.cpp on this computer (private and offline).</p>
        <div class="row">
            <span class="grow small">@(_transcription is { } t ? (t.ready ? "✅ Ready: " : "⚠ Not set up: ") + t.how : "Checking…")</span>
            @if (_transcription is { ready: false })
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SetUpTranscription" Disabled="@(_settingUp is not null)">@(_settingUp ?? "Set up local transcription")</MudButton>
            }
        </div>
        <span class="muted small">Setting up installs whisper.cpp with Homebrew and downloads an English speech model (about 148 MB) into Hearth's data folder.</span>
    </MudPaper>
    }
    @if (Show("accounts"))
    {
    <AccountsCard />
    }
    @if (Show("daily"))
    {
    <BriefingCard />
    <CheckInCard />
    <SelfCheckCard />
    }
    @if (Show("data"))
    {
    <MudPaper Class="card danger" Elevation="0">
        <h3>Data</h3>
        <p class="muted">Chats are stored as JSON files on this device.</p>
        @if (_confirmDelete)
        {
            <div class="row">
                <span>Delete all chats permanently?</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAll">Yes, delete</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _confirmDelete = false">Cancel</MudButton>
            </div>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => _confirmDelete = true">Delete all chats</MudButton>
        }
    </MudPaper>
    }
</div>
}

@code {
    private static void SetExtraKeys(ProviderProfile provider, string? text)
    {
        var keys = (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct().ToList();
        if (keys.Count > 0) provider.ExtraApiKeys = keys;
    }

    private string _soul = "";

    private async Task SaveSoul(ChangeEventArgs e)
    {
        _soul = e.Value?.ToString() ?? "";
        await Soul.SaveSoulAsync(_soul);
    }

    private string _tab = "models";

    private IReadOnlyList<TabBar.Item> SettingsTabs =>
    [
        new("models", "Models", "server"), new("web", "Web and images", "globe"), new("appearance", "Appearance", "palette"),
        new("voice", "Voice", "mic"), new("daily", "Daily", "clock"), new("data", "Data", "hard-drive-download"),
        .. Services.GetService<AccountStore>() is null ? Array.Empty<TabBar.Item>() : [new("accounts", "Accounts", "users")],
    ];

    // Search: while there's a query every tab's cards are shown and hearth.js hides the ones that don't match.
    private string _query = "";
    private ElementReference _container;
    private int? _matches;
    private string? _searched;
    private DotNetObjectReference<Settings>? _self;
    private bool Searching => !string.IsNullOrWhiteSpace(_query);
    private bool Show(string tab) => tab == "accounts" && Services.GetService<AccountStore>() is null ? false : Searching || _tab == tab;

    private void QueryChanged() { if (!Searching) _matches = null; }
    private void ClearSearch() { _query = ""; _matches = null; }
    private void SearchKey(KeyboardEventArgs e) { if (e.Key == "Escape") ClearSearch(); }

    [JSInvokable]
    public void SearchCountChanged(int count)
    {
        if (!Searching || _matches == count) return;
        _matches = count;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var query = Searching ? _query.Trim() : "";
        if (query == (_searched ?? "")) return;
        _searched = query;
        try
        {
            if (query.Length == 0) { await JS.InvokeVoidAsync("hearth.stopSettingsSearch"); return; }
            _self ??= DotNetObjectReference.Create(this);
            var count = await JS.InvokeAsync<int>("hearth.searchSettings", _container, query, _self);
            if (count != _matches && query == _searched) { _matches = count; StateHasChanged(); }
        }
        catch (JSDisconnectedException) { }
    }

    public override void Dispose()
    {
        base.Dispose();
        _ = StopSearch();
        _self?.Dispose();
    }

    private async Task StopSearch()
    {
        try { await JS.InvokeVoidAsync("hearth.stopSettingsSearch"); } catch { /* page already gone */ }
    }

    private AppSettings? _s;
    private bool _saved;
    private bool _confirmDelete;
    private readonly Dictionary<string, (bool ok, string msg)> _tests = [];

    private (bool ready, string how)? _transcription;
    private string? _settingUp;

    private async Task SetUpTranscription()
    {
        try
        {
            var progress = new Progress<string>(m => { _settingUp = m; InvokeAsync(StateHasChanged); });
            _settingUp = "Starting…";
            await Transcriber.SetUpLocalAsync(HttpFactory, progress, CancellationToken.None);
        }
        catch (Exception ex) { _voiceTest = ex.Message; }
        finally
        {
            _settingUp = null;
            _transcription = await Transcriber.StatusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _transcription = await Transcriber.StatusAsync();
        _s = SettingsCopy.Of(await Store.GetAsync());
        _s.ActiveProviderId ??= _s.ActiveProvider.Id;
        _soul = await Soul.SoulAsync() ?? "";
    }

    private void Add(ProviderKind kind, string name, string url)
        => _s!.Providers.Add(new ProviderProfile { Kind = kind, Name = name, BaseUrl = url });

    private List<string> _imageModels = [];
    private string? _imageTest;
    private string? _voiceTest;

    private async Task LoadImageModels()
    {
        try
        {
            _imageModels = await ImageGen.ListModelsAsync(_s!.ImageGen, CancellationToken.None);
            _imageTest = $"✓ Connected, {_imageModels.Count} checkpoint(s)";
            if (string.IsNullOrWhiteSpace(_s.ImageGen.Model) && _imageModels.Count > 0) _s.ImageGen.Model = _imageModels[0];
        }
        catch (Exception ex) { _imageTest = ex.Message; }
    }

    private async Task TestVoice()
    {
        _voiceTest = null;
        try { await SpeechOut.SpeakAsync(_s!, "Hi! This is how I sound when I read replies aloud."); }
        catch (Exception ex) { _voiceTest = ex.Message; }
    }

    private void AddOllama() => Add(ProviderKind.Ollama, "Ollama", "http://localhost:11434");
    private void AddLmStudio() => Add(ProviderKind.OpenAICompatible, "LM Studio", "http://localhost:1234/v1");
    private void AddLlamaCpp() => Add(ProviderKind.OpenAICompatible, "llama.cpp", "http://localhost:8080/v1");
    private void AddClaudeCode() => Add(ProviderKind.ClaudeCode, "Claude Code", "");
    private void AddClaudeApi() => Add(ProviderKind.Anthropic, "Claude API", "https://api.anthropic.com");
