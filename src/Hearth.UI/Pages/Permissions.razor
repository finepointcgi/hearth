@page "/permissions"
@inherits StatefulComponent
@inject SettingsStore Store
@inject ActivityLog Activity
@inject McpManager Mcp

<header class="topbar">
    <MudIconButton Size="Size.Small" Class="only-mobile" title="Menu" aria-label="Menu" OnClick="OpenSidebar"><Icon Name="panel-left" /></MudIconButton>
    <h2 class="topbar-title">Permissions</h2>
    <span class="spacer"></span>
    @if (_saved) { <span class="ok-text">Saved ✓</span> }
</header>

<div class="settings">
    <MudPaper Class="card" Elevation="0">
        <p class="muted">
            What every bot may do, per area. <b>Allow</b> runs without asking, <b>Ask</b> waits for your OK (here, in the chat,
            on the Today page or in Telegram), <b>Block</b> hides it from bots entirely. <b>Default</b> keeps each feature's own
            setting — reading runs, changes ask. Each bot's ability switches still apply on top.
        </p>
        <div class="perm-grid">
            <div class="perm-head"><span></span><span>Reading</span><span>Changing things</span></div>
            @foreach (var a in Areas())
            {
                var area = a;
                <div class="perm-row">
                    <span><span class="tool-icon">@area.Icon</span> <b>@area.Title</b></span>
                    @foreach (var write in new[] { false, true })
                    {
                        var w = write;
                        var label = w ? area.Write : area.Read;
                        @if (label is null) { <span class="muted small">—</span> }
                        else
                        {
                            <label class="perm-cell" title="@label">
                                <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(Level(area.Key, w).ToString())" ValueChanged="(string v) => Set(area.Key, w, v)" Class="@Level(area.Key, w).ToString().ToLowerInvariant()" T="string">
                                    <MudSelectItem Value="@("Default")">Default</MudSelectItem>
                                    <MudSelectItem Value="@("Allow")">Allow</MudSelectItem>
                                    <MudSelectItem Value="@("Ask")">Ask</MudSelectItem>
                                    <MudSelectItem Value="@("Block")">Block</MudSelectItem>
                                </MudSelect>
                                <span class="muted small">@label</span>
                            </label>
                        }
                    }
                </div>
            }
        </div>
        <MudSwitch T="bool" Color="Color.Primary" Value="@(State.Settings.Tools.GuardUntrustedContent)" ValueChanged="Ev.Change<bool>(ToggleGuard)" Class="check"><span><b>Guard against hidden instructions</b> — after a bot reads web pages, email, shared files or another bot's reply, it asks
            before anything that changes things (sending, writing, running code, saving memories or skills), even where it normally
            wouldn't. Areas set to <b>Allow</b> above still run; routines and tasks with no one to ask skip those actions.</span></MudSwitch>
        <div class="row">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="Careful">Careful preset: ask before every change</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="Reset">Reset all to Default</MudButton>
        </div>
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>Always allowed</h3>
        <p class="muted small">Tools you chose "Always allow" for on an approval card. These run without asking for that bot only, even after it has read web pages or email.</p>
        @foreach (var (who, tools) in _s.AlwaysAllow.Where(kv => kv.Value.Count > 0).ToList())
        {
            var whoKey = who;
            var name = whoKey == Bot.PlainId ? "💬 Hearth" : State.BotById(whoKey) is { } b ? $"{b.Emoji} {b.Name}" : "(a deleted bot)";
            @foreach (var t in tools.ToList())
            {
                var tool = t;
                <div class="memory-row">
                    <span class="grow"><b>@name</b> may run <code>@tool</code> without asking</span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Forget(whoKey, tool)">Ask again</MudButton>
                </div>
            }
        }
        @if (!_s.AlwaysAllow.Any(kv => kv.Value.Count > 0)) { <p class="muted small">Nothing yet.</p> }
    </MudPaper>

    <MudPaper Class="card" Elevation="0">
        <h3>What bots did</h3>
        <div class="row">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_botFilter">
                <MudSelectItem Value="@("")">All bots</MudSelectItem>
                <MudSelectItem Value="@(Bot.PlainId)">Hearth (no bot)</MudSelectItem>
                @foreach (var b in State.Bots) { <MudSelectItem Value="@(b.Id)">@b.Emoji @b.Name</MudSelectItem> }
            </MudSelect>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_search" Immediate="true" Placeholder="Search actions, e.g. gmail_send or a file name" />
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_days">
                <MudSelectItem Value="@("1")">Today</MudSelectItem>
                <MudSelectItem Value="@("7")">7 days</MudSelectItem>
                <MudSelectItem Value="@("30")">30 days</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="LoadAsync">↻</MudButton>
        </div>
        @foreach (var a in Filtered().Take(200))
        {
            <div class="activity @(a.Ok ? "" : "bad")">
                <span class="when">@a.Time.ToString(_days == "1" ? "h:mm tt" : "MMM d h:mm")</span>
                <span class="kind">@(a.Kind == ActivityKind.Approval ? "✅" : "⚙️")</span>
                <span class="grow">
                    @if (a.ConversationId is not null) { <a href="c/@a.ConversationId">@a.Title</a> } else { @a.Title }
                    @if (a.Detail is not null) { <code class="audit">@a.Detail</code> }
                </span>
            </div>
        }
        @if (!Filtered().Any()) { <p class="muted">No actions in this period.</p> }
    </MudPaper>
</div>

@code {
    private AppSettings? _s;
    private bool _saved;
    private List<Activity> _log = [];
    private string _botFilter = "";
    private string _search = "";
    private string _days = "7";

    private IEnumerable<PermissionCatalog.Area> Areas()
    {
        foreach (var a in PermissionCatalog.Areas) yield return a;
        foreach (var m in State.Settings.McpServers)
            yield return new("mcp:" + m.Name, "🔌", "MCP · " + m.Name, "Read-only tools", "Tools that change things");
    }

    protected override async Task OnInitializedAsync()
    {
        _s = SettingsCopy.Of(await Store.GetAsync());
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var days = int.TryParse(_days, out var d) ? d : 7;
        _log = (await Activity.SinceAsync(new DateTimeOffset(DateTime.Today.AddDays(1 - days))))
            .Where(a => a.Kind is ActivityKind.Tool or ActivityKind.Approval).ToList();
    }

    private IEnumerable<Activity> Filtered() => _log.Where(a =>
        (_botFilter == "" || (_botFilter == Bot.PlainId ? a.BotId is null : a.BotId == _botFilter)) &&
        (_search == "" || a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || (a.Detail ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private PermissionLevel Level(string area, bool write) =>
        _s!.Permissions.GetValueOrDefault(PermissionCatalog.Key(area, write), PermissionLevel.Default);

    private async Task Set(string area, bool write, string? value)
    {
        var key = PermissionCatalog.Key(area, write);
        var level = Enum.TryParse<PermissionLevel>(value, out var l) ? l : PermissionLevel.Default;
        if (level == PermissionLevel.Default) _s!.Permissions.Remove(key); else _s!.Permissions[key] = level;
        await SaveAsync();
    }

    private async Task ToggleGuard(ChangeEventArgs e)
    {
        var s = await Store.GetAsync();
        s.Tools.GuardUntrustedContent = (bool)e.Value!;
        await Store.SaveAsync(s);
    }

    private async Task Careful()
    {
        foreach (var a in Areas().Where(a => a.Write is not null)) _s!.Permissions[PermissionCatalog.Key(a.Key, true)] = PermissionLevel.Ask;
        await SaveAsync();
    }

    private async Task Reset()
    {
        _s!.Permissions.Clear();
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        var current = SettingsCopy.Of(await Store.GetAsync());
        current.Permissions = new(_s!.Permissions);
        await Store.SaveAsync(current);
        _saved = true;
        StateHasChanged();
        await Task.Delay(1200);
        _saved = false;
    }

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    private async Task Forget(string who, string tool)
    {
        var s = await Store.GetAsync();
        if (s.AlwaysAllow.TryGetValue(who, out var list)) list.Remove(tool);
        await Store.SaveAsync(s);
        _s = SettingsCopy.Of(s);
    }
}
