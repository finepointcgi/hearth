@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject NavigationManager Nav
@inject SettingsStore SettingsStore
@inject IJSRuntime JS

<div class="shell @(State.SidebarOpen ? "sidebar-open" : "")">
    <NavRail />
    <Sidebar />
    <div class="scrim" @onclick="CloseSidebar"></div>
    <main class="main">
        @* A page that breaks shows its error here instead of taking the whole app (menus, sidebar) down with it. *@
        <ErrorBoundary @ref="_boundary">
            <ChildContent>@Body</ChildContent>
            <ErrorContent Context="ex">
                <div class="error-box page-error">
                    <b>Something on this page broke.</b> @ex.Message
                    <button class="btn small" @onclick="Recover">Try again</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _boundary;

    private void Recover() => _boundary?.Recover();

    // Going to another page clears an error shown for the last one.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(() => _boundary?.Recover());

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        await State.EnsureInitializedAsync();
        // First run: walk through setup. Installs already in use are marked as set up.
        var settings = await SettingsStore.GetAsync();
        if (!settings.SetupDone)
        {
            if (State.Bots.Count > 0 || State.Conversations.Count > 0)
            {
                settings.SetupDone = true;
                await SettingsStore.SaveAsync(settings);
            }
            else if (!Nav.Uri.Contains("/welcome")) Nav.NavigateTo("welcome");
        }
    }

    // The theme from settings (Settings → Appearance), re-applied whenever it changes, here or on another device.
    private string? _themeKey;
    private bool _themeChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            // From the store (not State.Settings, which may still be loading on the first render).
            var theme = (await SettingsStore.GetAsync()).Theme;
            var checkLegacy = !_themeChecked;
            _themeChecked = true;
            if (checkLegacy && !theme.Chosen && await JS.InvokeAsync<string>("hearth.legacyTheme") is var old && old is "light" or "dark")
            {
                // Carry over the light/dark choice older versions kept on this device.
                var settings = await SettingsStore.GetAsync();
                settings.Theme.Mode = old;
                settings.Theme.Chosen = true;
                await SettingsStore.SaveAsync(settings);
                theme = settings.Theme;
            }
            var key = ThemeCatalog.Key(theme);
            if (key == _themeKey) return;
            _themeKey = key;
            await JS.InvokeVoidAsync("hearth.applyTheme", ThemeCatalog.ForJs(theme));
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* prerendering */ }
    }

    private void CloseSidebar() { State.SidebarOpen = false; State.NotifyChanged(); }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() { State.Changed -= OnChanged; Nav.LocationChanged -= OnLocationChanged; }
}
