@implements IDisposable
@inject NavigationManager Nav
@inject ApprovalCenter Approvals
@inject CodeTools Code

<nav class="rail" aria-label="Sections">
    <a class="rail-logo" href="" title="Hearth" aria-label="Hearth home">H</a>
    @foreach (var s in ShellSections.All.Where(s => s.Id != "settings" && (s.Id != "code" || Code.Available)))
    {
        @Item(s)
    }
    @* Settings sits at the bottom of the rail (on phones it stays last in the bottom bar). *@
    <span class="rail-spacer"></span>
    @foreach (var s in ShellSections.All.Where(s => s.Id == "settings"))
    {
        @Item(s)
    }
</nav>

@code {
    private RenderFragment Item(ShellSection section) => @<a class="rail-item @(ShellSections.Current(Nav) == section.Id ? "active" : "")" href="@section.Href" title="@section.Title" aria-label="@section.Title">
        <Icon Name="@section.Icon" Size="20" />
        <span class="rail-label">@section.Title</span>
        @if (section.Id == "inbox" && Approvals.Pending.Count > 0)
        {
            <span class="rail-badge" title="Waiting on you">@Approvals.Pending.Count</span>
        }
    </a>;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnChange;
        Approvals.Requested += OnApproval;
        Approvals.Resolved += OnResolved;
    }

    private void OnChange(object? s, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    private void OnApproval(PendingApproval _) => InvokeAsync(StateHasChanged);
    private void OnResolved(PendingApproval _, bool __) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnChange;
        Approvals.Requested -= OnApproval;
        Approvals.Resolved -= OnResolved;
    }
}
