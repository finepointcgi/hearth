@inject BotInbox Inbox
@inject AppState State

<MudPaper Class="card" Elevation="0">
    <div class="row">
        <span class="conn-logo">📮</span>
        <span class="grow">
            <b>Bot inbox</b><br />
            <span class="muted small">Give a bot its own email address. People you allow can email it, and it replies in the same thread.</span>
        </span>
        @if (_c.Enabled && _c.LastError is null && _c.LastCheck is not null) { <span class="ok-text">● checking every @_c.PollMinutes min</span> }
    </div>
    <details class="steps" open="@(!_c.Enabled)">
        <summary>Setup</summary>
        <p class="muted small">
            Use a separate mailbox for the bot (a new Gmail, Fastmail or iCloud address). For Gmail: turn on 2-Step Verification, create an
            <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener">app password</a>, and use imap.gmail.com / smtp.gmail.com.
        </p>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_c.ImapHost" Placeholder="IMAP server, e.g. imap.gmail.com" />
            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_c.ImapPort" Style="width:6rem" />
        </div>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_c.SmtpHost" Placeholder="SMTP server, e.g. smtp.gmail.com" />
            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_c.SmtpPort" Style="width:6rem" />
        </div>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_c.Username" Placeholder="Mailbox login (usually the email address)" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" InputType="InputType.Password" @bind-Value="_password" Placeholder="@(_c.PasswordSealed is null ? "Password / app password" : "Password (saved — blank keeps it)")" />
        </div>
        <MudSelect Label="Who answers" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_c.BotId">
                <MudSelectItem Value="@("")">💬 Hearth</MudSelectItem>
                @foreach (var b in State.Bots) { <MudSelectItem Value="@(b.Id)">@b.Emoji @b.Name</MudSelectItem> }
            </MudSelect>
        <label>Allowed senders (one per line; use @@yourcompany.com for a whole domain)
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" @bind-Value="Senders" />
        </label>
        <span class="muted small">Mail from anyone else is marked read and ignored. Replies ask you first — change that under 🛡 Permissions → Bot inbox.</span>
    </details>
    <div class="row">
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_c.Enabled" Class="check grow" Label="Check this mailbox" />
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Check" Disabled="@_busy">Check now</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@_busy">Save</MudButton>
    </div>
    @if (_c.LastError is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_c.LastError</MudAlert> }
    @if (_message is not null) { <div class="ok-text">@_message</div> }
</MudPaper>

@code {
    private InboxConfig _c = new();
    private string _password = "";
    private string? _message;
    private bool _busy;

    private string Senders
    {
        get => string.Join(Environment.NewLine, _c.AllowedSenders);
        set => _c.AllowedSenders = (value ?? "").Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        var c = await Inbox.GetAsync();
        _c = System.Text.Json.JsonSerializer.Deserialize<InboxConfig>(System.Text.Json.JsonSerializer.Serialize(c))!;
    }

    private async Task Save()
    {
        _message = null;
        if (_c.AllowedSenders.Count == 0 && _c.Enabled) { _message = null; _c.LastError = "Add at least one allowed sender, so strangers can't email your bot."; return; }
        if (string.IsNullOrEmpty(_c.BotId)) _c.BotId = null;
        var current = await Inbox.GetAsync();
        _c.Threads = current.Threads;
        await Inbox.SaveAsync(_c, _password);
        _password = "";
        _message = "Saved.";
    }

    private async Task Check()
    {
        _busy = true;
        try
        {
            await Save();
            if (_c.LastError?.StartsWith("Add at least") == true) return;
            _message = await Inbox.CheckNowAsync();
            _c.LastError = (await Inbox.GetAsync()).LastError;
        }
        finally { _busy = false; }
    }
}
