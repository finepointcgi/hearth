@implements IDisposable
@inject IBotComputer Computer
@inject SkillTeacher Teacher
@inject AppState State

<MudPaper Class="card" Elevation="0">
    <h3>Teach by showing</h3>
    @if (!Computer.Status.Available)
    {
        <p class="muted">@Computer.Status.UnavailableReason</p>
    }
    else if (!Computer.IsRecording && _steps is null)
    {
        <p class="muted">
            Do a task once in the bot browser while Hearth watches — searching a site, filling a form, downloading a report —
            and it becomes a skill your bots can repeat. Typed passwords are never recorded.
        </p>
        <div class="row">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_profile" title="Which browser to record in (uses its sign-ins)">
                <MudSelectItem Value="@("shared")">Shared browser</MudSelectItem>
                @foreach (var b in State.Bots.Where(b => b.Abilities.BrowserProfile == BrowserProfile.Own))
                {
                    <MudSelectItem Value="@(b.Id)">@b.Emoji @b.Name's browser</MudSelectItem>
                }
            </MudSelect>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_startUrl" Placeholder="Start page, e.g. https://news.ycombinator.com (optional)" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Start" Disabled="@_busy">● Start recording</MudButton>
        </div>
    }
    else if (Computer.IsRecording)
    {
        <div class="recording">
            <span class="rec-dot"></span> Recording in the browser window on this computer — do the task, then come back and click Stop.
        </div>
        <ol class="steps-live">
            @foreach (var s in Computer.RecordedSteps) { <li>@s.Describe()</li> }
        </ol>
        @if (Computer.RecordedSteps.Count == 0) { <p class="muted small">Waiting for your first click…</p> }
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Stop">■ Stop recording</MudButton>
    }
    else if (_steps is not null)
    {
        <p class="muted">Remove any steps that were mistakes, then name the skill.</p>
        <ol class="steps-live">
            @foreach (var s in _steps.ToList())
            {
                var step = s;
                <li>@step.Describe() <MudIconButton Size="Size.Small" title="Remove step" OnClick="() => _steps.Remove(step)">✕</MudIconButton></li>
            }
        </ol>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_name" Placeholder="Skill name, e.g. check-flight-prices" />
        </div>
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_description" Placeholder="What it's for (bots read this), e.g. Look up the cheapest flight on Google Flights for given cities and dates" />
        <div class="row end">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => _steps = null">Discard</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Create" Disabled="@(_busy || _steps.Count == 0 || string.IsNullOrWhiteSpace(_name))">
                @(_busy ? "Writing the skill…" : "Create skill")
            </MudButton>
        </div>
    }
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
    @if (_message is not null) { <div class="ok-text">@_message</div> }
</MudPaper>

@code {
    private string _profile = "shared";
    private string _startUrl = "";
    private string _name = "";
    private string _description = "";
    private List<RecordedStep>? _steps;
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override void OnInitialized() => Computer.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Start()
    {
        _error = _message = null;
        _busy = true;
        try { await Computer.StartRecordingAsync(_profile, _startUrl); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Stop()
    {
        _steps = await Computer.StopRecordingAsync();
    }

    private async Task Create()
    {
        _error = null;
        _busy = true;
        try
        {
            var skill = await Teacher.CreateAsync(_name, _description, _steps!);
            _message = $"Created /{skill.Name}. Bots can use it now — or type /{skill.Name} in a chat.";
            _steps = null;
            _name = _description = "";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    public void Dispose() => Computer.Changed -= OnChanged;
}
