@using QRCoder
@inject SettingsStore Settings
@inject PushNotifier Notifier

<MudPaper Class="card" Elevation="0">
    <div class="row">
        <span class="conn-logo"><Icon Name="bell-ring" Size="20" /></span>
        <span class="grow"><b>Phone notifications</b><br />
            <span class="muted small">Approvals, heartbeat alerts and finished tasks, straight to your phone with the free ntfy app. Works even if Telegram is down.</span></span>
        <MudSwitch T="bool" Color="Color.Primary" role="switch" Value="@(_s.Enabled)" ValueChanged="(bool v) => Change(s => s.Enabled = v)" Class="check"></MudSwitch>
    </div>

    <details class="steps" open="@(!_s.Enabled)">
        <summary>Set up</summary>
        <ol>
            <li>Install <b>ntfy</b> on your phone (<a href="https://apps.apple.com/app/ntfy/id1625396347" target="_blank" rel="noopener">iPhone</a> ·
                <a href="https://play.google.com/store/apps/details?id=io.heckel.ntfy" target="_blank" rel="noopener">Android</a>).</li>
            <li>Subscribe to your topic: scan the code, or add <code>@_s.Topic</code> in the app (server <code>@_s.Server</code>).</li>
            <li>Turn on the switch above and send a test.</li>
        </ol>
        <div class="row">
            <div class="qr small-qr">@((MarkupString)Qr($"{_s.Server.TrimEnd('/')}/{_s.Topic}"))</div>
            <div class="grow" style="display:flex;flex-direction:column;gap:.5rem">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_server" @bind-Value:after="SaveServer" Placeholder="https://ntfy.sh or your own ntfy server" Label="Server" />
                <label>Topic (keep it secret: anyone who knows it can read your notifications)
                    <span class="row"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" Value="@(_s.Topic)" ReadOnly="true" /><MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="NewTopic">New topic</MudButton></span></label>
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_open" @bind-Value:after="SaveOpen" Placeholder="https://my-mac.tailnet.ts.net or http://192.168.1.20:5290" Label="Open Hearth at (when you tap a notification)" />
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" @bind-Value="_token" @bind-Value:after="SaveToken" Placeholder="@(_s.Token is null ? "none" : "saved — type to replace")" Label="Access token (only for a protected self-hosted server)" />
            </div>
        </div>
        <span class="muted small">ntfy.sh is a free public server; for full privacy run your own (<code>docker compose --profile ntfy up -d</code>) and point the server field at it.</span>
    </details>

    <div class="option-grid">
        @Toggle("Approvals waiting on you", _s.Approvals, v => _s.Approvals = v)
        @Toggle("Heartbeat alerts", _s.Heartbeat, v => _s.Heartbeat = v)
        @Toggle("Task milestones", _s.Tasks, v => _s.Tasks = v)
        @Toggle("Bots following up", _s.FollowUps, v => _s.FollowUps = v)
        @Toggle("Routine results", _s.Routines, v => _s.Routines = v)
        @Toggle("Problems (like a channel that can't connect)", _s.Problems, v => _s.Problems = v)
        @Toggle("What Hearth learned this week (the weekly recap)", _s.Recap, v => _s.Recap = v)
        @Toggle("Include details (otherwise just a title)", _s.IncludeDetails, v => _s.IncludeDetails = v)
    </div>
    <div class="row end">
        @if (_message is not null) { <span class="@(_ok ? "ok-text" : "tiny-error")">@_message</span> }
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Test" Disabled="@_busy">Send test</MudButton>
    </div>
</MudPaper>

@code {
    private NotificationSettings _s = new();
    private string _server = "", _open = "", _token = "";
    private string? _message;
    private bool _ok, _busy;

    protected override async Task OnInitializedAsync()
    {
        _s = (await Settings.GetAsync()).Notifications;
        _server = _s.Server;
        _open = _s.OpenUrl ?? "";
    }

    private RenderFragment Toggle(string label, bool value, Action<bool> set) => __builder =>
    {
        <label class="option-row">
            <span class="grow-text">@label</span>
            <input type="checkbox" class="switch" role="switch" checked="@value" @onchange="e => Change(_ => set((bool)e.Value!))" />
        </label>
    };

    private async Task Change(Action<NotificationSettings> change)
    {
        var settings = await Settings.GetAsync();
        change(settings.Notifications);
        await Settings.SaveAsync(settings);
        _s = settings.Notifications;
    }

    private Task SaveServer() => Change(s => s.Server = string.IsNullOrWhiteSpace(_server) ? "https://ntfy.sh" : _server.Trim().TrimEnd('/'));
    private Task SaveOpen() => Change(s => s.OpenUrl = string.IsNullOrWhiteSpace(_open) ? null : _open.Trim());
    private async Task SaveToken()
    {
        if (string.IsNullOrWhiteSpace(_token)) return;
        await Change(s => s.Token = _token.Trim());
        _token = "";
    }
    private Task NewTopic() => Change(s => s.Topic = NotificationSettings.NewTopic());

    private async Task Test()
    {
        _busy = true;
        var problem = await Notifier.SendAsync(_s, "Hearth test", "Notifications from Hearth work.", "white_check_mark");
        _busy = false;
        _ok = problem is null;
        _message = problem ?? "Sent. Check your phone.";
    }

    private static string Qr(string text)
    {
        using var gen = new QRCodeGenerator();
        using var data = gen.CreateQrCode(text, QRCodeGenerator.ECCLevel.M);
        return new SvgQRCode(data).GetGraphic(3, "#0a0a0a", "#ffffff", drawQuietZones: true);
    }
}
