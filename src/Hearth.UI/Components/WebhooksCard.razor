@inject SettingsStore Settings
@inject EventWebhooks Hooks

<section class="card">
    <div class="row">
        <span class="conn-logo"><Icon Name="zap" Size="20" /></span>
        <span class="grow"><b>Outgoing webhooks</b><br />
            <span class="muted small">Hearth calls your URL when something happens: a bot needs your OK, the heartbeat finds something, a task or routine moves on, a bot follows up, or something breaks. Works with Home Assistant, n8n, Zapier or your own scripts.</span></span>
    </div>
    @foreach (var h in _hooks)
    {
        var hook = h;
        <div class="sub">
            <div class="row">
                <input @bind="hook.Name" @bind:after="Save" style="width:9rem" placeholder="Name" />
                <input class="grow" @bind="hook.Url" @bind:after="Save" placeholder="https://… (receives a JSON POST)" />
                <label class="check"><input type="checkbox" class="switch" role="switch" @bind="hook.Enabled" @bind:after="Save" /></label>
                <button class="icon-btn" title="Remove webhook" aria-label="Remove webhook" @onclick="() => Remove(hook)"><Icon Name="trash-2" Size="15" /></button>
            </div>
            <div class="row small">
                @foreach (var (key, label) in EventWebhooks.Events)
                {
                    var k = key;
                    <label class="check"><input type="checkbox" checked="@(hook.Events.Count == 0 || hook.Events.Contains(k))" @onchange="e => ToggleEvent(hook, k, (bool)e.Value!)" /> @label</label>
                }
            </div>
            <div class="row">
                <input class="grow" type="password" autocomplete="off" @bind="_secrets[hook.Id]" @bind:after="() => SaveSecret(hook)"
                       placeholder="@(string.IsNullOrEmpty(hook.Secret) ? "Signing secret (optional): adds X-Hearth-Signature: sha256=HMAC" : "Secret saved — type to replace")" />
                <button class="btn ghost small" @onclick="() => Test(hook)" disabled="@string.IsNullOrWhiteSpace(hook.Url)">Send test</button>
            </div>
            @if (Hooks.LastResult.TryGetValue(hook.Id, out var last)) { <div class="muted small">Last: @last</div> }
        </div>
    }
    <button class="btn ghost" @onclick="Add">Add webhook</button>
    <details class="advanced">
        <summary>What gets sent</summary>
        <pre class="small">POST your-url   (Content-Type: application/json, X-Hearth-Event: task)
{ "event": "task", "title": "Task: …", "text": "🏁 Done: …", "conversationId": "…",
  "link": "https://…/c/…", "at": "2026-11-05T09:30:00-05:00", "taskId": "…", "state": "Done" }</pre>
    </details>
</section>

@code {
    private List<OutgoingWebhook> _hooks = [];
    private readonly Dictionary<string, string> _secrets = [];

    protected override async Task OnInitializedAsync()
    {
        _hooks = (await Settings.GetAsync()).Webhooks;
        foreach (var h in _hooks) _secrets[h.Id] = "";
    }

    private async Task Save()
    {
        var s = await Settings.GetAsync();
        s.Webhooks = _hooks;
        await Settings.SaveAsync(s);
    }

    private async Task Add()
    {
        var hook = new OutgoingWebhook { Name = $"Webhook {_hooks.Count + 1}" };
        _hooks.Add(hook);
        _secrets[hook.Id] = "";
        await Save();
    }

    private async Task Remove(OutgoingWebhook hook)
    {
        _hooks.Remove(hook);
        await Save();
    }

    private async Task ToggleEvent(OutgoingWebhook hook, string ev, bool on)
    {
        if (hook.Events.Count == 0) hook.Events = EventWebhooks.Events.Select(e => e.key).ToList();
        if (on && !hook.Events.Contains(ev)) hook.Events.Add(ev);
        if (!on) hook.Events.Remove(ev);
        if (hook.Events.Count == EventWebhooks.Events.Length) hook.Events.Clear(); // all = empty list
        await Save();
    }

    private async Task SaveSecret(OutgoingWebhook hook)
    {
        if (string.IsNullOrWhiteSpace(_secrets[hook.Id])) return;
        hook.Secret = _secrets[hook.Id].Trim();
        _secrets[hook.Id] = "";
        await Save();
    }

    private async Task Test(OutgoingWebhook hook)
    {
        var body = System.Text.Json.JsonSerializer.Serialize(new { @event = "test", title = "Test from Hearth", text = "If you can read this, the webhook works.", at = DateTimeOffset.Now });
        await Hooks.SendAsync(hook, "test", body);
    }
}
