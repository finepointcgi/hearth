@using Hearth.Core.Services.Microsoft
@implements IDisposable
@inject MicrosoftAuth Auth

<MudPaper Class="card" Elevation="0">
    <div class="row">
        <span class="conn-logo">🪟</span>
        <span class="grow">
            <b>Microsoft 365</b><br />
            <span class="muted small">Outlook mail and calendar, OneDrive files, Word and Excel, and To Do. Reading runs on its own; drafts, files, events and spreadsheet edits ask first, and sending email always asks.</span>
        </span>
        @if (_conn.Connected) { <span class="ok-text">● @(_conn.Account ?? "connected")</span> }
    </div>

    @if (_conn.Connected)
    {
        <p class="muted small">Turn it on for each bot under Bots → (bot) → Abilities → Microsoft 365. Chats without a bot can always use it.</p>
        <div class="row end"><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Disconnect">Disconnect</MudButton></div>
    }
    else
    {
        <details class="steps" open="@(string.IsNullOrWhiteSpace(_clientId))">
            <summary>Setup (once, about 5 minutes)</summary>
            <ol>
                <li>Open <a href="https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank" rel="noopener">Microsoft Entra → App registrations</a> (sign in with the Microsoft account you'll connect) and choose <b>New registration</b>.</li>
                <li>Name it <b>Hearth</b>. Supported account types: <b>Accounts in any organizational directory and personal Microsoft accounts</b>. Leave Redirect URI empty. Register.</li>
                <li>Open <b>Authentication</b>, set <b>Allow public client flows</b> to <b>Yes</b>, and save.</li>
                <li>On the <b>Overview</b> page copy the <b>Application (client) ID</b> and paste it below.</li>
            </ol>
            <p class="muted small">A work account's organisation may need an admin to approve the permissions. Personal Microsoft accounts (outlook.com, hotmail) work right away.</p>
        </details>
        <div class="row">
            <MudTextField Class="grow" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_clientId" Placeholder="1a2b3c4d-…" Label="Application (client) ID" />
            <MudSelect Label="Accounts" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_tenant">
                    <MudSelectItem Value="@("common")">Work or personal</MudSelectItem>
                    <MudSelectItem Value="@("consumers")">Personal only</MudSelectItem>
                    <MudSelectItem Value="@("organizations")">Work or school only</MudSelectItem>
                </MudSelect>
        </div>
        @if (_signIn is { } s)
        {
            <div class="device-code">
                <span>Open <a href="@s.VerificationUri" target="_blank" rel="noopener">@s.VerificationUri</a> and enter</span>
                <code class="code-big">@s.UserCode</code>
                <span class="muted small">Waiting for you to finish signing in…</span>
            </div>
        }
        <div class="row end">
            @if (_message is not null) { <span class="muted small grow">@_message</span> }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Connect" Disabled="@(_signIn is not null)">Connect</MudButton>
        </div>
    }
</MudPaper>

@code {
    private MicrosoftConnection _conn = new();
    private string _clientId = "", _tenant = "common";
    private MicrosoftSignIn? _signIn;
    private string? _message;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _conn = await Auth.GetAsync();
        _clientId = _conn.ClientId;
        _tenant = string.IsNullOrWhiteSpace(_conn.Tenant) ? "common" : _conn.Tenant;
    }

    private async Task Connect()
    {
        _message = null;
        try
        {
            _signIn = await Auth.StartSignInAsync(_clientId, _tenant, _cts.Token);
            StateHasChanged();
            var account = await _signIn.Completed;
            _message = $"Connected as {account}.";
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _message = ex.Message; }
        finally
        {
            _signIn = null;
            _conn = await Auth.GetAsync();
        }
    }

    private async Task Disconnect()
    {
        await Auth.DisconnectAsync();
        _conn = await Auth.GetAsync();
        _message = "Disconnected.";
    }

    public void Dispose() => _cts.Cancel();
}
