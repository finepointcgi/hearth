@* Usage: <Icon Name="bot" />  — one of Hearth's cute line icons (CuteIcons); inherits colour; Size in px. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">@((MarkupString)Path(Name))</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? Class { get; set; }

    /// <summary>The SVG markup for an icon name: Hearth's own cute icon if there is one, else the Material rounded fallback.</summary>
    public static string Path(string name) =>
        CuteIcons.All.TryGetValue(name, out var cute) ? cute : Map.TryGetValue(name, out var p) ? p : MudBlazor.Icons.Material.Rounded.HelpOutline;

    /// <summary>Same icon as a MudBlazor icon string (for Icon= / StartIcon= parameters).</summary>
    public static string Mud(string name) => Path(name);

