@using Hearth.Core.Services
@inject CheckIns CheckIns
@inject RoutineRunner Routines
@inject BotStore Bots
@inject AppState State
@inject SettingsStore SettingsStore

<MudPaper Class="card" Elevation="0">
    <h3>Check-ins</h3>
    <p class="muted small">A short, friendly message from your lead bot — not a report. It knows what's going on in your life (Memory → What's going on) and today's calendar, and asks how things went. In Telegram it arrives as a normal message, so just reply.</p>
    <div class="row">
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_c.Morning" Class="check" Label="Morning hello at" />
        <input type="time" value="@_c.MorningTime" @onchange="e => _c.MorningTime = e.Value?.ToString() ?? _c.MorningTime" />
    </div>
    <div class="row">
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_c.Evening" Class="check" Label="Evening check-in at" />
        <input type="time" value="@_c.EveningTime" @onchange="e => _c.EveningTime = e.Value?.ToString() ?? _c.EveningTime" />
    </div>
    <div class="row">
        <MudSelect Class="grow" Label="From" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_botId">
                <MudSelectItem Value="@("")">@(_default is null ? "(add a bot first)" : $"{_default.Emoji} {_default.Name} (your default)")</MudSelectItem>
                @foreach (var b in State.Bots) { <MudSelectItem Value="@(b.Id)">@b.Emoji @b.Name</MudSelectItem> }
            </MudSelect>
    </div>
    <div class="row end">
        @if (_message is not null) { <span class="muted small grow">@_message</span> }
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="TryNow" Disabled="@(_running || !(_c.Morning || _c.Evening))">@(_running ? "Writing…" : "▶ Try one now")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
    </div>
</MudPaper>

@code {
    private CheckInSettings _c = new();
    private string _botId = "";
    private Bot? _default;
    private bool _running;
    private string? _message;

    private Bot? From => State.Bots.FirstOrDefault(b => b.Id == _botId) ?? _default;

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsStore.GetAsync();
        _c = System.Text.Json.JsonSerializer.Deserialize<CheckInSettings>(System.Text.Json.JsonSerializer.Serialize(s.CheckIns))!;
        _botId = _c.BotId ?? "";
        _default = await CheckIns.BotAsync(new CheckInSettings());
    }

    private async Task Save()
    {
        _message = null;
        try
        {
            _c.BotId = string.IsNullOrEmpty(_botId) ? null : _botId;
            await CheckIns.ApplyAsync(_c);
            var parts = new List<string>();
            if (_c.Morning) parts.Add($"mornings at {_c.MorningTime}");
            if (_c.Evening) parts.Add($"evenings at {_c.EveningTime}");
            _message = parts.Count > 0 ? $"Saved: {From?.Name} checks in {string.Join(" and ", parts)}." : "Check-ins are off.";
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    /// <summary>Runs the one that fits the time of day now (morning before 3 pm).</summary>
    private async Task TryNow()
    {
        await Save();
        var id = DateTime.Now.Hour < 15 && _c.Morning || !_c.Evening ? _c.MorningRoutineId : _c.EveningRoutineId;
        if (id is null || From is not { } bot) return;
        var saved = await Bots.GetAsync(bot.Id);
        var routine = saved?.Routines.FirstOrDefault(r => r.Id == id);
        if (saved is null || routine is null) return;
        _running = true;
        try
        {
            var result = await Routines.RunAsync(saved, routine, null, CancellationToken.None);
            _message = result == "Done." ? $"Sent: it's in {bot.Name}'s chat (and Telegram, if linked)." : result;
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _running = false; }
    }
}
