@inject IJSRuntime JS
@inject AppState State
@inject ISpeechOutput Speech
@inject ChatService Chat
@inject LearningLoop Loop

<div class="msg @(Message.Role == ChatRole.User ? "user" : "assistant")">
    @if (Message.Role == ChatRole.User)
    {
        @if (State.BotById(Message.FromBotId) is { } sender)
        {
            <div class="msg-from"><BotAvatar Bot="sender" Size="sm" /> message from <b>@sender.Name</b></div>
        }
        else if (Message.RoutineName == "Task")
        {
            <div class="msg-from">🎯 Task step</div>
        }
        else if (Message.RoutineName is Hearth.Core.Services.Phone.PhoneService.CallerName)
        {
            <div class="msg-from">📞 You, on the phone</div>
        }
        else if (Message.RoutineName is Hearth.Core.Services.Phone.PhoneService.CalleeName)
        {
            <div class="msg-from">📞 On the call</div>
        }
        else if (Message.RoutineName is Hearth.Core.Services.Phone.PhoneService.TaskName or Hearth.Core.Services.Phone.PhoneService.ResultName)
        {
            <div class="msg-from">📞 @(Message.RoutineName == Hearth.Core.Services.Phone.PhoneService.TaskName ? "Call goal" : "Call finished")</div>
        }
        else if (Message.RoutineName is not null)
        {
            <div class="msg-from">⏰ Routine: <b>@Message.RoutineName</b></div>
        }
        @if (Message.Images.Count > 0)
        {
            <div class="msg-images">
                @foreach (var img in Message.Images)
                {
                    <img src="@img.DataUrl" alt="@img.FileName" />
                }
            </div>
        }
        @if (Message.AttachedFiles.Count > 0)
        {
            <div class="files">
                @foreach (var f in Message.AttachedFiles)
                {
                    <span class="file-chip">📄 @f</span>
                }
            </div>
        }
        @if (_editing)
        {
            <div class="edit-box">
                <textarea @bind="_editText" rows="3"></textarea>
                <div class="row end">
                    <button class="btn ghost" @onclick="() => _editing = false">Cancel</button>
                    <button class="btn primary" @onclick="SaveEdit">Save & submit</button>
                </div>
            </div>
        }
        else
        {
            @if (Message.Content.Length > 0)
            {
                @if (Skill.Match(Message.Content, State.Skills) is { } sk)
                {
                    <div class="bubble"><span class="skill-chip">@sk.skill.Icon /@sk.skill.Name</span> @sk.rest</div>
                }
                else
                {
                    <div class="bubble">@Message.Content</div>
                }
            }
            @if (!string.IsNullOrEmpty(Message.EventPayload))
            {
                <details class="event-box">
                    <summary>⚡ Event data</summary>
                    <pre>@Message.EventPayload</pre>
                </details>
            }
            <div class="msg-tools">
                <button title="Copy" aria-label="Copy" @onclick="Copy"><Icon Name="copy" Size="15" /></button>
                @if (!Busy)
                {
                    <button title="Edit" aria-label="Edit" @onclick="StartEdit"><Icon Name="pencil" Size="15" /></button>
                }
                @if (Message.FromBotId is null && Message.Content.Length > 20 && Skill.Match(Message.Content, State.Skills) is null)
                {
                    <a class="tool-link" title="Save this prompt as a reusable skill" href="@($"skills?from={Uri.EscapeDataString(Message.Content[..Math.Min(Message.Content.Length, 1500)])}")" aria-label="Save as skill"><Icon Name="zap" Size="15" /></a>
                }
            </div>
        }
    }
    else
    {
        @if (State.BotById(Message.BotId) is { } author)
        {
            <div class="msg-author"><BotAvatar Bot="author" Size="sm" /> <b>@author.Name</b> <span class="muted small">@author.Title</span></div>
        }
        @if (!string.IsNullOrEmpty(Message.Thinking) && State.Settings.ShowThinking)
        {
            <details class="thinking" open="@(Message.IsStreaming && string.IsNullOrEmpty(Message.Content) && Message.ToolCalls.Count == 0)">
                <summary>@(Message.IsStreaming && string.IsNullOrEmpty(Message.Content) ? "Thinking…" : "Thought process")</summary>
                <div class="thinking-body">@Message.Thinking</div>
            </details>
        }
        @if (Message.ToolCalls.Any(t => t.Handoff is null))
        {
            <ToolSteps Calls="Message.ToolCalls.Where(t => t.Handoff is null).ToArray()" />
        }
        @foreach (var handoff in Message.ToolCalls.Where(t => t.Handoff is not null).ToArray())
        {
            <HandoffCard @key="handoff.Id" Call="handoff" AskedBy="@Message.BotId" />
        }
        @if (Message.Sources.Count > 0)
        {
            <div class="sources">
                @for (var i = 0; i < Message.Sources.Count; i++)
                {
                    var s = Message.Sources[i];
                    <a class="source" href="@SafeUrl(s.Url)" target="_blank" rel="noopener" title="@s.Snippet">
                        <span class="num">@(i + 1)</span> @Host(s.Url)
                    </a>
                }
            </div>
        }
        @if (Message.GeneratedImages.Count > 0)
        {
            <div class="gen-images">
                @foreach (var img in Message.GeneratedImages)
                {
                    <figure>
                        <img src="@img.DataUrl" alt="@img.FileName" />
                        <button class="btn ghost small" @onclick="() => Download(img)">⇩ Save</button>
                    </figure>
                }
            </div>
        }
        @if (Message.Notice is not null)
        {
            <div class="notice">ℹ @Message.Notice</div>
        }

        @if (Message.Checked is { } fixedBy)
        {
            <details class="checked-note">
                <summary>🔎 Checked against the sources and corrected</summary>
                <div class="muted small">@fixedBy</div>
            </details>
        }
        <div class="md">
            <Markdown Text="@Message.Content" />
            @if (Message.IsStreaming)
            {
                <span class="cursor"></span>
            }
        </div>
        @if (Message.Error is not null)
        {
            <div class="error-box">⚠ @Message.Error</div>
        }
        @if (Message.Used.Count > 0 && !Message.IsStreaming)
        {
            <div class="used-box" title="What this reply drew on: memories, skills, people and life threads that show in it">
                <span class="learned-head">Drew on</span>
                @foreach (var u in Message.Used)
                {
                    <a class="used-item" href="@(u.Kind == LearnedItem.UsedSkill ? "skills" : "memory")" title="@u.Text">
                        <span aria-hidden="true">@u.Icon</span> @(u.Text.Length > 60 ? u.Text[..60] + "…" : u.Text)
                    </a>
                }
            </div>
        }
        @if (Message.LearnedItems.Count > 0 && !Message.IsStreaming)
        {
            <div class="learned-box">
                <span class="learned-head" title="What Hearth took away from this reply. Undo anything it got wrong.">Learned</span>
                @foreach (var item in Message.LearnedItems.ToArray())
                {
                    var it = item;
                    <span class="learned-item @(it.Undone ? "undone" : "")">
                        <span aria-hidden="true">@it.Icon</span>
                        @if (it.Kind is LearnedItem.NewSkill or LearnedItem.ImprovedSkill && !it.Undone)
                        {
                            <a href="skills" title="@(it.Kind == LearnedItem.NewSkill ? "New skill" : "Improved skill") — open the Skills page">@it.Label</a>
                        }
                        else
                        {
                            <span>@it.Label</span>
                        }
                        @if (it.Undone)
                        {
                            <span class="muted small">undone</span>
                        }
                        else
                        {
                            <button class="learned-undo" title="Take this back" @onclick="() => Undo(it)" disabled="@(_undoing == it)">Undo</button>
                        }
                    </span>
                }
                @foreach (var item in LearningLoop.OpenConflicts(Message))
                {
                    var it = item;
                    <div class="conflict">
                        <span>⚠ “@it.Text” contradicts what it knew: “@it.ConflictText”. Which is right?</span>
                        <span class="conflict-actions">
                            <button class="btn small" @onclick='() => Resolve(it, "new")'>The new one</button>
                            <button class="btn small" @onclick='() => Resolve(it, "old")'>What it knew</button>
                            <button class="btn small ghost" @onclick='() => Resolve(it, "both")'>Both are true</button>
                        </span>
                    </div>
                }
                @if (_learnMessage is not null) { <span class="muted small">@_learnMessage</span> }
            </div>
        }
        else if (_learnMessage is not null)
        {
            <div class="learned-box"><span class="muted small">@_learnMessage</span></div>
        }
        else
        {
            @if (Message.SkillNotes.Count > 0 && !Message.IsStreaming)
            {
                <a class="learned" href="skills" title="Bots write down methods that worked so they can repeat them — review them on the Skills page">
                    📒 Skill @string.Join(" · ", Message.SkillNotes)
                </a>
            }
            @if (Message.Learned.Count > 0 && !Message.IsStreaming)
            {
                <div class="learned" title="Saved to memory automatically — edit on the Memory page or the bot's page">
                    🧠 Remembered: @string.Join(" · ", Message.Learned)
                </div>
            }
        }
        @if (Message.Nudge is { Outcome: null } nudge && !Message.IsStreaming && Conv is not null)
        {
            <div class="nudge">
                <span>💡 You've asked for this @nudge.Times times.
                    @(nudge.Kind == Nudge.Routine ? $"Make it a routine ({nudge.When})?" : "Save how it's done as a skill, so it's done the same way every time?")</span>
                <span class="conflict-actions">
                    @if (nudge.Kind == Nudge.Routine)
                    {
                        <button class="btn small" @onclick="MakeRoutine">⏰ Make it a routine</button>
                    }
                    else
                    {
                        <button class="btn small" @onclick="SaveAsSkill" disabled="@_savingSkill">⚡ Make it a skill</button>
                    }
                    <button class="btn small ghost" @onclick="DismissNudge">Not now</button>
                </span>
            </div>
        }
        @if (_fixing)
        {
            <div class="fix-box">
                <label class="muted small" for="fix-@Message.Id">What was wrong? Hearth fixes what caused it (a memory, a skill, or a new rule).</label>
                <div class="fix-row">
                    <input id="fix-@Message.Id" class="input" placeholder="e.g. The report goes to Sarah, not Sam" @bind="_fixText" @bind:event="oninput"
                           @onkeydown="FixKey" disabled="@_fixBusy" />
                    <button class="btn small primary" @onclick="Fix" disabled="@(_fixBusy || string.IsNullOrWhiteSpace(_fixText))">@(_fixBusy ? "Fixing…" : "Fix it")</button>
                    <button class="btn small ghost" @onclick="() => _fixing = false" disabled="@_fixBusy">Cancel</button>
                </div>
            </div>
        }
        @if (Message.Feedback is not null && !_fixing)
        {
            <div class="feedback-note muted small">👎 You said: “@Message.Feedback”
                @if (IsLast && !Busy) { <button class="learned-undo" @onclick="OnRegenerate">Try again</button> }
            </div>
        }
        @if (!Message.IsStreaming)
        {
            <div class="msg-tools">
                <button title="Copy" aria-label="Copy" @onclick="Copy"><Icon Name="copy" Size="15" /></button>
                <button title="@(_speaking ? "Stop reading" : "Read aloud")" @onclick="ToggleSpeak"><Icon Name="@(_speaking ? "square" : "volume-2")" Size="15" /></button>
                @if (IsLast && !Busy)
                {
                    <button title="Regenerate" aria-label="Regenerate" @onclick="OnRegenerate"><Icon Name="refresh-cw" Size="15" /></button>
                }
                @if (CanCorrect)
                {
                    <button class="@(_fixing ? "on" : "")" title="That's wrong — tell Hearth what, and it fixes the cause" aria-label="That's wrong"
                            @onclick="ToggleFix"><Icon Name="thumbs-down" Size="15" /></button>
                }
                @if (CanSaveAsSkill)
                {
                    <button class="@(_savingSkill ? "on" : "")" title="Save how this was done as a skill, so it's done the same way next time"
                            aria-label="Save as skill" @onclick="SaveAsSkill" disabled="@_savingSkill">
                        <Icon Name="zap" Size="15" />@if (_savingSkill) { <span class="small"> Saving…</span> }
                    </button>
                }
                @if (Message.Trace.Count > 0)
                {
                    <button class="@(_showTrace ? "on" : "")" title="How this reply was made (steps and timing)" aria-label="Show steps and timing" @onclick="() => _showTrace = !_showTrace"><Icon Name="timer" Size="15" /></button>
                }
                <span class="meta">
                    @Message.Model
                    @if (Message.Stats?.TokensPerSecond is { } tps)
                    {
                        <text> · @tps.ToString("0.0") tok/s</text>
                    }
                    @if (Message.Stats?.CompletionTokens is { } ct)
                    {
                        <text> · @ct tokens</text>
                    }
                </span>
            </div>
            @if (_showTrace && Message.Trace.Count > 0) { <TraceView Steps="Message.Trace.ToArray()" /> }
        }
    }
</div>

@code {
    private bool _showTrace;

    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public bool IsLast { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnRegenerate { get; set; }
    [Parameter] public EventCallback<string> OnEdit { get; set; }
    /// <summary>The chat this message is in (for undoing what it learned and saving it as a skill).</summary>
    [Parameter] public Conversation? Conv { get; set; }
    /// <summary>Puts text in the message box (e.g. "Make this a routine: …"), for the user to check and send.</summary>
    [Parameter] public EventCallback<string> OnDraft { get; set; }

    private bool _fixing, _fixBusy;
    private string _fixText = "";

    private void ToggleFix() { _fixing = !_fixing; _fixText = ""; }

    private bool CanCorrect => Conv is not null && Message is { Role: ChatRole.Assistant, Error: null, Ack: false, Behind: false, Content.Length: > 0 };

    private async Task FixKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_fixText)) await Fix();
        else if (e.Key == "Escape") _fixing = false;
    }

    private async Task Fix()
    {
        _fixBusy = true;
        _learnMessage = null;
        try
        {
            _learnMessage = await Loop.CorrectAsync(Conv!, Message, _fixText, () => InvokeAsync(StateHasChanged));
            _fixing = false;
        }
        catch (Exception ex) { _learnMessage = "Couldn't fix it: " + ex.Message; }
        finally { _fixBusy = false; }
    }

    private async Task Resolve(LearnedItem item, string keep)
    {
        try { _learnMessage = await Loop.ResolveConflictAsync(Conv!, item, keep); }
        catch (Exception ex) { _learnMessage = ex.Message; }
    }

    private async Task MakeRoutine()
    {
        if (Message.Nudge is not { } n) return;
        await Loop.NudgeTakenAsync(Conv!, Message);
        await OnDraft.InvokeAsync(n.RoutineDraft);
    }

    private async Task DismissNudge()
    {
        await Loop.DismissNudgeAsync(Conv!, Message);
        _learnMessage = "OK, it won't offer that again.";
    }

    private LearnedItem? _undoing;
    private string? _learnMessage;
    private bool _savingSkill;

    private bool CanSaveAsSkill => Conv is not null && !Busy && Message is { Role: ChatRole.Assistant, Error: null, Ack: false, Behind: false, Content.Length: > 40 }
        && !Message.LearnedItems.Any(i => i.Kind is LearnedItem.NewSkill or LearnedItem.ImprovedSkill && !i.Undone);

    private async Task Undo(LearnedItem item)
    {
        if (Conv is null) { _learnMessage = "Undo it on the Memory or Skills page."; return; }
        _undoing = item;
        try { _learnMessage = await Chat.UndoLearnedAsync(Conv, item); }
        catch (Exception ex) { _learnMessage = ex.Message; }
        finally { _undoing = null; }
    }

    private async Task SaveAsSkill()
    {
        _savingSkill = true;
        _learnMessage = null;
        try
        {
            var item = await Chat.SaveReplyAsSkillAsync(Conv!, Message, () => InvokeAsync(StateHasChanged));
            if (Message.Nudge is { Outcome: null }) await Loop.NudgeTakenAsync(Conv!, Message);
            _learnMessage = item.Kind == LearnedItem.NewSkill ? $"Saved {item.Text}. Use it any time by typing {item.Text}." : $"Improved {item.Text}.";
        }
        catch (Exception ex) { _learnMessage = ex.Message; Message.Notice = $"Couldn't save a skill: {ex.Message}"; }
        finally { _savingSkill = false; }
    }

    private bool _editing;
    private bool _speaking;
    private string _editText = "";

    private void StartEdit() { _editText = Message.Content; _editing = true; }

    private async Task SaveEdit()
    {
        _editing = false;
        if (!string.IsNullOrWhiteSpace(_editText)) await OnEdit.InvokeAsync(_editText);
    }

    private async Task Copy() => await JS.InvokeVoidAsync("hearth.copy", Message.Content);
    private async Task Download(ImageAttachment img) => await JS.InvokeVoidAsync("hearth.downloadImage", img.DataUrl, img.FileName);

    private async Task ToggleSpeak()
    {
        try
        {
            if (_speaking) { await Speech.StopAsync(); _speaking = false; return; }
            _speaking = true;
            await Speech.SpeakAsync(State.Settings, Message.Content);
        }
        catch (Exception ex)
        {
            _speaking = false;
            Message.Notice = $"Read-aloud failed: {ex.Message}";
        }
    }

    private static string Host(string url) => Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host.Replace("www.", "") : url;
    private static string SafeUrl(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var u) && (u.Scheme == "http" || u.Scheme == "https") ? url : "#";
}
