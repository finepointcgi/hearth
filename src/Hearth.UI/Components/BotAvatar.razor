@{
    var anim = Working && Bot is not null ? Bot.WorkingAnimation : null;
    var cls = $"avatar {Size}{(anim is null or "none" ? "" : $" working anim-{anim}")}{(HasImage ? " pic" : "")}";
}
<span class="@cls" style="--c:@(Bot?.Color ?? "#888")" title="@(Bot is null ? "" : $"{Bot.Name} · {Bot.Title}")">@if (HasImage)
    {<img src="@Bot!.AvatarImage" alt="" draggable="false" />}
    else
    {@(Bot?.Emoji ?? "🤖")}@if (anim == "dots")
    {<span class="avatar-dots" aria-hidden="true"><i></i><i></i><i></i></span>}</span>

@code {
    [Parameter] public Bot? Bot { get; set; }
    /// <summary>"sm", "md" or "lg".</summary>
    [Parameter] public string Size { get; set; } = "md";
    /// <summary>True while the bot is thinking or working: plays the bot's chosen working animation.</summary>
    [Parameter] public bool Working { get; set; }

    private bool HasImage => Bot?.AvatarImage is { Length: > 0 } src && src.StartsWith("data:image/", StringComparison.Ordinal);
}
