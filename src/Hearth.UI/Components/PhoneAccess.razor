@using System.Net
@using System.Net.NetworkInformation
@using System.Net.Sockets
@using QRCoder
@inject IServiceProvider Services
@inject PlatformInfo Platform

<section class="card">
    <div class="row">
        <span class="conn-logo">📱</span>
        <span class="grow">
            <b>Phone access</b><br />
            <span class="muted small">Open the full Hearth app on your phone — chats, bots, tasks, approvals. Add it to your home screen and it works like an app.</span>
        </span>
    </div>

    @if (_access is null)
    {
        <p class="muted">Phone access works with the web version of Hearth (the background service or Docker). This window is the desktop app.</p>
    }
    else
    {
        var networkOn = _access.ListenUrls.Any(u => !u.Contains("127.0.0.1") && !u.Contains("localhost") && !u.Contains("[::1]"));
        @if (!networkOn && _https is null)
        {
            <div class="notice">
                Right now Hearth only listens on this computer, so your phone can't reach it. Easiest and most private: the Tailscale
                secure link below (works without opening Hearth to your Wi-Fi). Or turn on network access with a password
                (anyone on your network would otherwise be able to use your bots):
                <code class="snippet">HEARTH_PASSWORD='pick-a-strong-one' scripts/install-service-macos.sh</code>
                <span class="muted small">(Docker: set HEARTH_PASSWORD in docker-compose and it's already on the network.)</span>
            </div>
        }
        else if (!_access.PasswordSet)
        {
            <div class="error-box">Hearth is reachable from your network <b>without a password</b>. Anyone on your Wi-Fi can use your bots. Reinstall with HEARTH_PASSWORD set.</div>
        }

        @if (networkOn)
        {
            <div class="qr-grid">
                @{ var best = _urls[0]; var appLink = $"hearth://connect?url={Uri.EscapeDataString(best.url)}"; }
                <div class="qr">
                    @((MarkupString)Qr(appLink))
                    <b>In the Hearth app</b>
                    <span class="muted small">@best.label</span>
                </div>
                @foreach (var (label, url) in _urls)
                {
                    <div class="qr">
                        @((MarkupString)Qr(url))
                        <b>In the browser · @label</b>
                        <a href="@url" target="_blank" rel="noopener" class="small">@url</a>
                    </div>
                }
            </div>
            <p class="muted small">Have the Hearth app? Scan <b>In the Hearth app</b> with your phone's camera and it opens connected. Otherwise scan a browser code, sign in, then <b>Share → Add to Home Screen</b> (iPhone) or <b>⋮ → Install app</b> (Android).</p>
        }

        <details class="steps" open="@(_https is null && _tailscale is not null)">
            <summary>🔒 Secure link from anywhere with Tailscale (free, private, HTTPS, no port forwarding)</summary>
            <ol>
                <li>Install <a href="https://tailscale.com/download" target="_blank" rel="noopener">Tailscale</a> on this computer and on your phone, signed in to the same account.</li>
                <li>On this computer, run once: <code class="snippet">tailscale serve --bg @_port</code>
                    This gives Hearth an <b>https://…ts.net</b> address that only your own devices can open, encrypted end to end. Hearth can
                    stay closed to your Wi-Fi.</li>
                <li>Open that link on your phone (it appears at the top of this card), then add it to your home screen.</li>
            </ol>
            @if (_tailscale is null) { <span class="muted small">Tailscale isn't running on this computer yet.</span> }
            else if (_https is null) { <span class="muted small">Tailscale is running as @_tailscale, but isn't serving Hearth yet — run the command above.</span> }
            else { <span class="ok-text small">✓ Serving Hearth at @_https</span> }
            @if (!_access!.PasswordSet) { <div class="muted small">Tip: set a password too (HEARTH_PASSWORD), in case someone else ever joins your tailnet.</div> }
        </details>
    }
</section>

@code {
    private IAccessInfo? _access;
    private List<(string label, string url)> _urls = [];
    private string? _tailscale;
    private string? _https;
    private int _port;

    protected override async Task OnInitializedAsync()
    {
        _access = Services.GetService(typeof(IAccessInfo)) as IAccessInfo;
        if (_access is null) return;
        var port = _access.ListenUrls.Select(u => Uri.TryCreate(u.Replace("+", "x").Replace("*", "x").Replace("[::]", "x").Replace("0.0.0.0", "x"), UriKind.Absolute, out var x) ? x.Port : 0)
            .FirstOrDefault(p => p > 0);
        if (port == 0) return;
        _port = port;
        foreach (var ip in LanAddresses()) _urls.Add(("Home network", $"http://{ip}:{port}"));
        _tailscale = await TailscaleNameAsync();
        var networkOn = _access.ListenUrls.Any(u => !u.Contains("127.0.0.1") && !u.Contains("localhost") && !u.Contains("[::1]"));
        if (_tailscale is not null && networkOn) _urls.Insert(0, ("Tailscale (works anywhere)", $"http://{_tailscale}:{port}"));
        if (_tailscale is not null && await ServesPortAsync(port)) _https = $"https://{_tailscale}";
        if (_https is not null) _urls.Insert(0, ("Secure link (Tailscale HTTPS)", _https));
    }

    private static IEnumerable<string> LanAddresses() =>
        NetworkInterface.GetAllNetworkInterfaces()
            .Where(n => n.OperationalStatus == OperationalStatus.Up && n.NetworkInterfaceType != NetworkInterfaceType.Loopback)
            .SelectMany(n => n.GetIPProperties().UnicastAddresses)
            .Where(a => a.Address.AddressFamily == AddressFamily.InterNetwork && !IPAddress.IsLoopback(a.Address)
                        && !a.Address.ToString().StartsWith("169.254.") && !a.Address.ToString().StartsWith("100."))
            .Select(a => a.Address.ToString()).Distinct().Take(3);

    private static string? TailscaleExe() =>
        new[] { "/Applications/Tailscale.app/Contents/MacOS/Tailscale", "/usr/bin/tailscale", "/usr/local/bin/tailscale", "/opt/homebrew/bin/tailscale",
                @"C:\Program Files\Tailscale\tailscale.exe" }.FirstOrDefault(File.Exists);

    private async Task<string?> TailscaleAsync(string args)
    {
        if (!Platform.CanUseComputer || TailscaleExe() is not { } exe) return null;
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo(exe, args) { RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false };
            using var p = System.Diagnostics.Process.Start(psi)!;
            var output = await p.StandardOutput.ReadToEndAsync();
            await p.WaitForExitAsync();
            return p.ExitCode == 0 ? output : null;
        }
        catch { return null; }
    }

    /// <summary>Whether "tailscale serve" is proxying HTTPS to this port.</summary>
    private async Task<bool> ServesPortAsync(int port) =>
        await TailscaleAsync("serve status --json") is { } json && (json.Contains($"127.0.0.1:{port}\"") || json.Contains($"localhost:{port}\""));

    /// <summary>The MagicDNS name (or 100.x address) of this machine on Tailscale, if it's running.</summary>
    private async Task<string?> TailscaleNameAsync()
    {
        try
        {
            if (await TailscaleAsync("status --json") is not { } json) return null;
            var self = System.Text.Json.Nodes.JsonNode.Parse(json)?["Self"];
            var dns = self?["DNSName"]?.ToString().TrimEnd('.');
            return string.IsNullOrEmpty(dns) ? self?["TailscaleIPs"]?[0]?.ToString() : dns;
        }
        catch { return null; }
    }

    private static string Qr(string text)
    {
        using var gen = new QRCodeGenerator();
        using var data = gen.CreateQrCode(text, QRCodeGenerator.ECCLevel.M);
        return new SvgQRCode(data).GetGraphic(4, "#0a0a0a", "#ffffff", drawQuietZones: true);
    }
}
