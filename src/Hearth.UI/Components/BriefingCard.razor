@using Hearth.Core.Services
@inject Briefing Briefing
@inject RoutineRunner Routines
@inject BotStore Bots
@inject AppState State
@inject SettingsStore SettingsStore

<MudPaper Class="card" Elevation="0">
    <h3>Morning brief</h3>
    <p class="muted small">Every morning a bot checks your calendar, email, tasks, new job openings, news and weather and sends you one short brief: in its chat, and in Telegram or phone notifications if you've set those up.</p>
    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.Enabled" Class="check" Label="Send me a morning brief" />
    <div class="row">
        <label>At <input type="time" value="@_b.Time" @onchange="e => _b.Time = e.Value?.ToString() ?? _b.Time" /></label>
        <MudSelect Label="Days" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="Days">
                <MudSelectItem Value="@("weekdays")">Weekdays</MudSelectItem>
                <MudSelectItem Value="@("daily")">Every day</MudSelectItem>
            </MudSelect>
        <MudSelect Class="grow" Label="Written by" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" @bind-Value="_botId">
                <MudSelectItem Value="@("")">@(_default is null ? "(add a bot first)" : $"{_default.Emoji} {_default.Name} (default)")</MudSelectItem>
                @foreach (var b in State.Bots) { <MudSelectItem Value="@(b.Id)">@b.Emoji @b.Name</MudSelectItem> }
            </MudSelect>
    </div>

    <div class="brief-parts">
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.Calendar" Class="check" Label="📅 Today's calendar" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.Email" Class="check" Label="📧 Email that needs you" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.Tasks" Class="check" Label="✅ Tasks due and follow-ups" />
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.Jobs" Class="check" Label="💼 New job openings" />
        @if (_b.Jobs)
        {
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_b.JobCriteria" Placeholder="e.g. Director/VP of Software or AI, defense tech or automotive, Detroit or remote, $230k+" />
        }
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.News" Class="check" Label="📰 News on topics" />
        @if (_b.News) { <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_b.NewsTopics" Placeholder="e.g. defense tech, autonomous vehicles, AI chips" /> }
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.Weather" Class="check" Label="🌤️ Weather" />
        @if (_b.Weather) { <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_b.Location" Placeholder="City, e.g. Detroit" /> }
        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_b.Learned" Class="check" Label="🧠 What Hearth learned since the last brief" />
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_b.Extra" Placeholder="e.g. a motivational line, or my Shield AI application status" Label="Anything else" />
    </div>
    @if (Missing.Count > 0)
    {
        <p class="muted small">⚠ @(Writer?.Name ?? "The bot") needs these abilities for the parts you picked: @string.Join(", ", Missing) (Bots → @(Writer?.Name) → Abilities).</p>
    }

    <div class="row end">
        @if (_message is not null) { <span class="muted small grow">@_message</span> }
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RunNow" Disabled="@(_running || !_b.Enabled)">@(_running ? "Writing…" : "▶ Send one now")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
    </div>
</MudPaper>

@code {
    private BriefingSettings _b = new();
    private string _botId = "";
    private Bot? _default;
    private bool _running;
    private string? _message;

    private string Days { get => _b.WeekdaysOnly ? "weekdays" : "daily"; set => _b.WeekdaysOnly = value == "weekdays"; }

    private Bot? Writer => State.Bots.FirstOrDefault(b => b.Id == _botId) ?? _default;

    /// <summary>Abilities the chosen bot is missing for the picked parts.</summary>
    private List<string> Missing
    {
        get
        {
            var a = Writer?.Abilities;
            if (a is null) return [];
            var list = new List<string>();
            if (_b.Email && !a.Gmail && !a.Microsoft365) list.Add("Gmail or Microsoft 365");
            if (_b.Calendar && !a.Calendar && !a.Microsoft365) list.Add("Calendar or Microsoft 365");
            if ((_b.Jobs || _b.News || _b.Weather) && !a.WebSearch) list.Add("Web search");
            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsStore.GetAsync();
        _b = System.Text.Json.JsonSerializer.Deserialize<BriefingSettings>(System.Text.Json.JsonSerializer.Serialize(s.Briefing))!;
        _botId = _b.BotId ?? "";
        _default = await Briefing.BotAsync(new BriefingSettings());
    }

    private async Task Save()
    {
        _message = null;
        try
        {
            _b.BotId = string.IsNullOrEmpty(_botId) ? null : _botId;
            await Briefing.ApplyAsync(_b);
            _message = _b.Enabled ? $"Saved: {(_b.WeekdaysOnly ? "weekdays" : "every day")} at {_b.Time} from {Writer?.Name}." : "Morning brief is off.";
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task RunNow()
    {
        await Save();
        if (_b.RoutineId is null || Writer is not { } bot) return;
        var saved = await Bots.GetAsync(bot.Id);
        var routine = saved?.Routines.FirstOrDefault(r => r.Id == _b.RoutineId);
        if (saved is null || routine is null) return;
        _running = true;
        try
        {
            var result = await Routines.RunAsync(saved, routine, null, CancellationToken.None);
            _message = result == "Done." ? $"Done: it's in {bot.Name}'s chat." : result;
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _running = false; }
    }
}
