@inject SettingsStore Store
@inject PlatformInfo Platform

<MudPaper Class="card" Elevation="0">
    <h3>Remote computers</h3>
    <p class="muted small">
        Let bots run commands on your other machines (a server, a Raspberry Pi, a work box) over SSH, with the <code>run_remote</code> tool.
        Hearth signs in with your SSH keys only — set up key login first (<code>ssh-copy-id user@host</code>) — and asks before every
        command unless you change that under 🛡 Permissions → Remote computers. Bots need the <b>Code</b> ability.
    </p>
    @if (!Platform.CanUseComputer)
    {
        <span class="muted small">@(Platform.CanRunProcesses ? Platform.ComputerProblem + "." : "Not available on this device.")</span>
    }
    else
    {
        @foreach (var h in _hosts)
        {
            var host = h;
            <div class="memory-row">
                <span class="grow"><b>@host.Name</b> <span class="muted small">@host.Target@(host.Port != 22 ? $":{host.Port}" : "")@(string.IsNullOrWhiteSpace(host.Notes) ? "" : $" · {host.Notes}")</span>
                    @if (_status.TryGetValue(host.Id, out var st)) { <br /><span class="small @(st.StartsWith("✓") ? "ok-text" : "tiny-error")">@st</span> }</span>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => Test(host)" Disabled="@_busy">Test</MudButton>
                <MudIconButton Size="Size.Small" title="Remove" OnClick="() => Remove(host)">🗑</MudIconButton>
            </div>
        }
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:9rem" @bind-Value="_new.Name" Placeholder="Name, e.g. homelab" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_new.Target" Placeholder="user@host or an ~/.ssh/config alias" />
            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:5rem" @bind-Value="_new.Port" title="Port" />
        </div>
        <div class="row">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_new.KeyPath" Placeholder="Key file (optional, e.g. ~/.ssh/id_ed25519)" />
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Class="grow" @bind-Value="_new.Notes" Placeholder="What it is (bots see this), e.g. Ubuntu server running Plex" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add">Add</MudButton>
        </div>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="hearth-alert error-box">@_error</MudAlert> }
    }
</MudPaper>

@code {
    /// <summary>Called after a computer is added or removed.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private List<Hearth.Core.Tools.RemoteHost> _hosts = [];
    private Hearth.Core.Tools.RemoteHost _new = new();
    private readonly Dictionary<string, string> _status = [];
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => _hosts = (await Store.GetAsync()).RemoteHosts.ToList();

    private async Task Save(Action<List<Hearth.Core.Tools.RemoteHost>> change)
    {
        var s = await Store.GetAsync();
        change(s.RemoteHosts);
        await Store.SaveAsync(s);
        _hosts = s.RemoteHosts.ToList();
        await Changed.InvokeAsync();
    }

    private async Task Add()
    {
        _error = Hearth.Core.Tools.Ssh.Validate(_new);
        if (_error is not null) return;
        if (_hosts.Any(h => h.Name.Equals(_new.Name, StringComparison.OrdinalIgnoreCase))) { _error = "There's already a computer with that name."; return; }
        var host = _new;
        host.Target = host.Target.Trim();
        await Save(l => l.Add(host));
        _new = new();
        await Test(host);
    }

    private Task Remove(Hearth.Core.Tools.RemoteHost host) => Save(l => l.RemoveAll(h => h.Id == host.Id));

    private async Task Test(Hearth.Core.Tools.RemoteHost host)
    {
        _busy = true;
        _status[host.Id] = "Testing…";
        StateHasChanged();
        try
        {
            var (code, output) = await Hearth.Core.Tools.Ssh.RunAsync(host, "uname -sn 2>/dev/null || ver", TimeSpan.FromSeconds(20), CancellationToken.None);
            _status[host.Id] = code == 0 ? $"✓ Connected: {output.Trim()}" : $"Couldn't connect: {output.Trim()}";
        }
        catch (Exception ex) { _status[host.Id] = ex.Message; }
        finally { _busy = false; }
    }
}
