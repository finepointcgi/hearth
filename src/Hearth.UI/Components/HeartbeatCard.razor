@implements IDisposable
@inject HeartbeatRunner Heartbeat
@inject SettingsStore Settings
@inject AppState State

<MudPaper Class="card" Elevation="0">
    <div class="row">
        <h3 class="grow">Heartbeat</h3>
        <MudSwitch T="bool" Color="Color.Primary" Value="@(_s.Enabled)" ValueChanged="(bool v) => Change(s => s.Enabled = v)" Class="check" Label="On" />
    </div>
    <p class="muted small">
        Every @_s.IntervalMinutes minutes, @(Who) goes through your checklist and messages you — here and on Telegram/Slack/Discord — only when something needs your attention.
    </p>
    @if (_state.LastRun is { } last)
    {
        <p class="small">Last check-in @last.ToString("h:mm tt"): <b>@_state.LastResult</b>
            @if (_state.ConversationId is { } id && _state.Alerts > 0) { <a href="c/@id">· see messages (@_state.Alerts)</a> }
        </p>
    }
    <div class="steps">
        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" Lines="5" Value="@(_s.Checklist)" ValueChanged="(string v) => Change(s => s.Checklist = v ?? s.Checklist)" T="string" Label="What to keep an eye on (one per line)" />
        <div class="row">
            <MudSelect Label="Who checks in" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(_s.BotId ?? "")" ValueChanged="Ev.Change<string>(e => Change(s => s.BotId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()))" T="string">
                    <MudSelectItem Value="@("")">💬 Hearth</MudSelectItem>
                    @foreach (var b in State.Bots) { <MudSelectItem Value="@(b.Id)">@b.Emoji @b.Name</MudSelectItem> }
                </MudSelect>
            <MudSelect Label="Every" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Value="@(_s.IntervalMinutes.ToString())" ValueChanged="Ev.Change<string>(e => Change(s => s.IntervalMinutes = int.Parse(e.Value!.ToString()!)))" T="string">
                    @foreach (var m in new[] { 15, 30, 60, 120, 240 }) { <MudSelectItem Value="@(m)">@(m < 60 ? $"{m} min" : $"{m / 60} h")</MudSelectItem> }
                </MudSelect>
            <label>Quiet from <input type="time" value="@_s.QuietFrom" @onchange="e => Change(s => s.QuietFrom = e.Value?.ToString() ?? s.QuietFrom)" /></label>
            <label>until <input type="time" value="@_s.QuietUntil" @onchange="e => Change(s => s.QuietUntil = e.Value?.ToString() ?? s.QuietUntil)" /></label>
        </div>
        <span class="muted small">Each check-in is a short model call; with a cloud model that adds up, so pick a longer interval there.</span>
    </div>
    <div class="row end">
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RunNow" Disabled="@_busy">@(_busy ? "Checking…" : "Check in now")</MudButton>
    </div>
</MudPaper>

@code {
    private HeartbeatSettings _s = new();
    private HeartbeatState _state = new();
    private bool _busy;

    private string Who => _s.BotId is { } id && State.BotById(id) is { } b ? b.Name : "Hearth";

    protected override async Task OnInitializedAsync()
    {
        Heartbeat.Changed += OnChanged;
        _s = (await Settings.GetAsync()).Heartbeat;
        _state = await Heartbeat.StateAsync();
    }

    private void OnChanged() => InvokeAsync(async () => { _state = await Heartbeat.StateAsync(); StateHasChanged(); });

    private async Task Change(Action<HeartbeatSettings> change)
    {
        var settings = await Settings.GetAsync();
        change(settings.Heartbeat);
        await Settings.SaveAsync(settings);
        _s = settings.Heartbeat;
    }

    private async Task RunNow()
    {
        _busy = true;
        try { await Heartbeat.RunNowAsync(); }
        finally { _busy = false; _state = await Heartbeat.StateAsync(); }
    }

    public void Dispose() => Heartbeat.Changed -= OnChanged;
}
