@using Locus.UI
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Locus</title>
    <base href="/" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Locus" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="icon-192.png" />
    <link rel="stylesheet" href="@Assets["_content/Locus.UI/locus.css"]" />
</head>
<body>
    <LocusRoutes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    @* If the page's connection to Locus ever breaks, say so (instead of a page whose menus silently stop working). *@
    <div id="blazor-error-ui" role="alert">
        Locus lost its connection to this page. <a href="" class="reload" onclick="location.reload(); return false;">Reload</a>
    </div>
    <script src="_content/Locus.UI/locus.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>if ("serviceWorker" in navigator) navigator.serviceWorker.register("sw.js").catch(() => {});</script>
</body>
</html>
