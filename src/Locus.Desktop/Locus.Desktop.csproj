<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Native desktop window via Photino (WebView2 on Windows, WebKitGTK on Linux, WKWebView on macOS).
       This is the Linux desktop target, since .NET MAUI has no Linux support. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('windows'))">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Locus</AssemblyName>
    <RootNamespace>Locus.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Locus.UI\Locus.UI.csproj" />
    <ProjectReference Include="..\Locus.Computer\Locus.Computer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
