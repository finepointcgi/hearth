@inherits StatefulComponent
@inject IBotComputer Computer
@inject ApprovalCenter Approvals
@inject ConversationStore Store
@inject NavigationManager Nav
@inject HeartbeatRunner Heartbeat

<aside class="sidebar">
    <div class="sidebar-head">
        <span class="sidebar-title">@SectionTitle</span>
        <button class="icon-btn only-mobile" title="Close" aria-label="Close menu" @onclick="Close"><Icon Name="x" /></button>
    </div>

    @switch (_section)
    {
        case "chats":
            <button class="new-chat" @onclick="NewChat"><Icon Name="message-square-plus" /> New chat</button>
            <label class="search-box"><Icon Name="search" Size="16" /><input placeholder="Search chats" @bind="_filter" @bind:event="oninput" aria-label="Search chats" /></label>
            @if (State.Bots.Count > 0)
            {
                <div class="bot-strip" aria-label="Your bots">
                    @foreach (var b in State.Bots.Take(7))
                    {
                        <a href="bot/@b.Id" @onclick="Close" title="Chat with @b.Name"><BotAvatar Bot="b" Size="sm" /></a>
                    }
                    <a class="bot-strip-more" href="bots" @onclick="Close" title="All bots" aria-label="All bots"><Icon Name="ellipsis" Size="16" /></a>
                </div>
            }
            <nav class="conv-list" aria-label="Chats">
                @foreach (var group in Grouped())
                {
                    <div class="conv-group">@group.Key</div>
                    @foreach (var c in group)
                    {
                        <div class="conv @(IsActive(c.Id) ? "active" : "")">
                            @if (_renaming == c.Id)
                            {
                                <input class="rename" @bind="_renameText" @onkeydown="e => RenameKey(e, c.Id)" @onblur="() => CommitRename(c.Id)" autofocus />
                            }
                            else
                            {
                                <a href="c/@c.Id" @onclick="Close" title="@c.Title" class="@(c.Unread ? "unread" : "")">
                                    @if (c.BotIds.Count > 0) { <AvatarStack Bots="c.BotIds.Select(State.BotById).OfType<Bot>()" /> }
                                    <span class="conv-title">@c.Title</span>
                                    @if (c.Unread) { <span class="unread-dot"></span> }
                                </a>
                                <div class="conv-actions">
                                    <button title="@(c.Pinned ? "Unpin" : "Pin")" aria-label="Pin" @onclick="() => TogglePin(c.Id)"><Icon Name="pin" Size="14" /></button>
                                    <button title="Rename" aria-label="Rename" @onclick="() => StartRename(c)"><Icon Name="pencil" Size="14" /></button>
                                    <button title="Delete" aria-label="Delete" @onclick="() => Delete(c.Id)"><Icon Name="trash-2" Size="14" /></button>
                                </div>
                            }
                        </div>
                    }
                }
                @if (!Grouped().Any())
                {
                    <div class="muted pad small">@(_filter.Length > 0 ? "No chats match." : "Your chats will show up here.")</div>
                }
            </nav>
            break;

        case "bots":
            <a class="new-chat" href="bots/new" @onclick="Close"><Icon Name="plus" /> New bot</a>
            <nav class="side-nav" aria-label="Bots">
                <a class="@(Here("bots") ? "active" : "")" href="bots" @onclick="Close"><Icon Name="users" /> All bots and groups</a>
                <div class="conv-group">Your bots</div>
                @foreach (var b in State.Bots)
                {
                    <a class="@(Here($"bots/{b.Id}") ? "active" : "")" href="bots/@b.Id" @onclick="Close">
                        <BotAvatar Bot="b" Size="sm" /><span class="grow-text">@b.Name<small>@b.Title</small></span>
                    </a>
                }
                @if (State.Bots.Count == 0) { <div class="muted pad small">No bots yet. Create one, or add the starter team from All bots.</div> }
            </nav>
            break;

        case "inbox":
            <nav class="side-nav" aria-label="Inbox">
                <a class="@(Here("dashboard") ? "active" : "")" href="dashboard" @onclick="Close"><Icon Name="layout-dashboard" /> Overview
                    @if (Approvals.Pending.Count > 0) { <span class="count-badge" title="Waiting on you">@Approvals.Pending.Count</span> }</a>
                <a class="@(Here("tasks") ? "active" : "")" href="tasks" @onclick="Close"><Icon Name="target" /> Tasks</a>
                <a class="@(Here("usage") ? "active" : "")" href="usage" @onclick="Close"><Icon Name="chart-bar" /> Usage and cost</a>
                @if (_heartbeatChat is not null)
                {
                    <a class="@(IsActive(_heartbeatChat) ? "active" : "")" href="c/@_heartbeatChat" @onclick="Close"><Icon Name="heart-pulse" /> Heartbeat messages</a>
                }
            </nav>
            break;

        case "library":
            <nav class="side-nav" aria-label="Library">
                <a class="@(Here("skills") ? "active" : "")" href="skills" @onclick="Close"><Icon Name="zap" /> Skills</a>
                <a class="@(Here("files") ? "active" : "")" href="files" @onclick="Close"><Icon Name="folder" /> Files</a>
                <a class="@(Here("documents") ? "active" : "")" href="documents" @onclick="Close"><Icon Name="file-text" /> Documents</a>
                <a class="@(Here("memory") ? "active" : "")" href="memory" @onclick="Close"><Icon Name="brain" /> Memory</a>
            </nav>
            break;

        default:
            <nav class="side-nav" aria-label="Settings">
                <a class="@(Here("settings") ? "active" : "")" href="settings" @onclick="Close"><Icon Name="sliders-horizontal" /> General and models</a>
                <a class="@(Here("connections") ? "active" : "")" href="connections" @onclick="Close"><Icon Name="link" /> Connections</a>
                <a class="@(Here("permissions") ? "active" : "")" href="permissions" @onclick="Close"><Icon Name="shield" /> Permissions</a>
                <a class="@(Here("tools") ? "active" : "")" href="tools" @onclick="Close"><Icon Name="plug" /> Tools and MCP</a>
                <a class="@(Here("backup") ? "active" : "")" href="backup" @onclick="Close"><Icon Name="archive-restore" /> Backup and restore</a>
                <a class="only-in-app" href="locus-app://switch-server"><Icon Name="server" /> Switch server</a>
                <a class="@(Here("computer") ? "active" : "")" href="computer" @onclick="Close"><Icon Name="monitor" /> Computer
                    @if (Computer.Status.Running) { <span class="live-dot" title="Browser running"></span> }</a>
            </nav>
            break;
    }

    <div class="sidebar-foot">
        <a class="provider-pill" href="settings" @onclick="Close" title="@State.Settings.ActiveProvider.BaseUrl">
            <span class="dot @(State.ModelError is null && State.Models.Count > 0 ? "ok" : "bad")"></span>
            <span class="ellipsis">@State.Settings.ActiveProvider.Name</span>
        </a>
    </div>
</aside>

@code {
    private string _filter = "";
    private string? _renaming;
    private string _renameText = "";
    private string _section = "chats";
    private string? _heartbeatChat;

    private string SectionTitle => ShellSections.All.First(s => s.Id == _section).Title;

    protected override async Task OnInitializedAsync()
    {
        _section = ShellSections.Current(Nav);
        Nav.LocationChanged += OnLocation;
        Computer.Changed += OnComputer;
        Approvals.Requested += OnApproval;
        Approvals.Resolved += OnApprovalResolved;
        try { _heartbeatChat = (await Heartbeat.StateAsync()).ConversationId; } catch { /* none yet */ }
    }

    private void OnApproval(PendingApproval _) => InvokeAsync(StateHasChanged);
    private void OnApprovalResolved(PendingApproval _, bool __) => InvokeAsync(StateHasChanged);
    private void OnComputer() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? s, LocationChangedEventArgs e) => InvokeAsync(() => { _section = ShellSections.Current(Nav); StateHasChanged(); });

    public override void Dispose()
    {
        Nav.LocationChanged -= OnLocation;
        Computer.Changed -= OnComputer;
        Approvals.Requested -= OnApproval;
        Approvals.Resolved -= OnApprovalResolved;
        base.Dispose();
    }

    private bool IsActive(string id) => Nav.Uri.EndsWith("/c/" + id, StringComparison.Ordinal);
    private bool Here(string path) => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') == path;

    private IEnumerable<IGrouping<string, ConversationSummary>> Grouped()
    {
        var today = DateTimeOffset.Now.Date;
        return State.Conversations
            .Where(c => c.Id != _heartbeatChat) // lives under Inbox
            .Where(c => _filter.Length == 0 || c.Title.Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .GroupBy(c => c.Pinned ? "Pinned"
                : c.UpdatedAt.Date == today ? "Today"
                : c.UpdatedAt.Date == today.AddDays(-1) ? "Yesterday"
                : c.UpdatedAt.Date > today.AddDays(-7) ? "Previous 7 days"
                : "Older");
    }

    private void Close() { State.SidebarOpen = false; State.NotifyChanged(); }
    private void NewChat() { Close(); Nav.NavigateTo("", forceLoad: false); }

    private async Task Delete(string id)
    {
        await Store.DeleteAsync(id);
        if (IsActive(id)) Nav.NavigateTo("");
    }

    private async Task TogglePin(string id)
    {
        var c = await Store.GetAsync(id);
        if (c is null) return;
        c.Pinned = !c.Pinned;
        await Store.SaveAsync(c);
    }

    private void StartRename(ConversationSummary c) { _renaming = c.Id; _renameText = c.Title; }

    private async Task RenameKey(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter") await CommitRename(id);
        else if (e.Key == "Escape") _renaming = null;
    }

    private async Task CommitRename(string id)
    {
        if (_renaming != id) return;
        _renaming = null;
        var c = await Store.GetAsync(id);
        if (c is null || string.IsNullOrWhiteSpace(_renameText)) return;
        c.Title = _renameText.Trim();
        await Store.SaveAsync(c);
    }
}
