@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject NavigationManager Nav
@inject SettingsStore SettingsStore

<div class="shell @(State.SidebarOpen ? "sidebar-open" : "")">
    <NavRail />
    <Sidebar />
    <div class="scrim" @onclick="CloseSidebar"></div>
    <main class="main">
        @Body
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.EnsureInitializedAsync();
        // First run: walk through setup. Installs already in use are marked as set up.
        var settings = await SettingsStore.GetAsync();
        if (!settings.SetupDone)
        {
            if (State.Bots.Count > 0 || State.Conversations.Count > 0)
            {
                settings.SetupDone = true;
                await SettingsStore.SaveAsync(settings);
            }
            else if (!Nav.Uri.Contains("/welcome")) Nav.NavigateTo("welcome");
        }
    }

    private void CloseSidebar() { State.SidebarOpen = false; State.NotifyChanged(); }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
