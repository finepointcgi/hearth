    private string? _runningRoutine;
    private List<Locus.Core.Services.Memory> _memories = [];
    private IReadOnlyList<(ITool tool, string? reason)> _catalog = [];

    protected override async Task OnParametersSetAsync()
    {
        _isNew = Id == "new";
        var existing = _isNew ? null : await Store.GetAsync(Id);
        if (!_isNew && existing is null) { Nav.NavigateTo("bots"); return; }
        // Edit a copy.
        _bot = existing is null
            ? new Bot { Emoji = "🤖", Name = "", Title = "" }
            : System.Text.Json.JsonSerializer.Deserialize<Bot>(System.Text.Json.JsonSerializer.Serialize(existing))!;
        _catalog = await BuiltIns.CatalogAsync(State.Settings);
        _memories = _isNew ? [] : await Memories.ListAsync(_bot.Id);
        foreach (var r in _bot.Routines) _states[r.Id] = await TriggerStates.GetAsync(r.Id);
        _googleConnected = await GoogleAuth.IsConnectedAsync();
        await LoadServerModelsAsync();
        foreach (var v in _bot.Versions) await LoadVersionModelsAsync(v);
    }

    private IReadOnlyList<ModelInfo> _serverModels = [];
    private string? _serverError;
    private ProviderProfile? OwnProvider => _bot?.ProviderId is { } id ? State.Settings.Providers.FirstOrDefault(p => p.Id == id) : null;
    private bool OwnServer => OwnProvider is { } p && p.Id != State.Settings.ActiveProvider.Id;
    private IReadOnlyList<ModelInfo> BotModels => OwnServer ? _serverModels : State.Models;

    private async Task SetProvider(string? id)
    {
        _bot!.ProviderId = string.IsNullOrEmpty(id) ? null : id;
        _bot.Model = null; // models differ between servers
        await LoadServerModelsAsync();
    }

    private async Task LoadServerModelsAsync()
    {
        _serverModels = [];
        _serverError = null;
        if (OwnProvider is not { } p || !OwnServer) return;
        try { _serverModels = await Llms.Create(p).ListModelsAsync(); }
        catch (Exception ex) { _serverError = $"{p.Name}: {ex.Message}"; }
    }

    private readonly Dictionary<string, IReadOnlyList<ModelInfo>> _modelsByServer = [];

    /// <summary>Models on a version's server (the app's own list for the active server).</summary>
    private IReadOnlyList<ModelInfo> VersionModels(BotVersion v) =>
        v.ProviderId is null || v.ProviderId == State.Settings.ActiveProvider.Id ? State.Models
        : _modelsByServer.GetValueOrDefault(v.ProviderId) ?? [];

    private async Task SetVersionProvider(BotVersion v, string? id)
    {
        v.ProviderId = string.IsNullOrEmpty(id) ? null : id;
        v.Model = null; // models differ between servers
        await LoadVersionModelsAsync(v);
    }

    private async Task LoadVersionModelsAsync(BotVersion v)
    {
        if (v.ProviderId is not { } id || _modelsByServer.ContainsKey(id)
            || State.Settings.Providers.FirstOrDefault(p => p.Id == id) is not { } p) return;
        try { _modelsByServer[id] = await Llms.Create(p).ListModelsAsync(); }
        catch { _modelsByServer[id] = []; }
    }

    private void AddVersion() => _bot!.Versions.Add(new BotVersion { Name = _bot.Versions.Count == 0 ? "strong" : $"v{_bot.Versions.Count + 1}" });

    private void ToggleTool(string name, bool on)
    {
        _bot!.AllowedTools.Remove(name);
        if (on) _bot.AllowedTools.Add(name);
    }

    private async Task Save()
    {
        _error = null;
        if (_bot is null) return;
        if (string.IsNullOrWhiteSpace(_bot.Name)) { _error = "Give the bot a name."; return; }
        _bot.Name = _bot.Name.Trim().TrimStart('@');
        if (State.Bots.Any(b => b.Id != _bot.Id && b.Name.Equals(_bot.Name, StringComparison.OrdinalIgnoreCase)))
        { _error = "Another bot already has that name (names are used for @mentions)."; return; }
        if (string.IsNullOrWhiteSpace(_bot.Model)) _bot.Model = null;
        foreach (var v in _bot.Versions)
        {
            v.Name = (v.Name ?? "").Trim();
            v.Note = (v.Note ?? "").Trim();
            if (string.IsNullOrWhiteSpace(v.Model)) v.Model = null;
        }
        if (_bot.Versions.Any(v => v.Name.Length == 0)) { _error = "Give each version a name."; return; }
        if (_bot.Versions.GroupBy(v => v.Name, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1)) { _error = "Two versions have the same name."; return; }
        _bot.Abilities.ProjectFolder = string.IsNullOrWhiteSpace(_bot.Abilities.ProjectFolder) ? null : _bot.Abilities.ProjectFolder.Trim();
        try
        {
            await Store.SaveAsync(_bot);
            if (_isNew) { Nav.NavigateTo($"bots/{_bot.Id}"); return; }
            _saved = true;
            StateHasChanged();
            await Task.Delay(1800);
            _saved = false;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private readonly Dictionary<string, TriggerState> _states = [];
    private readonly Dictionary<string, string> _runResult = [];

    private string WebhookUrl(Routine r)
    {
        var baseUrl = Platform.WebhookBaseUrl is { Length: > 0 } b ? b : Nav.BaseUri;
        return $"{baseUrl.TrimEnd('/')}/hooks/{r.Id}?token={r.WebhookSecret}";
    }

    private async Task Copy(string text) => await JS.InvokeVoidAsync("locus.copy", text);

    private static string PromptHint(Routine r) => r.Trigger switch
    {
        TriggerKind.Webhook => "What to do with the webhook body, e.g. /triage — or: Summarize this GitHub event and tell me if it needs action.",
        TriggerKind.Folder => "What to do with each file, e.g. Extract vendor, total and due date from this invoice and add it to my notes.",
        TriggerKind.Feed => "What to do with new items, e.g. Tell me which of these releases matter for my setup and why.",
        TriggerKind.PageChange => "What to do when it changes, e.g. Tell me what changed and whether the price went down.",
        TriggerKind.Sheet => "What to do with new rows, e.g. For each new lead, research the company and write a summary into column F.",
        TriggerKind.Email => "What to do with new email, e.g. Triage it; if it needs a reply, draft one in my style and tell me.",
        TriggerKind.Calendar => "What to do before a meeting, e.g. Research the attendees and their companies and give me a 5-bullet brief.",
        _ => "What to do, e.g. /daily-briefing — or: Search for news about local LLMs from the last day and summarize the top 5.",
    };

    private async Task RunNow(Routine routine)
    {
        await Save();
        if (_error is not null) return;
        _runningRoutine = routine.Id;
        _runResult.Remove(routine.Id);
        try
        {
            string result;
            if (routine.Trigger is TriggerKind.Feed or TriggerKind.PageChange or TriggerKind.Sheet or TriggerKind.Email or TriggerKind.Calendar)
            {
                result = await Routines.PollAsync(_bot!, routine, force: true);
                _states[routine.Id] = await TriggerStates.GetAsync(routine.Id);
                _runResult[routine.Id] = result;
                return;
            }
            var payload = routine.Trigger switch
            {
                TriggerKind.Webhook => "(Test run from the bot editor — no webhook body.)",
                TriggerKind.Folder => "(Test run from the bot editor — no file event.)",
                _ => null,
            };
            result = await Routines.RunAsync(_bot!, routine, payload, CancellationToken.None);
            if (result != "Done.") _error = $"Routine: {result}";
            else Nav.NavigateTo($"bot/{_bot!.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _runningRoutine = null; }
    }

