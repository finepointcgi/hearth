@page "/bots/{Id}"
@inherits StatefulComponent
@inject CodeTools CodeTools
@inject BotStore Store
@inject MemoryStore Memories
@inject BuiltInToolProvider BuiltIns
@inject RoutineRunner Routines
@inject NavigationManager Nav
@inject PlatformInfo Platform
@inject TriggerStateStore TriggerStates
@inject IJSRuntime JS
@inject IBotComputer Computer
@inject ISandboxDesktops Sandboxes
@inject BotCheckRunner CheckRunner
@inject Locus.Core.Llm.ILlmClientFactory Llms
@inject Locus.Core.Services.Google.GoogleAuth GoogleAuth

<header class="topbar">
    <button class="icon-btn only-mobile" title="Menu" aria-label="Menu" @onclick="OpenSidebar"><Icon Name="panel-left" /></button>
    @if (_bot is not null) { <BotAvatar Bot="_bot" /> }
    <h2 class="topbar-title">@(_isNew ? "New bot" : _bot?.Name)</h2>
    <span class="spacer"></span>
    @if (_saved) { <span class="ok-text"><Icon Name="check" Size="16" /> Saved</span> }
    @if (!_isNew) { <a class="btn ghost" href="bot/@Id">Chat</a> }
    <button class="btn primary" @onclick="Save">Save</button>
</header>

@if (_bot is not null)
{
<div class="settings">
    @if (_error is not null) { <div class="error-box">@_error</div> }
    <div class="tabs" role="tablist" aria-label="Bot settings">
        @foreach (var (id, label, icon, badge) in Tabs())
        {
            var tab = id;
            <button role="tab" aria-selected="@(_tab == tab)" class="tab @(_tab == tab ? "on" : "")" @onclick="() => _tab = tab">
                <Icon Name="@icon" Size="16" /> @label @if (badge is not null) { <span class="tab-badge">@badge</span> }
            </button>
        }
    </div>

    @if (_tab == "profile")
    {
    <section class="card">
        <h3>Identity</h3>
        <div class="row">
            <label>Emoji <input @bind="_bot.Emoji" style="width:4.5rem;text-align:center;font-size:1.3rem" maxlength="8" /></label>
            <label>Colour <input type="color" @bind="_bot.Color" style="width:4rem;padding:.2rem" /></label>
            <label class="grow">Name <input @bind="_bot.Name" placeholder="e.g. Researcher" /></label>
        </div>
        <label>Title / role <input @bind="_bot.Title" placeholder="e.g. Research & fact-checking" /></label>
        <label>Instructions
            <textarea rows="7" @bind="_bot.Instructions" placeholder="What this bot does, how it works, its tone, what it should never do…"></textarea>
        </label>
        <label class="check"><input type="checkbox" @bind="_bot.IsCoordinator" /> Coordinator ("chief of staff"): routes work to the other bots and combines their results</label>
    </section>

    <section class="card">
        <h3>Model</h3>
        @if (State.Settings.Providers.Count > 1)
        {
            <label>Model server
                <select value="@(_bot.ProviderId ?? "")" @onchange="e => SetProvider(e.Value?.ToString())">
                    <option value="">Same as the app (@State.Settings.ActiveProvider.Name)</option>
                    @foreach (var p in State.Settings.Providers.Where(p => p.Id != State.Settings.ActiveProvider.Id))
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </label>
        }
        <label>Model
            <select @bind="_bot.Model">
                <option value="">@(OwnServer ? $"{OwnProvider!.Name}'s default model" : "Use the model selected in the chat")</option>
                @foreach (var m in BotModels) { <option value="@m.Id">@m.Id</option> }
                @if (!string.IsNullOrEmpty(_bot.Model) && BotModels.All(m => m.Id != _bot.Model)) { <option value="@_bot.Model">@_bot.Model (not available)</option> }
            </select>
        </label>
        @if (_serverError is not null) { <span class="tiny-error">@_serverError</span> }
        @if (OwnServer) { <span class="muted small">If @OwnProvider!.Name can't be reached, this bot falls back to @State.Settings.ActiveProvider.Name.</span> }

        <h4 class="versions-head">Versions</h4>
        <span class="muted small">Other models this bot can run on. A coordinator sees them and picks one when a problem needs a stronger, faster or more private model, e.g. "claude" for hard research.</span>
        @foreach (var v in _bot.Versions)
        {
            var version = v;
            <div class="version-row">
                <label>Name <input @bind="version.Name" placeholder="e.g. claude" style="width:8rem" /></label>
                <label>Server
                    <select value="@(version.ProviderId ?? "")" @onchange="e => SetVersionProvider(version, e.Value?.ToString())">
                        <option value="">@State.Settings.ActiveProvider.Name (the app's)</option>
                        @foreach (var p in State.Settings.Providers.Where(p => p.Id != State.Settings.ActiveProvider.Id)) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </label>
                <label>Model
                    <select @bind="version.Model">
                        <option value="">Server's default</option>
                        @foreach (var m in VersionModels(version)) { <option value="@m.Id">@m.Id</option> }
                        @if (!string.IsNullOrEmpty(version.Model) && VersionModels(version).All(m => m.Id != version.Model)) { <option value="@version.Model">@version.Model</option> }
                    </select>
                </label>
                <label class="grow">When to use it <input @bind="version.Note" placeholder="e.g. hard research or code; uses your Claude plan" /></label>
                <button class="btn ghost small" title="Remove this version" @onclick="() => _bot.Versions.Remove(version)">✕</button>
            </div>
        }
        <div><button class="btn ghost small" @onclick="AddVersion">+ Add version</button></div>

        <details class="advanced">
            <summary>Advanced: limit to specific tools</summary>
            <label>Tool access
                <select @bind="_bot.ToolMode">
                    <option value="@BotToolMode.All">Use the bot's abilities (Abilities tab)</option>
                    <option value="@BotToolMode.Selected">Only the tools picked below (ignores abilities)</option>
                    <option value="@BotToolMode.None">No tools at all</option>
                </select>
            </label>
            @if (_bot.ToolMode == BotToolMode.Selected)
            {
                <div class="tool-pick">
                    @foreach (var (tool, reason) in _catalog)
                    {
                        var t = tool;
                        <label class="check"><input type="checkbox" checked="@_bot.AllowedTools.Contains(t.Name)" @onchange="e => ToggleTool(t.Name, (bool)e.Value!)" /> @t.Icon @t.DisplayName @if (reason is not null) { <span class="muted small">(@reason)</span> }</label>
                    }
                </div>
            }
        </details>
    </section>

    @if (!_isNew)
    {
        <section class="card danger">
            @if (_confirmDelete)
            {
                <div class="row">
                    <span>Delete @_bot.Name? Its chats stay, but it won't reply in them.</span>
                    <button class="btn danger" @onclick="Delete">Delete</button>
                    <button class="btn ghost" @onclick="() => _confirmDelete = false">Cancel</button>
                </div>
            }
            else
            {
                <button class="btn danger" @onclick="() => _confirmDelete = true">Delete bot</button>
            }
        </section>
    }
    }
    @if (_tab == "abilities")
    {
    <section class="card">
        <h3>Abilities</h3>
        <p class="muted">Switch on what @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name) may do. Things that also need setting up elsewhere say so.</p>
        <div class="ability-list">
            @foreach (var a in AbilityList())
            {
                var ability = a;
                <label class="ability-row @(ability.Get() ? "on" : "")">
                    <span class="ability-icon"><Icon Name="@ability.Icon" Size="18" /></span>
                    <span class="ability-text">
                        <b>@ability.Name</b>
                        <span class="muted small">@ability.Description</span>
                    </span>
                    @if (ability.Hint is not null && ability.Get())
                    {
                        <a class="chip-warn" href="@ability.HintLink" title="@ability.Hint">Needs setup</a>
                    }
                    <input type="checkbox" class="switch" role="switch" checked="@ability.Get()" @onchange="e => ability.Set((bool)e.Value!)" aria-label="@ability.Name" />
                </label>
            }
        </div>
    </section>

    @if (_bot.Abilities.Code && CodeTools.Available)
    {
        <section class="card">
            <h3>Coding</h3>
            <p class="muted small">Start a code session with @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name) from the Code tab. With a project folder set, it can also find, read, edit and test code there in its normal chats and when another bot hands it work (edits it isn't allowed to make without you are refused when you aren't watching).</p>
            <label>Project folder <span class="muted small">(optional)</span>
                <input placeholder="Full path, e.g. /Users/me/src/my-app" @bind="_bot.Abilities.ProjectFolder" />
            </label>
            @if (!string.IsNullOrWhiteSpace(_bot.Abilities.ProjectFolder) && !Directory.Exists(_bot.Abilities.ProjectFolder.Trim()))
            {
                <span class="tiny-error">That folder doesn't exist.</span>
            }
            <label>File edits in that folder
                <select @bind="_bot.Abilities.CodeMode">
                    <option value="@CodePermissionMode.Ask">Ask me each time</option>
                    <option value="@CodePermissionMode.AcceptEdits">Allow without asking</option>
                    <option value="@CodePermissionMode.Plan">Read only</option>
                </select>
            </label>
        </section>
    }

    @if (_bot.Abilities.Browser)
    {
        <section class="card">
            <h3>Browser</h3>
            <div class="seg">
                <button class="@(_bot.Abilities.BrowserProfile == BrowserProfile.Own ? "on" : "")" @onclick="() => _bot.Abilities.BrowserProfile = BrowserProfile.Own">
                    <b>Its own browser</b><span class="muted small">Separate cookies and sign-ins, just for @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name)</span>
                </button>
                <button class="@(_bot.Abilities.BrowserProfile == BrowserProfile.Shared ? "on" : "")" @onclick="() => _bot.Abilities.BrowserProfile = BrowserProfile.Shared">
                    <b>Shared browser</b><span class="muted small">Uses the sign-ins every bot shares</span>
                </button>
            </div>
            @if (!_isNew && Computer.Status.Available)
            {
                <div class="row">
                    <button class="btn ghost" @onclick="SignInBrowser" disabled="@_busy">🔑 Open @(_bot.Abilities.BrowserProfile == BrowserProfile.Own ? "its" : "the shared") browser to sign in</button>
                    @if (_bot.Abilities.BrowserProfile == BrowserProfile.Own)
                    {
                        <button class="btn ghost" @onclick="ResetBrowser" disabled="@_busy" title="Deletes this bot's cookies and sign-ins">Reset its browser</button>
                    }
                </div>
                <span class="muted small">A window opens on this computer. Sign in to the sites this bot should use, then close it — sign-ins are kept.</span>
            }
            else if (!Computer.Status.Available)
            {
                <span class="muted small">@Computer.Status.UnavailableReason</span>
            }
        </section>
    }

    @if (_bot.Abilities.ComputerUse)
    {
        <section class="card">
            <h3>Computer use</h3>
            <div class="seg">
                <button class="@(_bot.Abilities.Desktop == DesktopTarget.Sandbox ? "on" : "")" @onclick="() => _bot.Abilities.Desktop = DesktopTarget.Sandbox">
                    <b>Its own sandbox</b><span class="muted small">A private Linux desktop in Docker. Can't see your screen or files, so it works without asking.</span>
                </button>
                <button class="@(_bot.Abilities.Desktop == DesktopTarget.ThisComputer ? "on" : "")" @onclick="() => _bot.Abilities.Desktop = DesktopTarget.ThisComputer">
                    <b>This computer</b><span class="muted small">Your real screen, mouse and keyboard. Asks before each action.</span>
                </button>
            </div>
            @if (_bot.Abilities.Desktop == DesktopTarget.Sandbox)
            {
                @if (_isNew) { <span class="muted small">Save the bot first; its desktop starts the first time it's used.</span> }
                else { <SandboxView BotId="@_bot.Id" /> }
            }
        </section>
    }

    }
    @if (_tab == "memory")
    {
    <section class="card">
        <h3>Memory</h3>
        <label class="check"><input type="checkbox" @bind="_bot.Memory.Enabled" /> <span><b>Remember things</b> — keeps its own memory across all its chats</span></label>
        @if (_bot.Memory.Enabled)
        {
            <label class="check"><input type="checkbox" @bind="_bot.Memory.AutoLearn" /> <span><b>Learn automatically</b> — after each reply, quietly saves anything worth remembering</span></label>
            <label class="check"><input type="checkbox" @bind="_bot.Memory.UseSharedMemory" /> <span><b>Know what other bots know about you</b> — reads the shared memory</span></label>
            <label class="check"><input type="checkbox" @bind="_bot.Memory.ShareWhatItLearns" /> <span><b>Share what it learns about you</b> — adds facts about you to the shared memory</span></label>
            <label>Memories in each prompt <input type="number" min="5" max="200" @bind="_bot.Memory.MaxInPrompt" style="width:5.5rem" /> <span class="muted small">older ones are found with recall</span></label>

            @if (!_isNew)
            {
                <div class="tool-label">@_memories.Count memories</div>
                <div class="row">
                    <input class="grow" @bind="_newMemory" @onkeydown="AddMemoryKey" placeholder="Teach it something, e.g. Our launch date is March 3" />
                    <button class="btn ghost" @onclick="AddMemory" disabled="@string.IsNullOrWhiteSpace(_newMemory)">Add</button>
                </div>
                <input class="search" @bind="_memoryFilter" @bind:event="oninput" placeholder="Search memories" />
                @foreach (var m in _memories.Where(m => _memoryFilter.Length == 0 || m.Text.Contains(_memoryFilter, StringComparison.OrdinalIgnoreCase)).OrderByDescending(m => m.CreatedAt))
                {
                    var mem = m;
                    <div class="memory-row">
                        @if (_editingMemory == mem.Id)
                        {
                            <input class="grow" @bind="_editMemoryText" @onkeydown="e => EditMemoryKey(e, mem.Id)" />
                            <button class="btn primary small" @onclick="() => SaveMemory(mem.Id)">Save</button>
                        }
                        else
                        {
                            <span class="grow">@mem.Text</span>
                            <span class="muted small">@mem.CreatedAt.ToString("MMM d")</span>
                            <button class="icon-btn" title="Edit" @onclick="() => { _editingMemory = mem.Id; _editMemoryText = mem.Text; }">✎</button>
                            <button class="icon-btn" title="Forget" @onclick="() => DeleteMemory(mem.Id)">🗑</button>
                        }
                    </div>
                }
                @if (_memories.Count > 0)
                {
                    <button class="btn danger small" @onclick="ClearMemory">Forget everything @_bot.Name knows</button>
                }
            }
        }
    </section>

    }
    @if (_tab == "checks")
    {
    <section class="card">
        <div class="row">
            <h3 class="grow">Checks</h3>
            @if (_bot.Checks.Count > 0) { <button class="btn primary" @onclick="RunAllChecks" disabled="@(_runningCheck is not null)"><Icon Name="refresh-cw" Size="15" /> Run all</button> }
        </div>
        <p class="muted small">Example questions with what a good answer does. Run them after changing the instructions, abilities or model to see that
            @(string.IsNullOrWhiteSpace(_bot.Name) ? "this bot" : _bot.Name) still works. Checks use the settings on this page, even before you save,
            run in a throwaway chat, skip anything that needs approval, and never change its memory or skills.</p>
        @foreach (var c in _bot.Checks)
        {
            var check = c;
            <div class="check-card @(check.Last is null ? "" : check.Last.Pass ? "pass" : "fail")">
                <div class="row">
                    <span class="check-status">@if (_runningCheck == check.Id) { <text>Running…</text> } else if (check.Last is { } r) { <Icon Name="@(r.Pass ? "check" : "circle-x")" Size="16" /> @(r.Pass ? "Pass" : "Fail") } else { <text>Not run</text> }</span>
                    <span class="spacer"></span>
                    <button class="btn ghost small" @onclick="() => RunCheck(check)" disabled="@(_runningCheck is not null || string.IsNullOrWhiteSpace(check.Question))">Run</button>
                    <button class="icon-btn" title="Remove" aria-label="Remove check" @onclick="() => _bot.Checks.Remove(check)"><Icon Name="trash-2" Size="15" /></button>
                </div>
                <label>Question <textarea rows="2" @bind="check.Question" placeholder="What's the monthly payment on $20,000 over 5 years at 6%?"></textarea></label>
                <label>A good answer… <input @bind="check.Expect" placeholder="uses the calculator and gives about $386.66 per month" /></label>
                <label>Must include (optional, comma-separated) <input @bind="check.MustInclude" placeholder="386.66" /></label>
                @if (check.Last is { } last)
                {
                    <div class="small"><b>@(last.Pass ? "Why it passed" : "Why it failed"):</b> @last.Reason
                        <span class="muted"> · @last.Model · @(last.Milliseconds / 1000.0)s · @last.At.ToString("MMM d, h:mm tt")</span></div>
                    @if (last.Answer.Length > 0) { <details class="advanced"><summary>The answer</summary><div class="md"><Markdown Text="@last.Answer" /></div></details> }
                }
            </div>
        }
        <button class="btn ghost" @onclick="() => _bot.Checks.Add(new BotCheck())"><Icon Name="plus" Size="16" /> Add a check</button>
        @if (_checkSummary is not null) { <div class="@(_checkSummary.StartsWith("All") ? "ok-text" : "tiny-error")">@_checkSummary</div> }
    </section>
    }

    @if (_tab == "routines")
    {
    <section class="card">
        <h3>Routines and triggers</h3>
        <p class="muted">
            Prompts this bot runs on its own: on a schedule, or when something happens. Results show up in its chat,
            marked unread. Start a prompt with <code>/skill-name</code> to reuse a skill. Tools that need approval are skipped.
        </p>
        @foreach (var r in _bot.Routines)
        {
            var routine = r;
            <div class="provider">
                <div class="row">
                    <label class="check"><input type="checkbox" @bind="routine.Enabled" /> On</label>
                    <input class="grow" @bind="routine.Name" placeholder="Name, e.g. Morning briefing" />
                    <button class="icon-btn" title="Remove" @onclick="() => _bot.Routines.Remove(routine)">🗑</button>
                </div>
                <div class="row">
                    <label class="grow">When
                        <select @bind="routine.Trigger">
                            <option value="@TriggerKind.Schedule">⏰ On a schedule</option>
                            <option value="@TriggerKind.Webhook" disabled="@(!Platform.SupportsWebhooks)">🪝 A webhook is called@(Platform.SupportsWebhooks ? "" : " (not on this device)")</option>
                            <option value="@TriggerKind.Folder" disabled="@(!Platform.CanRunProcesses)">📁 A file appears or changes in a folder@(Platform.CanRunProcesses ? "" : " (desktop only)")</option>
                            <option value="@TriggerKind.Feed">📰 A new item appears in an RSS/Atom feed</option>
                            <option value="@TriggerKind.PageChange">🌐 A web page changes</option>
                            <option value="@TriggerKind.Sheet" disabled="@(!_googleConnected)">📊 A Google Sheet changes@(_googleConnected ? "" : " (connect Google first)")</option>
                            <option value="@TriggerKind.Email" disabled="@(!_googleConnected)">📧 New email arrives@(_googleConnected ? "" : " (connect Google first)")</option>
                            <option value="@TriggerKind.Calendar" disabled="@(!_googleConnected)">📅 A calendar event is coming up@(_googleConnected ? "" : " (connect Google first)")</option>
                        </select>
                    </label>
                </div>
                @switch (routine.Trigger)
                {
                    case TriggerKind.Schedule:
                        <div class="row">
                            <select @bind="routine.Schedule">
                                <option value="@RoutineSchedule.Daily">Every day at</option>
                                <option value="@RoutineSchedule.Weekdays">Weekdays at</option>
                                <option value="@RoutineSchedule.Weekly">Every week on</option>
                                <option value="@RoutineSchedule.EveryMinutes">Every … minutes</option>
                            </select>
                            @if (routine.Schedule == RoutineSchedule.Weekly)
                            {
                                <select @bind="routine.Day" aria-label="Day of the week">
                                    @foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@day">@day</option> }
                                </select>
                                <span class="muted">at</span>
                            }
                            @if (routine.Schedule == RoutineSchedule.EveryMinutes)
                            {
                                <input type="number" min="5" @bind="routine.IntervalMinutes" style="width:6rem" />
                            }
                            else
                            {
                                <input type="time" value="@routine.TimeOfDay" @onchange="e => routine.TimeOfDay = e.Value?.ToString() ?? routine.TimeOfDay" />
                            }
                        </div>
                        break;
                    case TriggerKind.Webhook:
                        @if (_isNew)
                        {
                            <p class="muted small">Save the bot to get its webhook URL.</p>
                        }
                        else
                        {
                            var url = WebhookUrl(routine);
                            <div class="hook">
                                <div class="row"><code class="grow ellipsis" title="@url">@url</code>
                                    <button class="btn ghost small" @onclick="() => Copy(url)">Copy</button>
                                    <button class="btn ghost small" title="Invalidates the old URL" @onclick="() => routine.WebhookSecret = Routine.NewSecret()">New secret</button>
                                </div>
                                <span class="muted small">POST anything (JSON, text, form) — the body is passed to the bot. Works with GitHub, Home Assistant, IFTTT/Zapier, cron and scripts:</span>
                                <code class="snippet">curl -X POST "@url" -H "Content-Type: application/json" -d '{"event":"test"}'</code>
                                @if (Platform.WebhookBaseUrl?.Contains("localhost") == true)
                                {
                                    <span class="muted small">The desktop app only accepts webhooks from this computer. Use the web host to receive them from other machines.</span>
                                }
                            </div>
                        }
                        break;
                    case TriggerKind.Folder:
                        <div class="row">
                            <input class="grow" @bind="routine.FolderPath" placeholder="Folder, e.g. /Users/me/Downloads/Invoices" />
                            <input @bind="routine.FilePattern" placeholder="Pattern, e.g. *.pdf" style="width:9rem" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(routine.FolderPath) && !Directory.Exists(routine.FolderPath))
                        {
                            <span class="tiny-error">That folder doesn't exist.</span>
                        }
                        <span class="muted small">New and changed files (PDF, text, code…) are read and passed to the bot.</span>
                        break;
                    case TriggerKind.Sheet:
                        <div class="row">
                            <input class="grow" @bind="routine.Url" placeholder="Spreadsheet URL, ID or name" />
                            <input @bind="routine.SheetRange" placeholder="Range, e.g. Leads!A:F (default: first tab)" style="width:16rem" />
                            <label>every <input type="number" min="1" @bind="routine.PollMinutes" style="width:5rem" /> min</label>
                        </div>
                        <span class="muted small">New and edited rows (with the header row) are passed to the bot.</span>
                        @if (_states.TryGetValue(routine.Id, out var sst))
                        {
                            <span class="muted small">
                                @(sst.LastPolled is { } slp ? $"Last checked {slp:MMM d, h:mm tt}" : "Not checked yet")
                                @if (sst.LastError is not null) { <span class="tiny-error"> · @sst.LastError</span> }
                            </span>
                        }
                        break;
                    case TriggerKind.Email:
                        <div class="row">
                            <input class="grow" @bind="routine.Url" placeholder="Gmail search, e.g. in:inbox is:unread from:boss (default: in:inbox is:unread)" />
                            <label>every <input type="number" min="1" @bind="routine.PollMinutes" style="width:5rem" /> min</label>
                        </div>
                        <span class="muted small">New matching emails (sender, subject and text) are passed to the bot. The first check only notes what's already there.</span>
                        break;
                    case TriggerKind.Calendar:
                        <div class="row">
                            <label><input type="number" min="1" @bind="routine.LeadMinutes" style="width:5rem" /> minutes before each event</label>
                            <label>check every <input type="number" min="1" @bind="routine.PollMinutes" style="width:5rem" /> min</label>
                        </div>
                        <span class="muted small">The event's title, time, attendees and notes are passed to the bot — great for meeting prep.</span>
                        break;
                    case TriggerKind.Feed:
                    case TriggerKind.PageChange:
                        <div class="row">
                            <input class="grow" @bind="routine.Url" placeholder="@(routine.Trigger == TriggerKind.Feed ? "https://github.com/ollama/ollama/releases.atom" : "https://example.com/pricing")" />
                            <label>every <input type="number" min="1" @bind="routine.PollMinutes" style="width:5rem" /> min</label>
                        </div>
                        @if (_states.TryGetValue(routine.Id, out var st))
                        {
                            <span class="muted small">
                                @(st.LastPolled is { } lp ? $"Last checked {lp:MMM d, h:mm tt}" : "Not checked yet")
                                @if (st.LastError is not null) { <span class="tiny-error"> · @st.LastError</span> }
                            </span>
                        }
                        break;
                }
                <textarea rows="3" @bind="routine.Prompt" placeholder="@PromptHint(routine)"></textarea>
                <div class="row">
                    <span class="muted small grow">@(routine.LastRun is { } lr ? $"Last run {lr:MMM d, h:mm tt}" : "Never run")</span>
                    <button class="btn ghost small" disabled="@(_isNew || _runningRoutine is not null)" @onclick="() => RunNow(routine)">
                        @(_runningRoutine == routine.Id ? "Running…" : routine.Trigger is TriggerKind.Feed or TriggerKind.PageChange or TriggerKind.Sheet or TriggerKind.Email or TriggerKind.Calendar ? "▶ Check now" : "▶ Test run")
                    </button>
                </div>
                @if (_runResult.TryGetValue(routine.Id, out var rr)) { <span class="muted small">@rr</span> }
            </div>
        }
        <button class="btn ghost" @onclick="() => _bot.Routines.Add(new Routine())"><Icon Name="plus" Size="16" /> Add routine</button>
    </section>

    }
</div>
}

@code {
    private string _tab = "profile";
    private string? _runningCheck;
    private string? _checkSummary;

    private async Task RunCheck(BotCheck check)
    {
        _runningCheck = check.Id;
        _checkSummary = null;
        StateHasChanged();
        try { check.Last = await CheckRunner.RunAsync(_bot!, check); }
        catch (Exception ex) { check.Last = new BotCheckResult(false, ex.Message, "", DateTimeOffset.Now, "", 0); }
        finally { _runningCheck = null; }
        if (!_isNew) await Store.SaveAsync(_bot!); // keep results with the bot
    }

    private async Task RunAllChecks()
    {
        foreach (var c in _bot!.Checks.Where(c => !string.IsNullOrWhiteSpace(c.Question)).ToList())
        {
            await RunCheck(c);
            StateHasChanged();
        }
        var failed = _bot.Checks.Count(c => c.Last is { Pass: false });
        _checkSummary = failed == 0 ? $"All {_bot.Checks.Count} checks pass." : $"{failed} of {_bot.Checks.Count} checks failed.";
    }

    private IEnumerable<(string id, string label, string icon, string? badge)> Tabs()
    {
        yield return ("profile", "Profile", "user", null);
        var on = _bot is null ? 0 : AbilityList().Count(a => a.Get());
        yield return ("abilities", "Abilities", "wrench", on.ToString());
        yield return ("memory", "Memory", "brain", null);
        var routines = _bot?.Routines.Count ?? 0;
        yield return ("routines", "Routines", "clock", routines > 0 ? routines.ToString() : null);
        var checks = _bot?.Checks ?? [];
        var failing = checks.Count(c => c.Last is { Pass: false });
        yield return ("checks", "Checks", "list-checks", checks.Count == 0 ? null : failing > 0 ? $"{failing} failing" : checks.Count.ToString());
    }

    [Parameter] public string Id { get; set; } = "";

    private Bot? _bot;
    private bool _isNew;
    private bool _saved;
    private bool _confirmDelete;
