@page "/files"
@inherits StatefulComponent
@inject IBotComputer Computer
@inject ConversationStore Conversations
@inject IJSRuntime JS

<header class="topbar">
    <button class="icon-btn only-mobile" title="Menu" aria-label="Menu" @onclick="OpenSidebar"><Icon Name="panel-left" /></button>
    <h2 class="topbar-title">Files</h2>
    <span class="spacer"></span>
    <button class="icon-btn" title="Refresh" aria-label="Refresh" @onclick="LoadAsync"><Icon Name="refresh-cw" Size="16" /></button>
</header>

<div class="settings files-page">
    <div class="row">
        <label class="search-box grow"><Icon Name="search" Size="16" /><input placeholder="Search files" @bind="_filter" @bind:event="oninput" /></label>
        <div class="seg-mini" role="group" aria-label="Kind">
            @foreach (var k in new[] { "All", "Images", "Documents", "Data", "Code" })
            {
                var kind = k;
                <button class="@(_kind == kind ? "on" : "")" @onclick="() => _kind = kind">@kind</button>
            }
        </div>
    </div>

    <div class="files-layout">
        <div class="file-list">
            @foreach (var f in Visible())
            {
                var file = f;
                <button class="file-item @(_selected == file ? "on" : "")" @onclick="() => Select(file)">
                    <span class="file-thumb">
                        @if (file.Image is not null) { <img src="@file.Image.DataUrl" alt="" /> }
                        else { <Icon Name="@KindIcon(file)" Size="20" /> }
                    </span>
                    <span class="file-meta"><b>@file.Name</b>
                        <span class="muted small">@file.Where · @file.When.ToString("MMM d, h:mm tt")@(file.Size > 0 ? " · " + Size(file.Size) : "")</span></span>
                </button>
            }
            @if (!Visible().Any())
            {
                <p class="muted small pad">@(_all.Count == 0 ? "Nothing yet. Files your bots write, downloads from their browser, and images they generate show up here." : "No files match.")</p>
            }
        </div>

        @if (_selected is { } sel)
        {
            <aside class="file-preview card">
                <div class="row">
                    <b class="grow ellipsis">@sel.Name</b>
                    @if (sel.ConversationId is not null) { <a class="btn ghost small" href="c/@sel.ConversationId">Open chat</a> }
                    <button class="btn ghost small" @onclick="Download"><Icon Name="download" Size="15" /> Download</button>
                    @if (sel.Path is not null) { <button class="btn danger small" @onclick="Delete"><Icon Name="trash-2" Size="15" /> Delete</button> }
                </div>
                <span class="muted small">@sel.Where@(sel.Path is not null ? " · " + Relative(sel.Path) : "")</span>
                @if (sel.Image is not null)
                {
                    <img class="preview-image" src="@sel.Image.DataUrl" alt="@sel.Name" />
                }
                else if (_previewHtml is not null)
                {
                    <iframe class="preview-frame" sandbox="allow-scripts" srcdoc="@_previewHtml" title="Preview of @sel.Name"></iframe>
                }
                else if (_previewMarkdown is not null)
                {
                    <div class="md preview-text"><Markdown Text="@_previewMarkdown" /></div>
                }
                else if (_previewText is not null)
                {
                    <pre class="preview-text">@_previewText</pre>
                }
                else
                {
                    <p class="muted small">No preview for this kind of file. Download it to open it.</p>
                }
            </aside>
        }
    </div>
</div>

@code {
    private sealed record FileEntry(string Name, string Where, DateTime When, long Size, string? Path, ImageAttachment? Image, string? ConversationId)
    {
        public string Ext => System.IO.Path.GetExtension(Name).ToLowerInvariant();
    }

    private List<FileEntry> _all = [];
    private FileEntry? _selected;
    private string _filter = "", _kind = "All";
    private string? _previewText, _previewMarkdown, _previewHtml;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var list = new List<FileEntry>();
        var root = Computer.WorkspaceDirectory;
        if (Directory.Exists(root))
            foreach (var path in Directory.EnumerateFiles(root, "*", SearchOption.AllDirectories).Take(1000))
            {
                var info = new FileInfo(path);
                if (info.Name.StartsWith('.')) continue;
                var where = Relative(path).StartsWith("downloads") ? "Browser download" : "Workspace";
                list.Add(new FileEntry(info.Name, where, info.LastWriteTime, info.Length, path, IsImage(info.Extension) && info.Length < 8_000_000
                    ? new ImageAttachment(info.Name, Mime(info.Extension), Convert.ToBase64String(await File.ReadAllBytesAsync(path))) : null, null));
            }
        // Images generated in chats (newest chats first).
        foreach (var summary in (await Conversations.ListAsync()).OrderByDescending(c => c.UpdatedAt).Take(150))
        {
            var conv = await Conversations.GetAsync(summary.Id);
            foreach (var m in conv?.Messages ?? [])
                foreach (var img in m.GeneratedImages)
                    list.Add(new FileEntry(img.FileName.Contains('.') ? img.FileName : img.FileName + ".png", $"Generated in \"{summary.Title}\"",
                        m.CreatedAt.LocalDateTime, img.Base64.Length * 3L / 4, null, img, summary.Id));
        }
        _all = list.OrderByDescending(f => f.When).ToList();
        if (_selected is not null && _all.All(f => f.Name != _selected.Name || f.Path != _selected.Path)) _selected = null;
    }

    private IEnumerable<FileEntry> Visible() => _all
        .Where(f => _filter.Length == 0 || f.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase) || f.Where.Contains(_filter, StringComparison.OrdinalIgnoreCase))
        .Where(f => _kind switch
        {
            "Images" => f.Image is not null || IsImage(f.Ext),
            "Documents" => f.Ext is ".md" or ".txt" or ".pdf" or ".docx" or ".html" or ".htm" or ".rtf",
            "Data" => f.Ext is ".csv" or ".json" or ".xlsx" or ".tsv" or ".xml" or ".yaml" or ".yml",
            "Code" => f.Ext is ".py" or ".js" or ".ts" or ".cs" or ".sh" or ".sql" or ".css" or ".go" or ".rs",
            _ => true,
        });

    private async Task Select(FileEntry f)
    {
        _selected = f;
        _previewText = _previewMarkdown = _previewHtml = null;
        if (f.Path is null || f.Image is not null || new FileInfo(f.Path).Length > 400_000) return;
        if (f.Ext is ".pdf" or ".docx" or ".xlsx" or ".zip") return;
        var text = await File.ReadAllTextAsync(f.Path);
        if (f.Ext is ".html" or ".htm" or ".svg") _previewHtml = text;
        else if (f.Ext is ".md") _previewMarkdown = text;
        else if (f.Ext is ".csv") _previewMarkdown = CsvToMarkdown(text);
        else _previewText = text;
    }

    private async Task Download()
    {
        if (_selected is not { } f) return;
        var (mime, b64) = f.Image is { } img ? (img.MimeType, img.Base64)
            : f.Path is not null ? (Mime(f.Ext), Convert.ToBase64String(await File.ReadAllBytesAsync(f.Path))) : ("application/octet-stream", "");
        await JS.InvokeVoidAsync("locus.downloadImage", $"data:{mime};base64,{b64}", f.Name);
    }

    private async Task Delete()
    {
        if (_selected?.Path is not { } path || !path.StartsWith(Computer.WorkspaceDirectory)) return;
        File.Delete(path);
        _selected = null;
        await LoadAsync();
    }

    private string Relative(string path) => System.IO.Path.GetRelativePath(Computer.WorkspaceDirectory, path);

    private static string CsvToMarkdown(string csv)
    {
        var lines = csv.ReplaceLineEndings("\n").Split('\n', StringSplitOptions.RemoveEmptyEntries).Take(300).Select(l => l.Split(',')).ToList();
        if (lines.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("| " + string.Join(" | ", lines[0]) + " |").AppendLine("|" + string.Concat(lines[0].Select(_ => " --- |")));
        foreach (var l in lines.Skip(1)) sb.AppendLine("| " + string.Join(" | ", l.Select(c => c.Replace("|", "\\|"))) + " |");
        return sb.ToString();
    }

    private static bool IsImage(string ext) => ext.ToLowerInvariant() is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp";
    private static string Mime(string ext) => ext.ToLowerInvariant() switch
    {
        ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".gif" => "image/gif", ".webp" => "image/webp",
        ".pdf" => "application/pdf", ".html" or ".htm" => "text/html", ".csv" => "text/csv", ".json" => "application/json",
        ".md" or ".txt" => "text/plain", _ => "application/octet-stream",
    };
    private static string KindIcon(FileEntry f) => f.Ext switch
    {
        ".csv" or ".xlsx" or ".tsv" => "sheet",
        ".py" or ".js" or ".ts" or ".cs" or ".sh" or ".sql" or ".json" => "code",
        _ => "file-text",
    };
    private static string Size(long b) => b >= 1_000_000 ? $"{b / 1_000_000.0:0.#} MB" : b >= 1000 ? $"{b / 1000.0:0} KB" : $"{b} B";

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }
}
