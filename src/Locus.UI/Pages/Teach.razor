@page "/teach"
@inherits StatefulComponent
@inject MemoryStore Memories
@inject SkillStore Skills
@inject Locus.Core.Services.PeopleStore People

<header class="topbar">
    <button class="icon-btn only-mobile" title="Menu" aria-label="Menu" @onclick="OpenSidebar"><Icon Name="panel-left" /></button>
    <h2 class="topbar-title">Teach Locus</h2>
</header>

<div class="settings teach">
    <section class="card">
        <p>Your bots get better the more you teach them, and teaching is mostly just talking. Whatever they pick up shows under the
            reply as <span class="learned-item inline">🧠 Learned</span>, with <b>Undo</b> next to anything they got wrong.</p>
        @if (_counts is { } c)
        {
            <p class="muted small">So far: <a href="memory">@c.memories things remembered</a> · <a href="memory">@c.people people and companies</a> · <a href="skills">@c.skills skills</a></p>
        }
    </section>

    <section class="card">
        <h3><span aria-hidden="true">💬</span> 1. Just tell it</h3>
        <p class="muted">Facts, preferences and rules, in your own words. They're remembered in every chat from then on.</p>
        <div class="teach-examples">
            @foreach (var e in TellExamples)
            {
                <a class="suggestion" href="@Draft(e)">@e</a>
            }
        </div>
        <p class="muted small">Locus also notices things on its own as you chat: people you mention, what's going on in your life, how you like to be talked to.
            Change or delete any of it on the <a href="memory">Memory</a> page.</p>
    </section>

    <section class="card">
        <h3><span aria-hidden="true">📒</span> 2. Save how it did something</h3>
        <p class="muted">When a bot handles something well, tap <Icon Name="zap" Size="14" /> <b>Save as skill</b> under its reply. It writes
            down the method, step by step, and does it the same way next time. Run a skill any time by typing <code>/</code> and its name.</p>
        <p class="muted small">Bots also save methods on their own after jobs that took several steps@(State.Settings.SkillLearning.Enabled ? "" : " (turned off right now)").
            Fix or write skills yourself on the <a href="skills">Skills</a> page.</p>
        <div class="teach-examples">
            @foreach (var e in SkillExamples)
            {
                <a class="suggestion" href="@Draft(e)">@e</a>
            }
        </div>
    </section>

    <section class="card">
        <h3><span aria-hidden="true">🖱</span> 3. Show it</h3>
        <p class="muted">For a job on a website, do it once while Locus watches: <a href="skills">Skills</a> → <b>Teach by showing</b> → Record.
            Do the task in the browser window on this computer, click Stop, and your clicks become a skill.</p>
    </section>

    <section class="card">
        <h3><span aria-hidden="true">⏰</span> 4. Make it a habit</h3>
        <p class="muted">Ask for anything on a schedule, or when something happens, and it becomes a routine.</p>
        <div class="teach-examples">
            @foreach (var e in RoutineExamples)
            {
                <a class="suggestion" href="@Draft(e)">@e</a>
            }
        </div>
        <p class="muted small">Routines live on each bot's page under <a href="bots">Bots</a>.</p>
    </section>

    <section class="card">
        <h3><span aria-hidden="true">🛠</span> When it gets something wrong</h3>
        <ul class="teach-tips">
            <li>Tell it straight away: <i>"No, the report goes to Sarah, not Sam. Remember that."</i></li>
            <li>Press <b>Undo</b> on anything under a reply that it shouldn't have learned.</li>
            <li>If a skill went wrong, say <i>"fix the /weekly-report skill: …"</i> or edit it on the Skills page. Earlier versions are kept.</li>
            <li>Give a bot standing instructions on its page under <a href="bots">Bots</a> (its personality and job).</li>
        </ul>
    </section>
</div>

@code {
    private (int memories, int people, int skills)? _counts;

    private void OpenSidebar() { State.SidebarOpen = true; State.NotifyChanged(); }

    private static readonly string[] TellExamples =
    [
        "Remember: I like short, blunt answers with no fluff.",
        "Remember: my partner's name is … and their birthday is …",
        "From now on, never send an email without showing me the draft first.",
    ];

    private static readonly string[] SkillExamples =
    [
        "Save how you do my weekly budget check as a skill: …",
        "Make a skill for writing my status updates: short bullets, wins first, then blockers.",
    ];

    private static readonly string[] RoutineExamples =
    [
        "Every weekday at 8am, check my calendar and email and give me a short rundown.",
        "Every Sunday evening, remind me what's coming up this week.",
    ];

    /// <summary>A new chat with the example already typed, ready to finish and send.</summary>
    private static string Draft(string text) => "./?draft=" + Uri.EscapeDataString(text);

    protected override async Task OnInitializedAsync()
    {
        try { _counts = ((await Memories.ListAsync()).Count, (await People.ListAsync()).Count, (await Skills.ListAsync()).Count(s => !s.Pending)); }
        catch { /* the counts are a nicety */ }
    }
}
