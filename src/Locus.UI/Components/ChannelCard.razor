@using Locus.Core.Services.Channels
@implements IDisposable
@inject ChannelHub Hub
@inject ChannelStore Store
@inject AppState State
@inject IJSRuntime JS

<section class="card">
    <div class="row">
        <span class="conn-logo">@(Channel switch { "telegram" => "✈️", "slack" => "💼", "imessage" => "💬", "signal" => "🔵", _ => "🎮" })</span>
        <span class="grow">
            <b>@ChannelHub.Title(Channel)</b><br />
            <span class="muted small">Talk to Locus and your bots from your phone, approve actions, and get routine results.</span>
        </span>
        @if (Adapter.Running) { <span class="ok-text">● @Adapter.Identity</span> }
    </div>

    @if (!_hasToken)
    {
        <details class="steps" open>
            <summary>Setup</summary>
            @if (Channel == "telegram")
            {
                <ol>
                    <li>In Telegram, open <a href="https://t.me/BotFather" target="_blank" rel="noopener">@@BotFather</a> and send <code>/newbot</code>.</li>
                    <li>Pick a name and a username ending in "bot". BotFather replies with a token like <code>123456:ABC…</code>.</li>
                    <li>Paste the token below.</li>
                </ol>
            }
            else if (Channel == "imessage")
            {
                <ol>
                    <li>Works when Locus runs on a Mac. Best: sign the Mac's <b>Messages</b> app in to a separate Apple ID for the bot, so you can text it from your phone.</li>
                    <li>System Settings → Privacy &amp; Security → <b>Full Disk Access</b>: add the app running Locus (for the background service, <code>dotnet</code>), so it can read new messages.</li>
                    <li>Click <b>Turn on</b>. The first reply asks permission to control Messages — allow it.</li>
                </ol>
            }
            else if (Channel == "signal")
            {
                <ol>
                    <li>Start the Signal bridge: <code>docker compose --profile signal up -d</code> (or run <code>bbernhard/signal-cli-rest-api</code> yourself).</li>
                    <li>Link a Signal account to it: open <code>http://localhost:8081/v1/qrcodelink?device_name=locus</code> (8080 if you started the bridge yourself) and scan the QR code in Signal → Settings → Linked devices. Use a separate number for the bot if you can — messages you send from your own number to yourself don't count.</li>
                    <li>Enter the bridge address and that account's number below.</li>
                </ol>
            }
            else if (Channel == "slack")
            {
                <ol>
                    <li>Open <a href="https://api.slack.com/apps?new_app=1" target="_blank" rel="noopener">api.slack.com/apps</a> → <b>Create New App</b> → <b>From a manifest</b>, pick your workspace, and paste:
                        <pre class="code-block small">@SlackManifest</pre>
                        <button class="btn ghost" @onclick="CopyManifest">@(_copied ? "Copied" : "Copy manifest")</button>
                    </li>
                    <li><b>Install to Workspace</b>. Then <b>OAuth &amp; Permissions</b> → copy the <b>Bot User OAuth Token</b> (xoxb-…).</li>
                    <li><b>Basic Information → App-Level Tokens</b> → <b>Generate</b> with the <code>connections:write</code> scope → copy it (xapp-…).</li>
                    <li>Paste both below. Then DM the app, or @@mention it in a channel it's been added to.</li>
                </ol>
            }
            else
            {
                <ol>
                    <li>Open the <a href="https://discord.com/developers/applications" target="_blank" rel="noopener">Discord Developer Portal</a> → <b>New Application</b>.</li>
                    <li><b>Bot</b> tab → <b>Reset Token</b> and copy it. On the same tab turn on <b>Message Content Intent</b>.</li>
                    <li><b>OAuth2 → URL Generator</b>: scope <b>bot</b>, permissions <b>Send Messages</b> + <b>Read Message History</b>; open the URL to add it to your server.</li>
                    <li>Paste the token below. Then DM the bot, or @@mention it in a channel.</li>
                </ol>
            }
        </details>
        <div class="row">
            @if (Channel == "imessage")
            {
                <button class="btn primary" @onclick="Connect" disabled="@_busy">Turn on</button>
            }
            else if (Channel == "signal")
            {
                <input class="grow" @bind="_appToken" placeholder="Bridge address, e.g. http://localhost:8081" />
                <input class="grow" @bind="_token" placeholder="Bot's Signal number, e.g. +15551234567" autocomplete="off" />
                <button class="btn primary" @onclick="Connect" disabled="@(_busy || string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_appToken))">Connect</button>
            }
            else
            {
                @if (Channel == "slack")
                {
                    <input class="grow" type="password" @bind="_appToken" placeholder="App-level token (xapp-…)" autocomplete="off" />
                }
                <input class="grow" type="password" @bind="_token" placeholder="@(Channel == "slack" ? "Bot token (xoxb-…)" : "Bot token")" autocomplete="off" />
                <button class="btn primary" @onclick="Connect" disabled="@(_busy || string.IsNullOrWhiteSpace(_token) || (Channel == "slack" && string.IsNullOrWhiteSpace(_appToken)))">Connect</button>
            }
        </div>
    }
    else
    {
        @if (Adapter.Error is not null) { <div class="error-box">@Adapter.Error</div> }
        else if (!Adapter.Running && Hub.StartError(Channel) is { } startError)
        {
            <div class="error-box">@startError Locus keeps retrying in the background, or click Reconnect.</div>
        }
        <div class="row">
            <button class="btn primary" @onclick="Pair" disabled="@(!Adapter.Running)">Get pairing code</button>
            <button class="btn ghost" @onclick="Reconnect" disabled="@_busy">Reconnect</button>
            <button class="btn danger" @onclick="Disconnect" disabled="@_busy">Disconnect</button>
        </div>
        @if (Hub.Pairing is { } p && p.expires > DateTimeOffset.Now)
        {
            <div class="pair">
                Send <code class="big-code">@p.code</code> to @(Channel switch
                {
                    "telegram" => $"{Adapter.Identity} in Telegram", "slack" => $"{Adapter.Identity} in Slack (DM it, or @mention it in a channel)",
                    "imessage" => "this Mac's iMessage address from your phone", "signal" => $"{Adapter.Identity} on Signal",
                    _ => $"{Adapter.Identity} (DM it, or @mention it in your server)",
                }) within 15 minutes.
            </div>
        }
        @foreach (var l in _links)
        {
            var link = l;
            <div class="memory-row">
                <span class="grow"><b>@link.Name</b> <span class="muted small">linked @link.LinkedAt.ToString("MMM d")</span></span>
                <select value="@(link.ActiveBotId ?? "")" @onchange="e => SetBot(link, e.Value?.ToString())" title="Who answers in this chat">
                    <option value="">💬 Locus</option>
                    @foreach (var b in State.Bots) { <option value="@b.Id">@b.Emoji @b.Name</option> }
                </select>
                <label class="check small" title="Routine results and approval requests"><input type="checkbox" checked="@link.NotifyRoutines" @onchange="e => SetNotify(link, (bool)e.Value!)" /> notify</label>
                <button class="icon-btn" title="Unlink" @onclick="() => Unlink(link)">🗑</button>
            </div>
        }
        @if (_links.Count == 0) { <p class="muted small">No chats linked yet. Get a pairing code and send it to the bot.</p> }
    }
    @if (_error is not null) { <div class="error-box">@_error</div> }
</section>

@code {
    [Parameter, EditorRequired] public string Channel { get; set; } = "telegram";

    private IChannelAdapter Adapter => Hub.Adapter(Channel);
    private bool _hasToken;
    private bool _busy;
    private string _token = "";
    private string _appToken = "";
    private bool _copied;

    private const string SlackManifest = """
display_information:
  name: Locus
features:
  bot_user:
    display_name: Locus
    always_online: true
  app_home:
    messages_tab_enabled: true
    messages_tab_read_only_enabled: false
oauth_config:
  scopes:
    bot: [app_mentions:read, chat:write, im:history, im:read, im:write, files:read, files:write, users:read]
settings:
  event_subscriptions:
    bot_events: [app_mention, message.im]
  interactivity:
    is_enabled: true
  socket_mode_enabled: true
""";

    private async Task CopyManifest()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", SlackManifest);
        _copied = true;
    }
    private string? _error;
    private List<ChannelLink> _links = [];

    protected override async Task OnInitializedAsync()
    {
        Hub.Changed += OnChanged;
        Store.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var cfg = await Store.GetAsync();
        _hasToken = Store.Token(Channel) is not null;
        _links = cfg.Links.Where(l => l.Channel == Channel).ToList();
    }

    private void OnChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    private async Task Run(Func<Task> work)
    {
        _busy = true;
        _error = null;
        try { await work(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; await LoadAsync(); }
    }

    private Task Connect() => Run(async () =>
    {
        var token = Channel switch
        {
            "slack" or "signal" => $"{_appToken.Trim()}|{_token.Trim()}",
            "imessage" => "on",
            _ => _token,
        };
        if (Channel == "slack") SlackAdapter.SplitToken(token); // validates before saving
        if (Channel == "signal") SignalAdapter.SplitToken(token);
        await Store.SetTokenAsync(Channel, token);
        _token = "";
        _appToken = "";
        await Hub.RestartAsync(Channel);
    });

    private Task Reconnect() => Run(() => Hub.RestartAsync(Channel));

    private Task Disconnect() => Run(async () =>
    {
        await Store.SetTokenAsync(Channel, null);
        await Hub.RestartAsync(Channel);
    });

    private void Pair() => Hub.NewPairingCode();

    private Task SetBot(ChannelLink link, string? botId) =>
        Store.UpdateAsync(c => { if (Match(c, link) is { } l) l.ActiveBotId = string.IsNullOrEmpty(botId) ? null : botId; });

    private Task SetNotify(ChannelLink link, bool on) =>
        Store.UpdateAsync(c => { if (Match(c, link) is { } l) { l.NotifyRoutines = on; l.NotifyApprovals = on; } });

    private Task Unlink(ChannelLink link) =>
        Store.UpdateAsync(c => c.Links.RemoveAll(x => x.Channel == link.Channel && x.ChatId == link.ChatId && x.UserId == link.UserId));

    private static ChannelLink? Match(ChannelConfig c, ChannelLink l) =>
        c.Links.FirstOrDefault(x => x.Channel == l.Channel && x.ChatId == l.ChatId && x.UserId == l.UserId);

    public void Dispose()
    {
        Hub.Changed -= OnChanged;
        Store.Changed -= OnChanged;
    }
}
