
<details class="tool @StatusClass" open="@(Call.Status == ToolCallStatus.AwaitingApproval)">
    <summary>
        <span class="tool-icon"><Icon Name="@IconFor(Call.Name)" Size="15" /></span>
        <span class="tool-name">@Label</span>
        <span class="tool-arg">@Preview</span>
        <span class="tool-status">@StatusText</span>
    </summary>
    <div class="tool-body">
        @if (Diff is { } diff)
        {
            <div class="tool-label">@diff.path</div>
            <pre class="diff">@foreach (var (kind, line) in diff.lines)
{<span class="@kind">@line
</span>}</pre>
        }
        else
        {
            <div class="tool-label">Input</div>
            <pre>@PrettyArgs</pre>
        }
        @if (Call.Result is not null)
        {
            <div class="tool-label">Result</div>
            <pre>@Call.Result</pre>
        }
        @if (Call.Image is not null)
        {
            <img class="tool-shot" src="@Call.Image.DataUrl" alt="@Call.Image.FileName" />
        }
    </div>
    @if (Call.Status == ToolCallStatus.AwaitingApproval)
    {
        <div class="approval">
            <span><Icon Name="circle-alert" Size="16" /> @(Call.ApprovalReason ?? "This tool can make changes or run code.") Allow it?</span>
            <button class="btn ghost" @onclick="() => Decide(false)">Deny</button>
            @if (Call.AlwaysAllow is not null)
            {
                <button class="btn ghost" title="Don't ask again when @Call.AlwaysAllowFor uses @Label (undo on the Permissions page)" @onclick="AllowAlways">Always allow for @Call.AlwaysAllowFor</button>
            }
            <button class="btn primary" @onclick="() => Decide(true)">Allow</button>
        </div>
    }
</details>

@code {
    [Parameter, EditorRequired] public ToolCall Call { get; set; } = default!;

    /// <summary>An icon for a tool, by what kind of thing it touches.</summary>
    public static string IconFor(string tool) => tool switch
    {
        "web_search" => "search",
        "fetch_url" => "globe",
        _ when tool.StartsWith("browser_") => "globe",
        _ when tool.StartsWith("desktop_") => "monitor",
        _ when tool.StartsWith("sheets_") => "sheet",
        _ when tool.StartsWith("gmail_") => "mail",
        _ when tool.StartsWith("calendar_") => "calendar",
        "save_memory" or "delete_memory" or "recall_memory" => "brain",
        "search_past_chats" or "read_past_chat" => "message-circle",
        "message_bot" => "users",
        "use_skill" or "save_skill" or "improve_skill" => "zap",
        "run_python" or "run_command" or "run_remote" => "terminal",
        "list_files" or "read_file" or "write_file" => "folder",
        "glob" or "read" or "edit" or "write" or "undo_edit" => "folder",
        "grep" => "search",
        "bash" => "terminal",
        "todo_write" => "check",
        "edit_project_file" or "write_project_file" or "undo_project_change" or "list_project_changes" or "read_linked_file" or "list_linked_files" => "folder",
        "run_in_project" => "terminal",
        "generate_image" => "image",
        "search_documents" => "file-text",
        "get_current_datetime" => "clock",
        "calculate" or "convert_units" => "calculator",
        _ when tool.StartsWith("task_") => "list-checks",
        _ => "wrench",
    };

    /// <summary>Human label for a tool.</summary>
    public static string LabelFor(string tool) => Known.TryGetValue(tool, out var k) ? k.label : tool.Replace('_', ' ');

    private static readonly Dictionary<string, (string icon, string label)> Known = new()
    {
        ["calculate"] = ("🧮", "Calculator"), ["get_current_datetime"] = ("🕒", "Date & time"),
        ["convert_units"] = ("📏", "Unit converter"), ["web_search"] = ("🔎", "Web search"),
        ["fetch_url"] = ("🌐", "Read page"), ["search_documents"] = ("📚", "Documents"),
        ["save_memory"] = ("🧠", "Remembered"), ["delete_memory"] = ("🧽", "Forgot"),
        ["generate_image"] = ("🎨", "Image"), ["run_python"] = ("🐍", "Python"),
        ["message_bot"] = ("💬", "Message bot"), ["use_skill"] = ("⚡", "Skill"),
        ["save_skill"] = ("📒", "Save skill"), ["improve_skill"] = ("🛠️", "Improve skill"),
        ["search_past_chats"] = ("🗂️", "Search past chats"), ["read_past_chat"] = ("📜", "Read past chat"),
        ["run_remote"] = ("🛰️", "Remote computer"),
        ["browser_open"] = ("🧭", "Browser: open"), ["browser_snapshot"] = ("👀", "Browser: look"),
        ["browser_click"] = ("🖱️", "Browser: click"), ["browser_type"] = ("⌨️", "Browser: type"),
        ["browser_scroll"] = ("↕️", "Browser: scroll"), ["browser_back"] = ("↩️", "Browser: back"),
        ["browser_screenshot"] = ("📸", "Screenshot"), ["list_files"] = ("🗂️", "Files"),
        ["read_file"] = ("📖", "Read file"), ["write_file"] = ("💾", "Write file"), ["run_command"] = ("⌨️", "Command"),
        ["browser_fill_login"] = ("🔑", "Browser: sign in"),
        ["sheets_find"] = ("📊", "Sheets: find"), ["sheets_info"] = ("📋", "Sheets: info"), ["sheets_read"] = ("📖", "Sheets: read"),
        ["sheets_write"] = ("✏️", "Sheets: write"), ["sheets_append"] = ("➕", "Sheets: add rows"),
        ["sheets_create"] = ("🆕", "Sheets: create"), ["sheets_add_tab"] = ("🗂️", "Sheets: add tab"), ["sheets_clear"] = ("🧹", "Sheets: clear"),
        ["gmail_search"] = ("📧", "Gmail: search"), ["gmail_read"] = ("📨", "Gmail: read"), ["gmail_draft"] = ("📝", "Gmail: draft"),
        ["gmail_send"] = ("📤", "Gmail: send"), ["gmail_organize"] = ("🗂️", "Gmail: organize"),
        ["calendar_events"] = ("📅", "Calendar"), ["calendar_create"] = ("🗓️", "Calendar: add"), ["calendar_delete"] = ("🗑️", "Calendar: delete"),
        ["desktop_screenshot"] = ("🖥️", "Screen"), ["desktop_click"] = ("🖱️", "Desktop: click"),
        ["desktop_type"] = ("⌨️", "Desktop: type"), ["desktop_key"] = ("⌘", "Desktop: keys"),
        ["desktop_scroll"] = ("↕️", "Desktop: scroll"), ["desktop_drag"] = ("✋", "Desktop: drag"),
        ["desktop_open"] = ("🚀", "Desktop: open"), ["desktop_type_login"] = ("🔑", "Desktop: login"),
        ["edit_project_file"] = ("✏️", "Edit file"), ["write_project_file"] = ("💾", "Write file"),
        ["run_in_project"] = ("⌨️", "Run in project"), ["undo_project_change"] = ("↩️", "Undo change"),
        ["list_project_changes"] = ("🕘", "Recent changes"), ["read_linked_file"] = ("📄", "Read file"),
        ["list_linked_files"] = ("🗂️", "List folder"), ["follow_up"] = ("⏰", "Follow up later"),
        ["glob"] = ("🗂️", "Find files"), ["grep"] = ("🔎", "Search code"), ["read"] = ("📄", "Read"), ["edit"] = ("✏️", "Edit"),
        ["write"] = ("💾", "Write"), ["bash"] = ("⌨️", "Bash"), ["todo_write"] = ("📋", "Update tasks"), ["undo_edit"] = ("↩️", "Undo edit"),
        ["run_tools_script"] = ("🧩", "Tools script"), ["delegate_task"] = ("👥", "Helpers"), ["start_task"] = ("🎯", "Start task"), ["propose_new_bot"] = ("🧑‍💼", "Hire a bot"), ["rename_chat"] = ("🏷️", "Name chat"),
    };

    private string Icon => Known.TryGetValue(Call.Name, out var k) ? k.icon : "🔌";
    private string Label => Known.TryGetValue(Call.Name, out var k) ? k.label : Call.Name;

    private string Preview
    {
        get
        {
            try
            {
                var o = System.Text.Json.Nodes.JsonNode.Parse(Call.ArgumentsJson) as System.Text.Json.Nodes.JsonObject;
                var first = o?.FirstOrDefault().Value?.ToString() ?? "";
                first = first.Replace('\n', ' ');
                return first.Length > 70 ? first[..70] + "…" : first;
            }
            catch { return ""; }
        }
    }

    private string PrettyArgs
    {
        get
        {
            try
            {
                var node = System.Text.Json.Nodes.JsonNode.Parse(Call.ArgumentsJson);
                if (node is System.Text.Json.Nodes.JsonObject o && o.Count == 1 && o["code"] is { } code) return code.ToString();
                return node?.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }) ?? Call.ArgumentsJson;
            }
            catch { return Call.ArgumentsJson; }
        }
    }

    /// <summary>File changes are shown as a diff (removed lines, added lines) so you can review them before allowing.</summary>
    private (string path, List<(string kind, string line)> lines)? Diff
    {
        get
        {
            if (Call.Name is not ("edit_project_file" or "write_project_file" or "edit" or "write")) return null;
            try
            {
                if (System.Text.Json.Nodes.JsonNode.Parse(Call.ArgumentsJson) is not System.Text.Json.Nodes.JsonObject o) return null;
                var path = o["path"]?.ToString() ?? "";
                var lines = new List<(string, string)>();
                if (Call.Name is "edit_project_file" or "edit")
                {
                    foreach (var l in (o["old_text"]?.ToString() ?? "").Replace("\r\n", "\n").Split('\n')) lines.Add(("del", "- " + l));
                    foreach (var l in (o["new_text"]?.ToString() ?? "").Replace("\r\n", "\n").Split('\n')) lines.Add(("add", "+ " + l));
                }
                else
                {
                    var all = (o["content"]?.ToString() ?? "").Replace("\r\n", "\n").Split('\n');
                    foreach (var l in all.Take(400)) lines.Add(("add", "+ " + l));
                    if (all.Length > 400) lines.Add(("", $"… {all.Length - 400} more lines"));
                }
                return (path, lines);
            }
            catch { return null; }
        }
    }

    private string StatusClass => Call.Status.ToString().ToLowerInvariant();

    private string StatusText => Call.Status switch
    {
        ToolCallStatus.Pending => "…",
        ToolCallStatus.AwaitingApproval => "needs approval",
        ToolCallStatus.Running => "running…",
        ToolCallStatus.Done => "✓",
        ToolCallStatus.Denied => "denied",
        _ => "failed",
    };

    private void Decide(bool allow) => Call.Approval?.TrySetResult(allow);

    private async Task AllowAlways()
    {
        if (Call.AlwaysAllow is { } remember) await remember();
        Decide(true);
    }
}
