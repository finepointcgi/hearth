<Project Sdk="Microsoft.NET.Sdk">
  <!-- The bots' browser, via Playwright. Desktop and web hosts only — kept out of the MAUI app on purpose. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hearth.Core\Hearth.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Desktop/Sandbox/Dockerfile" LogicalName="Sandbox.Dockerfile" />
    <EmbeddedResource Include="Desktop/Sandbox/start.sh" LogicalName="Sandbox.start.sh" />
  </ItemGroup>
</Project>
