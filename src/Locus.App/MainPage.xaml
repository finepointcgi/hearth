<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="#0A0A0A" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Locus.App"
             xmlns:ui="clr-namespace:Locus.UI;assembly=Locus.UI"
             x:Class="Locus.App.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:LocusRoutes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
